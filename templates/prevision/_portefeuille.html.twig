{#
    Onglet « Prévisions » d'un portefeuille. Paramètres : portefeuille, retard, months, today, back
#}
<div class="pv-ptf-head">
    <p class="pv-hint">Prochaines échéances prévues sur ce portefeuille. « Concrétiser » crée l'opération réelle.</p>
    <div class="pv-actions">
        {% include 'layout/modern/components/_btns.html.twig' with { removeContainer: true, btns: [{ label: 'Toutes les prévisions', path: path('app_prevision_index'), icon: 'lucide:calendar-clock', color: 'neutral' }] } %}
        {% include 'layout/modern/components/_btns.html.twig' with { removeContainer: true, btns: [{ label: 'Ajouter', path: path('app_prevision_new', { portefeuille: portefeuille.id }), icon: 'gridicons:add', color: 'primary' }] } %}
    </div>
</div>
{% include 'prevision/_echeances.html.twig' with { retard: retard, months: months, today: today, back: back } only %}
