{% extends 'modern.html.twig' %}

{% set isEdit = regle.id is not null %}
{% set breadcrumb_current = isEdit ? regle.libelle : 'Nouvelle règle' %}
{% set breadcrumb_trail = [{ label: 'Prévisions', path: path('app_prevision_index') }] %}

{% block title %}{{ isEdit ? 'Modifier la règle' : 'Nouvelle règle' }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">{{ isEdit ? 'Modifier la règle' : 'Nouvelle règle prévisionnelle' }}</h1>
                <p class="page-subtitle">Abonnement, LOA, paiement en plusieurs fois, facture variable… Les échéances en sont déduites.</p>
            </div>
            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [{ label: 'Retour', path: path('app_prevision_index'), icon: 'mdi:arrow-left', color: 'neutral' }]
            } %}
        </div>

        {{ form_start(form, { attr: { class: 'modern-form', 'data-pv-form': '' } }) }}
        {{ form_errors(form) }}
        <div class="form-layout">
            <div class="form-timeline">

                <div class="form-field-card">
                    <div class="form-field-heading"><span class="form-field-index">01</span><h3>Quoi, avec qui</h3></div>
                    <div class="form-row" style="--cols: 1fr 1fr">
                        <div>{{ form_label(form.libelle, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.libelle, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.libelle) }}</div>
                        <div>{{ form_label(form.tiers, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.tiers, { attr: { class: 'modern-form-control autocomplete', 'data-endpoint': '/tiers/search', placeholder: 'Rechercher un tiers…' } }) }}{{ form_widget(form.tiers_id) }}{{ form_errors(form.tiers) }}</div>
                    </div>
                    <div class="form-row" style="--cols: 1fr 1fr 1fr">
                        <div>{{ form_label(form.categorie, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.categorie, { attr: { class: 'modern-form-control autocomplete', 'data-endpoint': '/categories/search', placeholder: 'Rechercher une catégorie…' } }) }}{{ form_widget(form.categorie_id) }}{{ form_errors(form.categorie) }}</div>
                        <div>{{ form_label(form.portefeuille, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.portefeuille, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.portefeuille) }}</div>
                        <div>{{ form_label(form.projet, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.projet, { attr: { class: 'modern-form-control autocomplete', 'data-endpoint': '/projet/search', placeholder: 'Rechercher un projet…' } }) }}{{ form_widget(form.projet_id) }}{{ form_errors(form.projet) }}</div>
                    </div>
                    <p class="pv-hint" data-pv-assist>Choisissez un tiers : le reste se remplit d'après l'historique de vos opérations.</p>
                </div>

                <div class="form-field-card">
                    <div class="form-field-heading"><span class="form-field-index">02</span><h3>Quand</h3></div>
                    <div class="form-row" style="--cols: 1.4fr 1fr 1fr">
                        <div>{{ form_label(form.frequence, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.frequence, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.frequence) }}</div>
                        <div>{{ form_label(form.jour, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.jour, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.jour) }}</div>
                        <div>{{ form_label(form.jourFin, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.jourFin, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.jourFin) }}</div>
                    </div>
                    <div class="form-row" style="--cols: 1fr 1fr 1fr">
                        <div>{{ form_label(form.debut, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.debut, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.debut) }}</div>
                        <div>{{ form_label(form.fin, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.fin, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.fin) }}</div>
                        <div>{{ form_label(form.nbEcheances, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.nbEcheances, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.nbEcheances) }}</div>
                    </div>
                    <p class="pv-hint">« Fin » ou « nombre d’échéances » arrête la règle. Pour une LOA : indiquez la fin du contrat, puis ajoutez ci-dessous un montant « à partir du » lendemain de la fin.</p>
                </div>

                <div class="form-field-card">
                    <div class="form-field-heading"><span class="form-field-index">03</span><h3>Combien</h3></div>
                    <div class="form-row" style="--cols: 1fr 2fr">
                        <div>{{ form_label(form.certitude, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(form.certitude, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(form.certitude) }}</div>
                        <div class="pv-check">{{ form_widget(form.estime) }}{{ form_label(form.estime) }}</div>
                    </div>

                    <div class="pv-tranches" data-pv-tranches
                         data-prototype="{{ form_widget(form.tranches.vars.prototype)|e('html_attr') }}"
                         data-index="{{ form.tranches|length }}">
                        {% for tranche in form.tranches %}
                            <div class="pv-tranche" data-pv-tranche>
                                <div>{{ form_label(tranche.aPartirDe, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(tranche.aPartirDe, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(tranche.aPartirDe) }}</div>
                                <div>{{ form_label(tranche.montant, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(tranche.montant, { attr: { class: 'modern-form-control' } }) }}{{ form_errors(tranche.montant) }}</div>
                                <div>{{ form_label(tranche.montantMin, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(tranche.montantMin, { attr: { class: 'modern-form-control' } }) }}</div>
                                <div>{{ form_label(tranche.montantMax, null, { label_attr: { class: 'modern-form-label' } }) }}{{ form_widget(tranche.montantMax, { attr: { class: 'modern-form-control' } }) }}</div>
                                <button type="button" class="pv-remove" data-pv-remove title="Retirer ce montant">✕</button>
                            </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(form.tranches) }}
                    <button type="button" class="page-action" data-pv-add><twig:ux:icon name="gridicons:add" /><span>Ajouter un montant (changement à une date)</span></button>
                    {% do form.tranches.setRendered %}
                </div>

                <div class="form-field-card">
                    <div class="pv-check">{{ form_widget(form.actif) }}{{ form_label(form.actif) }}</div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="page-action page-action-primary"><twig:ux:icon name="lucide:check" /><span>Enregistrer</span></button>
        </div>
        {{ form_end(form) }}
    </div>

{% endblock %}
