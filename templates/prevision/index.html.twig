{% extends 'modern.html.twig' %}

{% block title %}Prévisions{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Prévisions</h1>
                <p class="page-subtitle">Ce qui va arriver : abonnements, LOA, paiements en plusieurs fois, factures variables. Pondéré par la certitude.</p>
            </div>
            <div class="pv-actions">
                <a class="btn" href="{{ path('app_prevision_suggestions') }}" title="Récurrences repérées dans vos opérations"><twig:ux:icon name="lucide:sparkles" /><span>Suggestions</span></a>
                <form method="post" action="{{ path('app_prevision_refresh') }}" class="pv-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('prevision') }}">
                    <button type="submit" class="btn" title="Ajoute les échéances des prochains mois">Actualiser</button>
                </form>
                <a class="btn btn-primary" href="{{ path('app_prevision_new') }}"><twig:ux:icon name="gridicons:add" /><span>Nouvelle règle</span></a>
            </div>
        </div>

        <details class="rc-panel pv-rules card">
            <summary class="block-head"><h2>Règles <span class="pill pill-solid" title="Règles actives">{{ regles|filter(r => r.actif)|length }} active{{ regles|filter(r => r.actif)|length > 1 ? 's' : '' }}</span>{% if regles|filter(r => not r.actif) is not empty %} <span class="pv-range">· {{ regles|filter(r => not r.actif)|length }} inactive(s)</span>{% endif %}</h2></summary>
            {% if regles is empty %}
                <p class="rc-empty">Aucune règle.</p>
            {% else %}
                <div class="rc-table-wrap">
                    <table class="ops-table">
                        <thead><tr>
                            <th>Règle</th>
                            <th>Rythme</th>
                            <th>Certitude</th>
                            <th>Montants</th>
                            <th>Période</th>
                            <th></th>
                        </tr></thead>
                        <tbody>
                        {% for r in regles %}
                            <tr class="ops-row {{ r.actif ? '' : 'is-closed' }}">
                                <td>
                                    <a class="ops-group-link" href="{{ path('app_prevision_edit', { id: r.id }) }}">{{ r.libelle }}</a>
                                    <div class="pv-range">{{ r.tiers.name }} · {{ r.portefeuille.libelle }}{% if not r.actif %} · inactive{% endif %}</div>
                                </td>
                                <td>{{ r.frequence.label }}, le {{ r.jour }}{% if r.jourFin %}–{{ r.jourFin }}{% endif %}</td>
                                <td><span class="pill pill-{{ {certain:'success',probable:'warning',estime:'muted'}[r.certitude.value] }}">{{ r.certitude.label }}</span>{% if r.estime %} <span class="pv-range">montant variable</span>{% endif %}</td>
                                <td>
                                    {% for t in r.tranches %}
                                        <div>{{ t.montant|number_format(2, ',', ' ') }} €<span class="pv-range"> dès le {{ t.aPartirDe|date('d/m/Y') }}</span></div>
                                    {% endfor %}
                                    {% if estimations[r.id] is defined and estimations[r.id] is not null %}
                                        <div class="pv-range" title="Moyenne des 6 dernières opérations de ce tiers">≈ {{ estimations[r.id]|number_format(2, ',', ' ') }} € en moyenne récente</div>
                                    {% endif %}
                                </td>
                                <td>
                                    dès le {{ r.debut|date('d/m/Y') }}
                                    {% if r.fin %}<div class="pv-range">jusqu'au {{ r.fin|date('d/m/Y') }}</div>{% endif %}
                                    {% if r.nbEcheances %}<div class="pv-range">{{ r.nbEcheances }} échéances</div>{% endif %}
                                </td>
                                <td><a class="ops-group-link" href="{{ path('app_prevision_edit', { id: r.id }) }}">Modifier</a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </details>

        {% include 'prevision/_periodes.html.twig' with { periodes: periodes, today: today } only %}
    </div>
{% endblock %}
