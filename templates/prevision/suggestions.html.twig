{% extends 'modern.html.twig' %}

{% set breadcrumb_current = 'Suggestions' %}
{% set breadcrumb_trail = [{ label: 'Prévisions', path: path('app_prevision_index') }] %}

{% block title %}Suggestions de prévisions{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Suggestions</h1>
                <p class="page-subtitle">Opérations qui reviennent régulièrement dans vos 24 derniers mois et qui n'ont pas encore de règle. Rien n'est créé tant que vous ne validez pas.</p>
            </div>
            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [{ label: 'Retour', path: path('app_prevision_index'), icon: 'mdi:arrow-left', color: 'neutral' }]
            } %}
        </div>

        <p class="pv-hint">{{ total }} opération(s) analysée(s) sur les {{ fenetre }} derniers mois{% if derniere %} · dernière opération en base : <strong>{{ derniere|date('d/m/Y') }}</strong>{% endif %}. Une récurrence dont la dernière occurrence est trop ancienne est considérée comme terminée.</p>

        <section class="rc-panel" data-pv-suggestions>
            <header class="block-head">
                <h2>Récurrences repérées <span class="pill pill-solid" data-pv-count>{{ suggestions|length }}</span></h2>
                <button type="button" class="btn-link is-muted hidden" data-pv-reset>Réafficher les suggestions masquées</button>
            </header>

            {% if suggestions is empty %}
                <p class="rc-empty">Rien de régulier détecté (ou tout est déjà couvert par une règle).</p>
            {% else %}
                <div class="rc-table-wrap">
                    <table class="ops-table">
                        <thead><tr>
                            <th>Tiers</th>
                            <th>Ce qui a été constaté</th>
                            <th>Prochaine</th>
                            <th>Montant</th>
                            <th></th>
                        </tr></thead>
                        <tbody>
                        {% for s in suggestions %}
                            {% set params = {
                                tiers: s.tiers.id,
                                categorie: s.categorie.id,
                                portefeuille: s.portefeuille.id,
                                projet: s.projet ? s.projet.id : null,
                                frequence: s.frequence.value,
                                jour: s.jour,
                                montant: s.montant,
                                min: s.min,
                                max: s.max,
                                estime: s.estime ? 1 : 0,
                                certitude: s.certitude.value,
                                debut: s.prochaine|date('Y-m-d'),
                                libelle: s.tiers.name ~ ' – ' ~ (s.categorie.libelle ?: s.categorie.name)
                            } %}
                            <tr class="ops-row" data-pv-suggestion="{{ s.tiers.id }}|{{ s.categorie.id }}|{{ s.portefeuille.id }}">
                                <td>
                                    <strong>{{ s.tiers.name }}</strong>
                                    <div class="pv-range">{{ s.categorie.libelle ?: s.categorie.name }} · {{ s.portefeuille.libelle }}</div>
                                </td>
                                <td>
                                    {{ s.resume }}
                                    <div class="pv-range">dernière le {{ s.derniere|date('d/m/Y') }} · régularité {{ (s.regularite * 100)|round }} %</div>
                                    <details class="pv-serie"><summary class="btn-link is-muted">voir les {{ s.serie|length }} opérations</summary>
                                        <ul>{% for o in s.serie %}<li>{{ o.date|date('d/m/Y') }} · {{ o.montant|number_format(2, ',', ' ') }} € <span class="pv-range">{{ o.categorie }}</span></li>{% endfor %}</ul>
                                    </details>
                                </td>
                                <td>{{ s.prochaine|date('d/m/Y') }} <span class="pill pill-{{ {certain:'success',probable:'warning',estime:'muted'}[s.certitude.value] }}">{{ s.certitude.label }}</span></td>
                                <td>
                                    {{ s.estime ? '≈ ' : '' }}{{ s.montant|number_format(2, ',', ' ') }} €
                                </td>
                                <td>
                                    <div class="pv-actions">
                                        <a class="btn btn-primary" href="{{ path('app_prevision_new', params) }}">Créer la règle</a>
                                        <button type="button" class="btn-link is-muted" data-pv-hide>Masquer</button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        <section class="rc-panel">
            <details>
                <summary class="block-head"><h2>Non retenues <span class="pill pill-solid">{{ rejets|length }}</span></h2></summary>
                <p class="pv-hint">Opérations d'un même tiers et portefeuille qui n'ont été rattachées à aucune récurrence (opérations ponctuelles, rythme irrégulier, série terminée…), et pourquoi. Les plus nombreuses d'abord.</p>
                {% if rejets is empty %}
                    <p class="rc-empty">Rien d'écarté.</p>
                {% else %}
                    <div class="rc-table-wrap">
                        <table class="ops-table">
                            <thead><tr>
                                <th>Tiers</th>
                                <th>Catégorie · portefeuille</th>
                                <th>Opérations</th>
                                <th>Dernière</th>
                                <th>Pourquoi pas</th>
                            </tr></thead>
                            <tbody>
                            {% for r in rejets %}
                                <tr class="ops-row">
                                    <td>{{ r.tiers.name }}</td>
                                    <td>{{ r.categorie.libelle ?: r.categorie.name }} · {{ r.portefeuille.libelle }}</td>
                                    <td>{{ r.occurrences }}</td>
                                    <td>{{ r.derniere|date('d/m/Y') }}</td>
                                    <td>{{ r.raison }}
                                        <details class="pv-serie"><summary class="btn-link is-muted">voir les {{ r.serie|length }} opérations</summary>
                                            <ul>{% for o in r.serie %}<li>{{ o.date|date('d/m/Y') }} · {{ o.montant|number_format(2, ',', ' ') }} € <span class="pv-range">{{ o.categorie }}</span></li>{% endfor %}</ul>
                                        </details>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </details>
        </section>
    </div>
{% endblock %}
