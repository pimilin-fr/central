<div id="projets-list" class="entity-grid" data-search-target>
    {% for projet in projets %}
        {% include 'projet/_card.html.twig' with { projet: projet } only %}
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon"><twig:ux:icon name="lucide:folder-kanban" /></div>
            <div>
                <h2>Aucun projet</h2>
                <p>Aucun projet n'est actuellement disponible.</p>
            </div>
            <a href="{{ path('app_projet_new') }}" class="page-action page-action-primary">
                <twig:ux:icon name="ic:round-add" />
                Ajouter un projet
            </a>
        </div>
    {% endfor %}
</div>

<div id="projets-search-empty" class="empty-state search-empty" hidden>
    <div class="empty-state-icon"><twig:ux:icon name="lucide:search-x" /></div>
    <div>
        <h2>Aucun résultat</h2>
        <p>Aucun projet ne correspond à votre recherche.</p>
    </div>
</div>
