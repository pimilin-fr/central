{% extends 'modern.html.twig' %}

{% set breadcrumb_current = 'Nouveau' %}

{% block title %}Nouveau projet{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Nouveau projet</h1>
                <p class="page-subtitle">Définissez le type, la période et l'apparence de votre projet.</p>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Retour',
                        path: path('app_projet_index'),
                        icon: 'mdi:arrow-left',
                        color: 'neutral'
                    }
                ]
            } %}
        </div>

        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: [{
                id: 'summary',
                label: 'Informations',
                icon: 'lucide:folder-kanban',
                content: include('projet/_form.html.twig')
            }],
            activeTab: app.request.query.get('tab') ?? 'summary'
        } %}
    </div>
{% endblock %}
