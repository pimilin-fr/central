{{ form_start(form) }}
{# =========================
CHAMPS
========================= #}
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {# Nom #}
    <div>
        {{ form_label(form.name, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.name, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.name) }}
    </div>
    {# tiersType #}
    <div>
        {{ form_label(form.type, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.type, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.type) }}
    </div>
    {# coleur #}
    <div>
        {{ form_label(form.couleur, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.couleur, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.couleur) }}
    </div>
    <div>
        {{ form_label(form.beginAt, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.beginAt, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500'
            }
        }) }}

        {{ form_errors(form.beginAt) }}
    </div>
    <div>
        {{ form_label(form.endAt, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.endAt, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500'
            }
        }) }}

        {{ form_errors(form.endAt) }}
    </div>

</div>
{# =========================
ACTIONS
========================= #}
<div class="flex justify-end gap-3 pt-4">
    <button type="submit"
            class="inline-flex items-center gap-2 px-4 py-2
            text-sm font-medium rounded-lg
            bg-orange-500 hover:bg-orange-600 text-white transition">
        {{ ux_icon('mdi:content-save-outline', { class: 'w-4 h-4' }) }}
        Enregistrer
    </button>
</div>

{{ form_end(form) }}
