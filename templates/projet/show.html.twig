{% extends 'base.html.twig' %}

{% block title %}Projet{% endblock %}

{% block body %}
    <div class="space-y-6">
        {# =========================
              HEADER : Titre + actions (modernisé)
              ========================= #}
        {% set btns = [] %}
        {% if entity.type %}
            {% set btns = btns|merge([
                {
                    label: "Type",
                    path: path('app_projet_type_show', { id:  entity.type.id }),
                    color: 'green',
                    icon: 'icon-park-solid:up-c',
                }
            ]) %}
        {% endif %}
        {% set btns = btns|merge([{
                label: "Retour",
                path: path('app_projet_index'),
                color: 'gray',
                icon: 'mdi:arrow-left',
            }]) %}


        {% include 'partials/header.html.twig' with {
            btns: btns,
            title: 'Projet : '~entity.name,
            item: entity,
            subTitle:{
                color: entity.couleur ,
                label: entity.type.fullname 
            }
        } %}

        {# =========================
        ONGLETS FONCTIONNELS
        ========================= #}
        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}

        {% set tabs = [
            {
                id: 'summary',
                label: 'Résumé',
                content: include('projet/_resume.html.twig')
            },{
                id: 'edit',
                label: 'Modifier',
                icon: 'mdi:pencil',
                content: render(controller(
                    'App\\Controller\\ProjetController::edit',
                    {
                        id: entity.id
                    }
                ))
            }
            ] %}

        {% include 'partials/tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
            } %}
    </div>
{% endblock %}
