{% extends 'modern.html.twig' %}

{% set breadcrumb_current = entity.name %}

{% block title %}Projet - {{ entity.name }}{% endblock %}

{% block body %}
    {% set now = date() %}
    {% set isDimmed = (entity.endAt and entity.endAt < now) or (entity.beginAt and entity.beginAt > now) %}

    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">{{ entity.name }}</h1>

                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ (entity.couleur ?? null)|entity_color }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ entity.type.fullname ?? entity.type ?? '—' }}</span>
                    </span>
                    {% include 'projet/card/_status.html.twig' with { entity: entity } only %}
                </div>
            </div>

            {% set btns = [{
                label: 'Retour',
                path: path('app_projet_index'),
                icon: 'mdi:arrow-left',
                color: 'neutral'
            }] %}
            {% if entity.type %}
                {% set btns = btns|merge([{
                    label: 'Type',
                    path: path('app_projet_type_show', { id: entity.type.id }),
                    icon: 'icon-park-solid:up-c',
                    color: 'primary'
                }]) %}
            {% endif %}

            {% include 'layout/modern/components/_btns.html.twig' with { btns: btns } %}
        </div>

        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}
        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: [
                {
                    id: 'summary',
                    label: 'Résumé',
                    icon: 'ooui:info-filled',
                    content: include('projet/show/_resume.html.twig')
                },
                {
                    id: 'edit',
                    label: 'Modifier',
                    icon: 'mingcute:edit-2-fill',
                    content: render(controller('App\\Controller\\ProjetController::edit', { id: entity.id }))
                }
            ],
            activeTab: activeTab
        } %}
    </div>
{% endblock %}
