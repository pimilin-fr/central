{% extends 'modern.html.twig' %}

{% block title %}Projets{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="toolbar">
                    {% include 'layout/modern/components/_search.html.twig' with {
                        target: '#projets-list',
                        placeholder: 'Rechercher un projet...',
                        aria_label: 'Rechercher un projet',
                        empty: '#projets-search-empty',
                        count: '#projets-visible-count'
                    } %}

                    <div class="toolbar-info">
                        <span class="toolbar-dot"></span>
                        <span><strong id="projets-visible-count">{{ projets|length }}</strong> projets</span>
                    </div>
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Types',
                        path: path('app_projet_type_index'),
                        icon: 'grommet-icons:cubes',
                    },
                    {
                        label: 'Ajouter',
                        path: path('app_projet_new'),
                        icon: 'gridicons:add',
                        color: 'primary'
                    }
                ]
            } %}
        </div>

        <section class="entity-list">
            {% include 'projet/list/_table.html.twig' %}
        </section>
    </div>
{% endblock %}
