<div class="resume-layout">

    {# REGROUPEMENT #}
    {% include 'depenses/list/_grouping.html.twig' with {
        groupBy: groupBy,
        route: 'app_projet_show',
        routeParams: {
            id: entity.id,
            tab: 'summary'
        }
    } %}
    


    {# CARTE RESUME : cercle (début) | identité + infos | liseré (statut) #}
    <section class="summary-card {{ isDimmed ? 'is-archived' : '' }}"
             style="--entity-color: {{ entity.couleur ?? 'var(--accent)' }}; --entity-text: {{ entity.textColor ?? '#FFFFFF' }};">

        {% include 'projet/_circle.html.twig' with { projet: entity } only %}

        <div class="summary-body">
            <div class="summary-head">
                <h2 class="summary-name" title="{{ entity.name }}">{{ entity.name }}</h2>
                {% include 'projet/_status.html.twig' with { entity: entity } only %}
            </div>

            <div class="summary-grid-2-cols">
                <div class="summary-field">
                    <p class="summary-label">Type</p>
                    <p class="summary-value is-wrap">{{ entity.type.fullname ?? entity.type ?? '—' }}</p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Période</p>
                    <p class="summary-value is-wrap">{% include 'projet/_period.html.twig' with { projet: entity } only %}</p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Démo</p>
                    <p class="summary-value">
                        {% include 'detail/v2/_demo_pill.html.twig' with { entity: entity } %}
                    </p>
                </div>

                {% if isDimmed %}
                    <div class="summary-field">
                        <p class="summary-label">Terminé le</p>
                        <p class="summary-value">{{ entity.endAt|date('d/m/Y') }}</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="summary-ribbon">
            <span class="summary-ribbon-label">{{ entity.type.name ?? '—' }}</span>
        </div>
    </section>

    {# MODIFICATION EN MASSE + RELEVES #}
    <form method="post" action="{{ path('app_depenses_bulk_update') }}" class="bulk-form" data-bulk-form>
        <div class="bulk-bar" data-bulk-bar>
            {{ include('depenses/list/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include 'depenses/list/_group.html.twig' %}
        </div>
    </form>
</div>
