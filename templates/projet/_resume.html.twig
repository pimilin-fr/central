{% set months = {
    '01':'janv.', '02':'févr.', '03':'mars', '04':'avril',
    '05':'mai', '06':'juin', '07':'juil.', '08':'août',
    '09':'sept.', '10':'oct.', '11':'nov.', '12':'déc.'
} %}

<div class="grid grid-cols-1 lg:grid-cols-4 gap-4">

    {# Résumé #}
    <div class="lg:col-span-3 bg-white p-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">

            <div>
                <p class="text-gray-500">Nom</p>
                <p class="text-gray-800 font-medium">{{ projet.name }}</p>
            </div>

            <div>
                <p class="text-gray-500">Type</p>
                <p class="text-gray-800 font-medium">
                    {{ projet.type.fullname ?? '—' }}
                </p>
            </div>

        </div>
    </div>

    {# Dates / Statut #}
    <div class="bg-gray-200 rounded-xl border shadow-sm p-5 text-sm flex flex-col">

        
        {# ===== DÉBUT ===== #}
        <p class="text-xs text-gray-500 uppercase">Début</p>
        <p class="text-gray-800 text-sm">
            {% set m1 = months[projet.beginAt|date('m')] %}
            {{ projet.beginAt|date('d') }} {{ m1 }} {{ projet.beginAt|date('Y') }}
        </p>

        {# ===== FIN ===== #}
        {% if projet.endAt %}
            <p class="mt-3 text-xs text-gray-500 uppercase">Fin</p>
            <p class="text-gray-800 text-sm">
                {% set m2 = months[projet.endAt|date('m')] %}
                {{ projet.endAt|date('d') }} {{ m2 }} {{ projet.endAt|date('Y') }}
            </p>
        {% endif %}
        <div class="mb-5"></div>

        {% include 'projet/_status.html.twig'%}

    </div>

</div>