<div class="p-6 space-y-10">

    {% for n1, n2s in grouped %}
        <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">{{ n1 }}</h2>

            {% for n2, n3s in n2s %}
                <h3 class="text-lg font-semibold text-gray-700 mb-3 ml-2">{{ n2 }}</h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6 ml-4">

                    {% for type in n3s %}
                        {% set bgColor = type.couleur ?? '#F97316' %}
                        {% set textColor = type.textColor ?? '#FFFFFF' %}

                        <a href="{{ path('app_type_tiers_show', {id: type.id}) }}"
                           class="relative block bg-white rounded-xl shadow hover:shadow-lg transition border overflow-hidden"
                           style="min-height: 100px;">

                            {# LISERAI GAUCHE #}                           
                            <div class="absolute top-0 right-0 h-full w-8
                                 bg-orange-500
                                 flex items-center justify-center
                                 rounded-r-xl" 
                                 style="background-color: {{ bgColor }}; color: {{ textColor }};">

                                <span class=" text-xs font-bold tracking-wider
                                      rotate-90 whitespace-nowrap">
                                    {{ type.libelleLiserai }}
                                </span>
                            </div>

                            {# CONTENU #}
                            <div class="p-4 pl-6">
                                <p class="text-sm text-gray-500">{{ n1 }} / {{ n2 }}</p>
                                <h4 class="text-lg font-semibold text-gray-900 truncate">
                                    {{ type.typeN3 }}
                                </h4>
                            </div>

                        </a>
                    {% endfor %}

                </div>
            {% endfor %}
        </div>
    {% endfor %}

</div>
