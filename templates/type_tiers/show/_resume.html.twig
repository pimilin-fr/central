<div class="resume-layout">

    {% include 'depenses/list/_grouping.html.twig' with {
        groupBy: groupBy,
        route: 'app_type_tiers_show',
        routeParams: { id: entity.id, tab: 'summary' }
    } %}

    {# CARTE RESUME : cercle | identité + hiérarchie | liseré (couleur + libellé) #}
    <section class="summary-card" style="--entity-color: {{ entity.couleur ?? 'var(--accent)' }}; --entity-text: {{ entity.textColor ?? '#FFFFFF' }};">

        <div class="entity-circle"><twig:ux:icon name="lucide:tag" /></div>

        <div class="summary-body">
            <div class="summary-head">
                <h2 class="summary-name" title="{{ entity.typeN3 }}">{{ entity.typeN3 }}</h2>
                {% if entity.code %}
                    <span class="entity-pill" style="--entity-color: {{ entity.couleur ?? 'var(--accent)' }};" title="{{ entity.code }}">
                        <span class="entity-pill-dot"></span>
                        <span>#{{ entity.code|slice(0, 30) }}</span>
                    </span>
                {% endif %}
            </div>

            <div class="summary-grid-2-cols">
                <div class="summary-field">
                    <p class="summary-label">Type N1</p>
                    <p class="summary-value">{{ entity.typeN1 ?: '—' }}</p>
                </div>
                <div class="summary-field">
                    <p class="summary-label">Type N2</p>
                    <p class="summary-value">{{ entity.typeN2 ?: '—' }}</p>
                </div>
                <div class="summary-field">
                    <p class="summary-label">Type N3</p>
                    <p class="summary-value">{{ entity.typeN3 ?: '—' }}</p>
                </div>
            </div>
        </div>

        <div class="summary-ribbon">
            <span class="summary-ribbon-label">{{ entity.libelleLiserai ?? entity.libelle ?? '—' }}</span>
        </div>
    </section>

    <form method="post" action="{{ path('app_depenses_bulk_update') }}" class="bulk-form" data-bulk-form>
        <div class="bulk-bar" data-bulk-bar>
            {{ include('depenses/list/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include 'depenses/list/_group.html.twig' %}
        </div>
    </form>
</div>
