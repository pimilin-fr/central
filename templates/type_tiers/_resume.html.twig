<div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">

    {# OPTIONS DE GROUPEMENT #}
    <div class="md:col-span-3 bg-gray-100 p-5 rounded-xl border shadow">
        {% include 'detail/v2/_grouping.html.twig' with {
            groupBy: groupBy,
            route: 'app_type_tiers_show',
            routeParams: {
                id: entity.id,
                tab: 'summary'
            }
        } %}
    </div>

    {# INFOS Tiers #}


    <div class="md:col-span-2 bg-gray-100 p-5 rounded-xl shadow border relative overflow-hidden">
        <div class="grid gap-4 text-sm">
            <div>
                <p class="text-gray-500">Type N1</p>
                <p class="text-gray-800 font-medium">{{ entity.typeN1 }}</p>
            </div>

            <div>
                <p class="text-gray-500">Type N2</p>
                <p class="text-gray-800 font-medium">{{ entity.typeN2 }}</p>
            </div>

            <div>
                <p class="text-gray-500">Type N3</p>
                <p class="text-gray-800 font-medium">{{ entity.typeN3 }}</p>
            </div>
        </div>


        {# =========================
           STATUT - LISERÉ VERTICAL
           ========================= #}

        <div
            class="absolute right-0 top-0 h-full w-6 flex items-center justify-center"
            style="background-color: {{ entity.couleur }}; "
            >
            <span
                class="text-white font-bold uppercase whitespace-nowrap"
                style="transform: rotate(90deg);color: {{entity.textColor}};"
                >
                {{ entity.libelleLiserai ?? '—' }}
            </span>
        </div>

    </div>

</div>



<div>
    <form method="post" action="{{ path('app_depenses_bulk_update') }}" class="mb-4"  data-bulk-form>
        <div class="flex flex-wrap items-end gap-4 bg-gray-100 p-4 rounded-lg border shadow-sm space-y-3 mb-4">
            {{ include('depenses/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include('detail/v2/_releve.html.twig')%}
        </div>
    </form>
</div>
