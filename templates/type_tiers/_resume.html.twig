<div class="grid grid-cols-1 lg:grid-cols-5 gap-4">

    {# =========================
       BLOC PRINCIPAL
       ========================= #}
    <div class="lg:col-span-4 bg-white p-6 rounded-xl border shadow-sm space-y-6">

        {# Types hiérarchiques #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
            <div>
                <p class="text-gray-500">Type N1</p>
                <p class="text-gray-800 font-medium">{{ entity.typeN1 }}</p>
            </div>

            <div>
                <p class="text-gray-500">Type N2</p>
                <p class="text-gray-800 font-medium">{{ entity.typeN2 }}</p>
            </div>

            <div>
                <p class="text-gray-500">Type N3</p>
                <p class="text-gray-800 font-medium">{{ entity.typeN3 }}</p>
            </div>
        </div>
   

    </div>

    {# =========================
       TUILE LATERALE LISERAI
       ========================= #}
    <div class="lg:col-span-1">
        <div
            class="h-full rounded-xl border shadow-sm flex items-center justify-center text-center p-4"
            style="border-right: 20px solid {{ entity.couleur }};"
            >
            <div>
                <p class="text-xs tracking-wide text-gray-500 mb-1">
                    Liserai
                </p>

                <p class="text-sm uppercase font-semibold text-gray-800">
                    {{ entity.libelleLiserai ?? '—' }}
                </p>
            </div>
        </div>
    </div>

</div>
<div>
    <form method="post" action="{{ path('app_depenses_bulk_update') }}" class="mb-4"  data-bulk-form>
        <div class="flex flex-wrap items-end gap-4 bg-gray-100 p-4 rounded-lg border shadow-sm space-y-3 mb-4">
            {{ include('depenses/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include('detail/v2/_releve.html.twig')%}
        </div>
    </form>
</div>
