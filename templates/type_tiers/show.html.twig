{% extends 'modern.html.twig' %}

{% set breadcrumb_trail = [{ label: 'Types de tiers', path: path('app_type_tiers_index') }] %}
{% set breadcrumb_current = entity.name %}

{% block title %}Type de tiers - {{ entity.name }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">{{ entity.typeN3 }}</h1>

                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ entity.couleur ?? 'var(--accent)' }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ [entity.typeN1, entity.typeN2]|filter(v => v)|join(' / ') ?: 'Type de tiers' }}</span>
                    </span>
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [{
                    label: 'Retour',
                    path: path('app_type_tiers_index'),
                    icon: 'mdi:arrow-left',
                    color: 'neutral'
                }]
            } %}
        </div>

        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}
        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: [
                {
                    id: 'summary',
                    label: 'Résumé',
                    icon: 'ooui:info-filled',
                    content: include('type_tiers/_resume.html.twig')
                },
                {
                    id: 'tiers',
                    label: 'Tiers',
                    icon: 'mage:users-fill',
                    badge: tiers|length,
                    content: include('tiers/list/_table.html.twig', { tiers: tiers })
                },
                {
                    id: 'edit',
                    label: 'Modifier',
                    icon: 'mingcute:edit-2-fill',
                    content: render(controller('App\\Controller\\TypeTiersController::edit', { id: entity.id }))
                }
            ],
            activeTab: activeTab
        } %}
    </div>
{% endblock %}
