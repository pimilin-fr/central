<div class="max-w-xl">

    {{ form_start(form, {
        attr: { class: 'space-y-6' }
    }) }}

    {# Nom #}
    <div>
        {{ form_label(form.name, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.name, {
            attr: {
                class: 'block w-full rounded-lg border-gray-300 shadow-sm
                        focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.name) }}
    </div>

    {# Couleur #}
    <div>
        {{ form_label(form.couleur, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.couleur, {
            attr: {
                class: 'block w-full rounded-lg border-gray-300 shadow-sm
                        focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.couleur) }}
    </div>

    {# Libellé liserai #}
    <div>
        {{ form_label(form.libelleLiserai, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.libelleLiserai, {
            attr: {
                class: 'block w-full rounded-lg border-gray-300 shadow-sm
                        focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.libelleLiserai) }}
    </div>

    <div class="pt-4 flex justify-end gap-2 border-t">
        <button
            type="submit"
            class="inline-flex items-center px-4 py-2 rounded-lg
            bg-blue-600 text-white text-sm font-medium
            hover:bg-blue-700 transition">
            Enregistrer
        </button>
        <button type="submit" name="recompute_code" value="1"
                class="inline-flex items-center px-4 py-2 rounded-lg
            bg-orange-600 text-white text-sm font-medium
            hover:bg-orange-700 transition">
            🔄 Recalculer le code
        </button>
    </div>

    {{ form_end(form) }}
</div>
