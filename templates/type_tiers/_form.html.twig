{% set typeId = form.vars.value.id ?? null %}
{% set isEdit = typeId is not null %}
{% set formAction = isEdit ? path('app_type_tiers_edit', { id: typeId }) : path('app_type_tiers_new') %}

{{ form_start(form, {
    action: formAction,
    attr: { class: 'modern-form', 'data-live-form': '' }
}) }}

<div class="form-layout" data-live-scope>

    <div class="form-timeline">

        <div class="form-field-card card-inset">
            <div class="form-field-heading">
                <span class="form-field-index">01</span>
                <h3>Identité</h3>
            </div>
            <div class="form-row" style="--cols: minmax(0, 1fr)">
                <div>
                    {{ form_label(form.name, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.name, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.name) }}
                </div>
            </div>
        </div>

        <div class="form-field-card card-inset">
            <div class="form-field-heading">
                <span class="form-field-index">02</span>
                <h3>Apparence</h3>
            </div>
            <div class="form-row" style="--cols: minmax(0, 2fr) minmax(0, 1fr)">
                <div>
                    {{ form_label(form.libelleLiserai, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.libelleLiserai, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.libelleLiserai) }}
                </div>
                <div>
                    {{ form_label(form.couleur, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {% include 'layout/modern/components/_color_picker.html.twig' with { field: form.couleur } only %}
                    {{ form_errors(form.couleur) }}
                </div>
            </div>
        </div>
    </div>

    <aside class="form-layout-aside">
        {% include 'layout/modern/components/_form_preview.html.twig' with {
            icon: 'lucide:tag',
            color: 'couleur',
            ribbon: 'libelleLiserai',
            title: 'name',
            placeholder: 'Nom du type'
        } only %}
    </aside>
</div>

<div class="modern-form-footer">
    <span class="modern-form-footer-copy">
        <span class="required-legend">Champ obligatoire</span>
    </span>

    <div class="page-heading-actions">
        {% if isEdit %}
            <button type="submit" name="recompute_code" value="1" class="btn btn-warning">
                <twig:ux:icon name="lucide:refresh-cw" />
                <span>Recalculer le code</span>
            </button>
        {% endif %}

        {% include 'layout/modern/components/_btns.html.twig' with {
            removeContainer: true,
            btns: [{
                label: isEdit ? 'Enregistrer' : 'Créer le type',
                type: 'submit',
                icon: isEdit ? 'mdi:content-save-outline' : 'ic:round-add',
                color: 'primary'
            }]
        } %}
    </div>
</div>

{{ form_end(form) }}
