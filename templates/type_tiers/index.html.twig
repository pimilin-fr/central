{% extends 'base.html.twig' %}

{% block title %}Type de Tiers{% endblock %}

{% block body %}
    <div class="space-y-6">
        {# =========================
            HEADER : Titre + actions (modernisé)
            ========================= #}
        {% 
            set btns = [
                {
                    label: "Ajouter",
                    path: path('app_type_tiers_new'),
                    color: 'green',
                    icon: 'ic:round-add',
                },{
                    label: "Tiers",
                    icon: "mage:user-fill",
                    color: "blue",
                    path: path('app_tiers_index')
                }
            ]
        
        %}
        {% include 'partials/header.html.twig' with {
            btns: btns,
            title: "Type de Tiers - Liste",
            item: null
        } %}
        
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            {% include 'type_tiers/_table.html.twig' %}
        </div>
       
{% endblock %}
