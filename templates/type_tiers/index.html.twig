{% extends 'modern.html.twig' %}

{% set breadcrumb_current = 'Types de tiers' %}

{% block title %}Types de tiers{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="toolbar">
                    {% include 'layout/modern/components/_search.html.twig' with {
                        target: '#type-tiers-list',
                        placeholder: 'Rechercher un type de tiers...',
                        aria_label: 'Rechercher un type de tiers',
                        empty: '#type-tiers-search-empty',
                        count: '#type-tiers-visible-count'
                    } %}

                    <div class="toolbar-info">
                        <span class="toolbar-dot"></span>
                        <span><strong id="type-tiers-visible-count">0</strong> types</span>
                    </div>
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Tiers',
                        path: path('app_tiers_index'),
                        icon: 'mage:users-fill',
                    },
                    {
                        label: 'Ajouter',
                        path: path('app_type_tiers_new'),
                        icon: 'gridicons:add',
                        color: 'primary'
                    }
                ]
            } %}
        </div>

        <section class="entity-list">
            {% include 'type_tiers/list/_table.html.twig' %}
        </section>
    </div>
{% endblock %}
