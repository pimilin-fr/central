{# Types de tiers groupés N1 > N2 > types. Paramètre : grouped #}
<div id="type-tiers-list" class="categorie-tree" data-search-target>
    {% for n1, n2s in grouped %}
        <section class="categorie-branch level-0" data-search-group>
            <header class="categorie-branch-header">
                <div class="categorie-branch-heading">
                    <span class="categorie-branch-index">{{ '%02d'|format(loop.index) }}</span>
                    <div class="categorie-branch-copy">
                        <span class="categorie-branch-kicker">Famille</span>
                        <h2 class="categorie-branch-title">{{ n1 }}</h2>
                    </div>
                </div>
                <div class="categorie-branch-meta">
                    <span class="categorie-branch-count">{{ n2s|length }} {{ n2s|length == 1 ? 'groupe' : 'groupes' }}</span>
                    <twig:ux:icon name="lucide:layers-3" />
                </div>
            </header>

            <div class="categorie-branch-children">
                {% for n2, n3s in n2s %}
                    <section class="categorie-branch level-1" data-search-group>
                        <header class="categorie-branch-header">
                            <div class="categorie-branch-heading">
                                <span class="categorie-branch-index">{{ '%02d'|format(loop.index) }}</span>
                                <div class="categorie-branch-copy">
                                    <span class="categorie-branch-kicker">Sous-niveau</span>
                                    <h3 class="categorie-branch-title">{{ n2 }}</h3>
                                </div>
                            </div>
                            <div class="categorie-branch-meta">
                                <span class="categorie-branch-count">{{ n3s|length }} {{ n3s|length == 1 ? 'type' : 'types' }}</span>
                            </div>
                        </header>

                        <div class="categorie-branch-children">
                            {% for type in n3s %}
                                {% include 'type_tiers/list/_leaf.html.twig' with { type: type } only %}
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
            </div>
        </section>
    {% else %}
        <div class="empty-state categorie-empty-state">
            <div class="empty-state-icon"><twig:ux:icon name="lucide:tags" /></div>
            <div>
                <h2>Aucun type de tiers</h2>
                <p>Aucun type n'est actuellement disponible.</p>
            </div>
            <a href="{{ path('app_type_tiers_new') }}" class="page-action page-action-primary">
                <twig:ux:icon name="ic:round-add" />
                <span>Ajouter un type</span>
            </a>
        </div>
    {% endfor %}
</div>

<div id="type-tiers-search-empty" class="empty-state search-empty" hidden>
    <div class="empty-state-icon"><twig:ux:icon name="lucide:search-x" /></div>
    <div>
        <h2>Aucun résultat</h2>
        <p>Aucun type ne correspond à votre recherche.</p>
    </div>
</div>
