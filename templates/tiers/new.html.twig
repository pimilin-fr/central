{% extends 'modern.html.twig' %}

{% block title %}Nouveau tiers{% endblock %}

{% block body %}
    <div class="page-container tiers-form-page">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Nouveau tiers</h1>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Retour',
                        path: path('app_tiers_index'),
                        icon: 'mdi:arrow-left',
                        color: 'neutral'
                    }
                ]
            } %}
        </div>

        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}
        {% set tabs = [
            {
                id: 'summary',
                content: include('tiers/_form.html.twig'),
                label: 'Informations',
                icon: 'solar:user-plus-bold'
            }
        ] %}

        {% include 'partials/tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
        } %}
    </div>
{% endblock %}
