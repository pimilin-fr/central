
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">

    {# =========================================================
       LISTE DES ADRESSES
       ========================================================= #}

    <div>

        {% for ta in adresses %}

            {% set adresse = ta.adresse %}

            <div class="relative bg-gray-100 p-5 rounded-xl shadow border overflow-hidden mb-4">

                {# =================================================
                   LISERÉ
                   ================================================= #}

                <div
                    class="absolute right-0 top-0 h-full w-5"
                    style="background-color: {{ ta.isPrincipale ? '#45d161' : '#d1d5db' }}"
                ></div>


                <div class="pr-9">

                    {# =================================================
                       NOM
                       ================================================= #}

                    <div class="mb-3">

                        <p class="font-semibold text-gray-800">
                            {{ adresse.name }}
                        </p>

                    </div>


                    {# =================================================
                       ADRESSE
                       ================================================= #}

                    <div class="text-sm text-gray-700">

                        <p>
                            {{ adresse }}
                        </p>

                    </div>


                    {# =================================================
                       LOCALISATION
                       ================================================= #}

                    <div class="mt-2 text-sm text-gray-500">

                        {{ adresse.codePostal ?? '' }}
                        {{ adresse.ville ?? '' }}

                        {% if adresse.pays %}
                            · {{ adresse.pays }}
                        {% endif %}

                    </div>


                    {# =================================================
                       ACTIONS
                       ================================================= #}

                    <div class="flex justify-end items-center gap-2 mt-4 pt-3 border-t border-gray-200">

                        {# Principal / secondaire #}

                        <a
                            href="{{ path(
                                'app_tiers_adresse_toggle_principale',
                                {
                                    id: ta.id,
                                    tiers: ta.tiers.id
                                }
                            ) }}"
                            class="
                                inline-flex items-center gap-2
                                px-3 py-1.5
                                rounded-lg
                                text-sm
                                transition
                                {{ ta.isPrincipale
                                    ? 'text-orange-600 hover:bg-orange-50'
                                    : 'text-green-600 hover:bg-green-50'
                                }}
                            "
                            title="{{ ta.isPrincipale
                                ? 'Retirer comme adresse principale'
                                : 'Définir comme adresse principale'
                            }}"
                        >

                            {{ ux_icon(
                                ta.isPrincipale
                                    ? 'pajamas:star'
                                    : 'mdi:star-outline',
                                {
                                    class: 'w-4 h-4'
                                }
                            ) }}

                            {{ ta.isPrincipale
                                ? 'Retirer principale'
                                : 'Définir principale'
                            }}

                        </a>


                        {# Délier #}

                        <a
                            href="{{ path(
                                'app_tiers_adresse_unlink',
                                { id: ta.id }
                            ) }}"
                            class="
                                inline-flex items-center gap-2
                                px-3 py-1.5
                                rounded-lg
                                text-sm
                                text-gray-500
                                hover:text-red-600
                                hover:bg-red-50
                                transition
                            "
                            title="Délier l'adresse"
                        >

                            {{ ux_icon('mdi:link-off', {
                                class: 'w-4 h-4'
                            }) }}

                            Délier

                        </a>

                    </div>

                </div>

            </div>

        {% else %}

            <div class="
                rounded-xl
                border border-dashed border-gray-300
                bg-gray-50
                p-8
                text-center
            ">

                {{ ux_icon('mdi:map-marker-off-outline', {
                    class: 'w-8 h-8 mx-auto text-gray-400 mb-2'
                }) }}

                <p class="text-sm text-gray-500">
                    Aucune adresse liée
                </p>

            </div>

        {% endfor %}

    </div>


    {# =========================================================
       CARTE
       ========================================================= #}

    <div class="
        rounded-xl
        shadow
        border
        overflow-hidden
        bg-gray-100
        h-fit
    ">

        <div
            id="tiers-map"
            class="w-full h-[600px]"
            >
           
        </div>

    </div>

</div>
