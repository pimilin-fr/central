<div class="p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-3 gap-6">

        {% for tiers in tiers %}

            {% set bgColor = tiers.tiersType.couleur ?? '#F97316' %}
            {% set textColor = tiers.tiersType.textColor ?? '#FFFFFF' %}
            {% set isDeleted = tiers.deletedAt is not null %}

            <a href="{{ path('app_tiers_show', {id: tiers.id}) }}"
               class="group block bg-white rounded-2xl
                      shadow-sm hover:shadow-xl
                      hover:-translate-y-1
                      transition-all duration-300 ease-out
                      relative
                      p-6 pr-10
                      border border-gray-100 hover:border-gray-200
                      {{ isDeleted ? 'opacity-50' : '' }}">

                {# --- Cercle année / mois --- #}
                {% include 'tiers/card/_circle.html.twig' %}

                {# --- LISERAI DROIT --- #}
                {% include 'tiers/card/_liserai.html.twig' %}

                {# --- CONTENU --- #}
                {% include 'tiers/card/_content.html.twig' %}

            </a>

        {% else %}

            <div class="col-span-full text-center text-gray-500 py-12">
                Aucun tiers trouvé
            </div>

        {% endfor %}

    </div>
</div>

