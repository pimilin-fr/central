{% extends 'modern.html.twig' %}

{% block title %}Tiers - {{entity.name}}{% endblock %}

{% block body %}
    <div class="page-container tiers-form-page">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">{{entity.name}}</h1>
                <p class="page-subtitle">
                <div class="w-1.5 h-6 rounded-sm mr-3"
                     style="background-color: {{ entity.tiersType.couleur ?? '#e5e7eb' }};">
                </div>

                <span class="text-sm font-medium text-gray-600 whitespace-nowrap">
                    {{ entity.tiersType.name ?? '_' }}
                </span>
                </p>
            </div>
            {# =========================
             Boutons actions lié au tiers
             ========================= #}
            {% include 'tiers/show/_btns.html.twig'%}
        </div>

        {# =========================
        ONGLETS FONCTIONNELS
        ========================= #}
        {% include 'tiers/show/_tabs.html.twig'%}
    </div>
{% endblock %}
