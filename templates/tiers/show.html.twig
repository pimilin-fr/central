{% extends 'modern.html.twig' %}

{% block title %}Tiers - {{entity.name}}{% endblock %}

{% block body %}
    <div class="page-container tiers-form-page">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="page-eyebrow">Central / Tiers</div>
                <h1 class="page-title">{{ entity.name }}</h1>

                {# Sous-titre : une seule ligne, contour + point dans la couleur du type #}
                <div class="page-subline">
                    <span class="entity-pill"
                          style="--entity-color: {{ entity.tiersType.couleur ?? '#cbd5e1' }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ entity.tiersType.name ?? '—' }}</span>
                    </span>
                </div>
            </div>

            {# Boutons actions liés au tiers #}
            {% include 'tiers/show/_btns.html.twig' %}
        </div>

        {# Onglets fonctionnels #}
        {% include 'tiers/show/_tabs.html.twig' %}
    </div>
{% endblock %}
