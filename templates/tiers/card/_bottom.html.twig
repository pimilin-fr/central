<div class="mt-auto flex items-center justify-between gap-2">

    {% set adressesActives = tiers.tiersAdresses|filter(ta => not ta.adresse.isDeleted) %}

    {# S'il n'y a aucune adresse active, on prend toutes les adresses #}
    {% if adressesActives|length == 0 %}
        {% set adressesAffichees = tiers.tiersAdresses %}
    {% else %}
        {% set adressesAffichees = adressesActives %}
    {% endif %}


    {# --- ADRESSES --- #}
    <div class="flex flex-wrap items-center gap-1.5">

        {# Adresses principales en premier #}
        {% for ta in adressesAffichees %}

            {% if ta.isPrincipale %}

                <span class="inline-flex items-center gap-1
                             text-xs font-semibold
                             px-2.5 py-1 rounded-full
                             bg-green-50 text-green-700
                             border border-green-100
                             transition-all duration-200
                             group-hover:shadow-sm">

                    {{ ux_icon('bxs:map', { class: 'w-3.5 h-3.5' }) }}

                    {{ ta.adresse.villeCourte }}

                </span>

            {% endif %}

        {% endfor %}


        {# Puis les autres adresses #}
        {% for ta in adressesAffichees %}

            {% if not ta.isPrincipale %}

                <span class="inline-flex items-center gap-1
                             text-xs font-medium
                             px-2.5 py-1 rounded-full
                             bg-gray-50 text-gray-600
                             border border-gray-100
                             transition-all duration-200
                             group-hover:bg-gray-100">

                    {{ ux_icon('bxs:map', { class: 'w-3.5 h-3.5' }) }}

                    {{ ta.adresse.villeCourte }}

                </span>

            {% endif %}

        {% endfor %}

    </div>


    {# --- STATUT ARCHIVÉ --- #}
    {% if isDeleted %}

        <span class="shrink-0 inline-flex items-center gap-1.5
                     text-xs font-semibold
                     text-red-800
                     bg-red-50
                     border border-red-100
                     px-2.5 py-1 rounded-full
                     transition-all duration-200
                     group-hover:bg-red-100">

            {{ ux_icon('lucide:archive-x', { class: 'w-3.5 h-3.5' }) }}

            Archivé

        </span>

    {% endif %}

</div>