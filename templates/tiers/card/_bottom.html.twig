<div class="tier-card-footer">
    {% set activeAddresses = tiers.tiersAdresses|filter(ta => ta.adresse and not ta.adresse.isDeleted) %}
    {% set principalAddress = activeAddresses|filter(ta => ta.principale)|first %}

    {% if principalAddress %}
        <div class="tier-address tier-address-primary">
            <span class="tier-address-icon">
                <twig:ux:icon name="lucide:star" />
            </span>

            <span class="tier-address-content">
                <span class="tier-address-label">Principale</span>
                <span class="tier-address-city">
                    {{ principalAddress.adresse.ville ?? 'Ville inconnue' }}
                </span>
            </span>
        </div>
        {% set otherAddresses = activeAddresses|filter(ta => ta != principalAddress) %}
    {% else %}
        {% set otherAddresses = activeAddresses %}
    {% endif %}

    {% for tierAddress in otherAddresses|slice(0, 2) %}
        <div class="tier-address">
            <span class="tier-address-icon">
                <twig:ux:icon name="lucide:map-pin" />
            </span>

            <span class="tier-address-content">
                <span class="tier-address-label">
                    Adresse
                </span>
                <span class="tier-address-city">
                    {{ tierAddress.adresse.ville ?? 'Ville inconnue' }}
                </span>
            </span>
        </div>
    {% endfor %}

    {% if isDeleted %}
        <div class="tier-address tier-address-archived">
            <span class="tier-address-icon">
                <twig:ux:icon name="lucide:archive-x" />
            </span>

            <span class="tier-address-content">
                <span class="tier-address-label">Statut</span>
                <span class="tier-address-city">Archivé</span>
            </span>
        </div>
    {% elseif not principalAddress and activeAddresses is empty %}
        <div class="tier-address tier-address-muted">
            <span class="tier-address-icon">
                <twig:ux:icon name="lucide:map-pin-off" />
            </span>

            <span class="tier-address-content">
                <span class="tier-address-label">Adresse</span>
                <span class="tier-address-city">Aucune adresse</span>
            </span>
        </div>
    {% endif %}
</div>
