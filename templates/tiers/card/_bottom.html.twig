<div class="mt-auto flex items-center justify-between gap-3">

    {% set adressesActives = tiers.tiersAdresses|filter(ta => not ta.adresse.isDeleted) %}

    {# S'il n'y a aucune adresse active, on prend toutes les adresses #}
    {% if adressesActives|length == 0 %}
        {% set adressesAffichees = tiers.tiersAdresses %}
    {% else %}
        {% set adressesAffichees = adressesActives %}
    {% endif %}


    {# ============================================================
       ADRESSES
       ============================================================ #}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">

        {# --------------------------------------------------------
           Adresse principale
           -------------------------------------------------------- #}
        {% for ta in adressesAffichees %}

            {% if ta.isPrincipale %}

                <div class="inline-flex items-center gap-1.5
                            text-xs font-semibold text-gray-700
                            transition-all duration-200
                            group-hover:-translate-y-0.5">

                    <span class="flex items-center justify-center
                                 w-5 h-5 rounded-full
                                 bg-gray-50
                                 border border-gray-100">

                        {{ ux_icon('lucide:star', {
                            class: 'w-3 h-3'
                        }) }}

                    </span>

                    <span>
                        {{ ta.adresse.villeCourte }}
                    </span>

                </div>

            {% endif %}

        {% endfor %}


        {# --------------------------------------------------------
           Autres adresses
           -------------------------------------------------------- #}
        {% for ta in adressesAffichees %}

            {% if not ta.isPrincipale %}

                <div class="inline-flex items-center gap-1
                            text-xs text-gray-400
                            transition-colors duration-200
                            group-hover:text-gray-500">

                    {{ ux_icon('lucide:map-pin', {
                        class: 'w-3.5 h-3.5'
                    }) }}

                    <span>
                        {{ ta.adresse.villeCourte }}
                    </span>

                </div>

            {% endif %}

        {% endfor %}

    </div>


    {# ============================================================
       STATUT ARCHIVÉ
       ============================================================ #}
    {% if isDeleted %}

        <span class="shrink-0 inline-flex items-center gap-1.5
                     text-xs font-semibold
                     text-red-700
                     transition-all duration-200
                     group-hover:text-red-800">

            {{ ux_icon('lucide:archive-x', {
                class: 'w-3.5 h-3.5'
            }) }}

            Archivé

        </span>

    {% endif %}

</div>