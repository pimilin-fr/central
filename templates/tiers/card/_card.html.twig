{# Carte tiers — composants génériques entity-* (couleur = type de tiers) #}
{% set bgColor = tiers.tiersType.couleur ?? 'var(--accent)' %}
{% set textColor = tiers.tiersType.textColor ?? '#FFFFFF' %}
{% set isDeleted = tiers.deletedAt is not null %}
{% set preview = preview is defined and preview %}
{% set linkTag = preview ? 'div' : 'a' %}

<article
    class="entity-card {{ isDeleted ? 'is-archived' : '' }}"
    data-live-color="tiersType"
    style="--entity-color: {{ bgColor }}; --entity-text: {{ textColor }};"
    data-search-item
    data-search-value="{{ (
                (tiers.name ?? '') ~ ' ' ~
                (tiers.tiersType.libelle ?? '') ~ ' ' ~
                (tiers.tiersType.typeN1 ?? '') ~ ' ' ~
                (tiers.tiersType.typeN2 ?? '')
            )|lower }}"
    >
    <{{ linkTag }} class="entity-card-link"{% if not preview %} href="{{ path('app_tiers_show', {'id': tiers.id}) }}"{% endif %}>
        {% include 'tiers/card/_circle.html.twig' %}

        <div class="entity-ribbon">
            <span class="entity-ribbon-label" data-live="tiersType" data-live-empty="TYPE">{{ tiers.tiersType.libelleLiserai ?? tiers.tiersType.libelle ?? 'TYPE' }}</span>
        </div>

        <div class="entity-body">
            {% include 'tiers/card/_content.html.twig' %}
        </div>
    </{{ linkTag }}>
</article>
