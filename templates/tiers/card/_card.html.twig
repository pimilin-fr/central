{# Carte tiers — composants génériques entity-* (couleur = type de tiers) #}
{% set bgColor = (tiers.tiersType.couleur ?? null)|entity_color %}
{% set textColor = (tiers.tiersType.couleur ?? null)|entity_text %}
{% set isDeleted = tiers.deletedAt is not null %}

<article
    class="entity-card {{ isDeleted ? 'is-archived' : '' }} card"
    style="--entity-color: {{ bgColor }}; --entity-text: {{ textColor }};"
    data-search-item
    data-search-value="{{ (
                (tiers.name ?? '') ~ ' ' ~
                (tiers.tiersType.libelle ?? '') ~ ' ' ~
                (tiers.tiersType.typeN1 ?? '') ~ ' ' ~
                (tiers.tiersType.typeN2 ?? '')
            )|lower }}"
    >
    <a href="{{ path('app_tiers_show', {'id': tiers.id}) }}" class="entity-card-link">
        {% include 'tiers/card/_circle.html.twig' %}

        <div class="entity-ribbon">
            <span class="entity-ribbon-label">{{ tiers.tiersType.libelleLiserai ?? tiers.tiersType.libelle ?? 'TYPE' }}</span>
        </div>

        <div class="entity-body">
            {% include 'tiers/card/_content.html.twig' %}
            {#{% include 'demo/card/_pill.html.twig'  with { entity: tiers }  %}#}
        </div>
    </a>
</article>
