<div class="tier-card-content">
    <div class="tier-card-heading">
        <div class="tier-card-title">
            {{ tiers.name }}
        </div>

    {% if tiers.code %}
        <div class="tier-card-code">
            {{ tiers.code }}
        </div>
    {% endif %}
</div>

<div class="tier-card-separator">
    <span class="tier-card-separator-dot" style="--tier-color: {{ bgColor }}"></span>
    <span class="tier-card-separator-line"></span>
</div>

<div class="tier-card-type">
    {% if tiers.tiersType.typeN1 %}
        <span class="tier-card-type-main">
            {{ tiers.tiersType.typeN1 }}
        </span>
    {% endif %}

    {% if tiers.tiersType.typeN2 %}
        <span class="tier-card-type-detail">
            {{ tiers.tiersType.typeN2 }}
        </span>
    {% endif %}
</div>

{% include 'tiers/card/_bottom.html.twig' %}

</div>
