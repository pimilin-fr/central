<div class="entity-head">
    <h2 class="entity-title" title="{{ tiers.name }}">{{ tiers.name }}</h2>

    {# Nature (personne / société) + code sur la même ligne : aucune hauteur ajoutée #}
    {% set isPerson = tiers_is_person(tiers) %}
    <span class="entity-sub is-plain entity-sub-row">
        <span class="entity-nature{{ isPerson ? ' is-person' : '' }}" title="{{ isPerson ? 'Personne' : 'Société' }}">
            <twig:ux:icon name="{{ isPerson ? 'lucide:user-round' : 'lucide:building-2' }}" />
        </span>
        {% if tiers.code %}<span class="entity-sub-text">{{ tiers.code }}</span>{% endif %}
    </span>
</div>

<div class="sep sep-inset">
    <span class="sep-dot"></span>
    <span class="sep-line"></span>
</div>

{# Type N1 / N2 #}
<div class="entity-meta">
    {% if tiers.tiersType.typeN1 %}
        <span class="entity-meta-main">{{ tiers.tiersType.typeN1 }}</span>
    {% endif %}

    {% if tiers.tiersType.typeN1 and tiers.tiersType.typeN2 %}
        <span class="entity-meta-sep">/</span>
    {% endif %}

    {% if tiers.tiersType.typeN2 %}
        <span>{{ tiers.tiersType.typeN2 }}</span>
    {% endif %}
</div>

{% include 'tiers/card/_bottom.html.twig' %}
