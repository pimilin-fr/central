{% set months = {
            '01': 'JAN', '02': 'FÉV', '03': 'MAR', '04': 'AVR', '05': 'MAI',
            '06': 'JUN', '07': 'JUI', '08': 'AOÛ', '09': 'SEP', '10': 'OCT',
            '11': 'NOV', '12': 'DÉC'
} %}

<div class="tier-date-circle" style="--tier-color: {{ bgColor }}; --tier-text: {{ textColor }};">
    <span class="tier-date-month">
        {{ tiers.createdAt ? tiers.createdAt|date('m')|number_format(0, '', '')|format('%02d') : '—' }}
    </span>

    {% if tiers.createdAt %}
        <span class="tier-date-month">{{ months[tiers.createdAt|date('m')] }}</span>
        <span class="tier-date-year">{{ tiers.createdAt|date('Y') }}</span>
    {% else %}
        <span class="tier-date-year">N/A</span>
    {% endif %}

</div>

