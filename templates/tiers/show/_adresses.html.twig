{#
    Adresses liées à un tiers : tuiles identiques à la liste des adresses
    (adresse/card/_card + actions du lien Tiers ↔ Adresse) sur ~1/3,
    carte multipoint sur la plus grande partie.
#}
<div class="geo-layout">

    <div class="geo-list">
        {% if adresses|length > 0 %}
            {% for ta in adresses %}
                {% include 'adresse/card/_card.html.twig' with {
                    adresse: ta.adresse,
                    tierAdresse: ta
                } only %}
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <div class="empty-state-icon"><twig:ux:icon name="lucide:map-pin-off" /></div>
                <div>
                    <h2>Aucune adresse liée</h2>
                    <p>Utilisez le formulaire ci-dessus pour lier une adresse à ce tiers.</p>
                </div>
            </div>
        {% endif %}
    </div>

    <section class="geo-card">
        <div class="geo-card-ribbon"></div>
        <div class="geo-card-body">
            <div class="geo-card-head">
                <p class="summary-label">Localisation</p>
                <p class="geo-card-count">
                    <twig:ux:icon name="lucide:map-pinned" />
                    {{ adresses|length }} adresse{{ adresses|length > 1 ? 's' : '' }}
                </p>
            </div>

            <div id="tiers-map" data-map data-map-type="multipoint" class="geo-map">
                {% for ta in adresses %}
                    {% set adresse = ta.adresse %}
                    {% if adresse.latitude is not null and adresse.longitude is not null %}
                        <span data-map-point
                              data-latitude="{{ adresse.latitude }}"
                              data-longitude="{{ adresse.longitude }}"
                              data-id="{{ adresse.id }}"
                              data-name="{{ adresse.name }}"
                              data-principale="{{ ta.isPrincipale ? '1' : '0' }}"
                              data-url="{{ path('app_adresse_show', {id: adresse.id}) }}">
                        </span>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>
</div>
