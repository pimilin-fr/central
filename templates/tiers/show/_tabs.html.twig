{% set activeTab = app.request.query.get('tab') ?? 'summary' %}

{% set tabs = [
    {
        id: 'summary',
        label: 'Résumé',
        content: include('tiers/_resume.html.twig',{
            tiers: entity
        })
    },{
        id: 'edit',
        label: 'Modifier',
        icon: 'mdi:pencil',
        content: render(controller(
                'App\\Controller\\TiersController::edit',
                {
                    id: entity.id
                }
            ))
    },{
        id: 'adresses',
        label: 'Adresses',
        badge: adresses|length,
        content: render(controller(
                'App\\Controller\\TiersController::addAdresse',
                {
                    id: entity.id
                }
            ))
            ~ include('tiers/_show_adresses.html.twig')
    },{
        id: 'addoperation',
        label: 'Opération',
        icon: 'ic:round-add',
        content: render(controller(
            'App\\Controller\\TiersController::addOperation',
            {
                id: entity.id
            }
        ))
    }
]%}

{% include 'partials/tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
} %}