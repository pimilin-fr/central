{% set btns = [
    {
        label: 'Retour',
        path: path('app_tiers_index'),
        icon: 'mdi:arrow-left',
        color: 'neutral'
    },
    {
        type: 'button',
        label: 'Opération',
        icon: 'gridicons:add',
        color: 'primary',
        title: 'Ajouter une opération pour ce tiers',
        attrs: { 'data-op-open': true }
    }
] %}

{% if entity.tiersType %}
    {% set btns = btns|merge([
        {
            label: "Type",
            path: path('app_type_tiers_show', { id: entity.tiersType.id }),
            color: 'primary',
            icon: 'icon-park-solid:up-c',
        }
    ]) %}
{% endif %}

{% if entity.deletedAt is null %}
    {% set btns = btns|merge([ {
        label: "Suppr.",
        path: path('app_tiers_delete', {id:entity.id}),
        color: 'danger',
        icon: 'fa7-solid:trash'
    }])%}
{% else %}
    {% set btns = btns|merge([ {
        label: "Restaurer",
        path: path('app_tiers_restore', {id:entity.id}),
        color: 'info',
        icon: 'fa7-solid:trash-restore'
    }])%}
{% endif %}

{% include 'layout/modern/components/_btns.html.twig'%}