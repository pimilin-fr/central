<div class="grid grid-cols-1 lg:grid-cols-4 gap-4">

    {# Résumé #}
    <div class="lg:col-span-3 bg-white p-5">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-gray-500">Nom</p>
                <p class="text-gray-800 font-medium">{{ tiers.name }}</p>
            </div>

            <div>
                <p class="text-gray-500">Type</p>
                <p class="text-gray-800 font-medium">
                    {{ tiers.tiersType.name ?? '—' }}
                </p>
            </div>
            <div>
                <p class="text-gray-500">Text de recherche</p>
                <p class="text-gray-800 font-medium">
                    {{ tiers.searchText ?? '—' }}
                </p>
            </div>
        </div>
    </div>

    {# Dates (tuile compacte à droite) #}
    <div class="bg-gray-200 rounded-xl border shadow-sm p-4 text-sm">
        {% if tiers.deletedAt %}
            <p class="flex items-center gap-2 text-xs text-red-600 font-bold">
                {{ ux_icon('fluent-mdl2:status-error-full', { class: 'w-4 h-4' }) }}
                <span>Inactif</span>
            </p>
        {% else %}
            <p class="flex items-center gap-2 text-xs text-green-600 font-bold">
                {{ ux_icon('pajamas:status-active', { class: 'w-4 h-4' }) }}
                <span>Actif</span>
            </p>
        {% endif %}
        <p class="mt-2 text-xs text-gray-500 uppercase">Créé le</p>
        <p class="text-gray-800">{{ tiers.createdAt|date('d/m/Y') }}</p>
        {% if tiers.deletedAt %}
            <p class="mt-2 text-xs text-gray-500 uppercase">Suppr le</p>
            <p class="text-gray-800">{{ tiers.deletedAt|date('d/m/Y') }}</p>
        {% endif %}
    </div>
</div>