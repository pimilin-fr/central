<div
    id="tiers-list"
    class="entity-grid"
    data-search-target
    >
    {% for tiers in tiers %}
        {% include 'tiers/card/_card.html.twig'%}
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon"><twig:ux:icon name="lucide:users-round" /></div>
            <div>
                <h2>Aucun tiers</h2>
                <p>Aucun tiers ne correspond actuellement à votre liste.</p>
            </div>
            <a href="{{ path('app_tiers_new') }}" class="page-action page-action-primary">
                <twig:ux:icon name="ic:round-add" />
                Ajouter un tiers
            </a>
        </div>
    {% endfor %}
</div>

<div id="tiers-search-empty" class="empty-state search-empty" hidden>
    <div class="empty-state-icon"><twig:ux:icon name="lucide:search-x" /></div>
    <div>
        <h2>Aucun résultat</h2>
        <p>Aucun tiers ne correspond à votre recherche.</p>
    </div>
</div>
