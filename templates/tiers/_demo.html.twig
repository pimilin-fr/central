{% set strategy = entity.demoStrategy.value ?? null %}

{% set mapping = {
    'copy':      { 'label': 'Copie',      'color': 'bg-blue-500 text-white' },
    'anonymize': { 'label': 'Anonymisé',  'color': 'bg-yellow-400 text-black' },
    'exclude':   { 'label': 'Exclue',     'color': 'bg-red-500 text-white' }
} %}

{% set item = mapping[strategy] ?? { 'label': 'Erreur', 'color': 'bg-gray-800 text-white' } %}

<span class="px-2 py-1 rounded text-xs font-semibold {{ item.color }}">
    {{ item.label }}
</span>
