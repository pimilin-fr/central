{% extends 'modern.html.twig' %}

{% block title %}
    Tiers
{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="page-eyebrow">
                    Central / Gestion
                </div>

                <h1 class="page-title">
                    Tiers
                </h1>

                <p class="page-subtitle">
                    Gérez vos personnes, entreprises et autres interlocuteurs.
                </p>
            </div>

            <div class="page-actions">
                <a href="{{ path('app_type_tiers_index') }}" class="ui-button ui-button-secondary">
                    <twig:ux:icon name="mage:users-fill" />
                    <span>Types de tiers</span>
                </a>

                <a href="{{ path('app_tiers_new') }}" class="ui-button ui-button-primary">
                    <twig:ux:icon name="ic:round-add" />
                    <span>Ajouter</span>
                </a>
            </div>
        </div>

        <div class="page-toolbar">
            <div class="page-toolbar-search">
                <twig:ux:icon name="lucide:search" />
                <input type="search" placeholder="Rechercher un tiers..." aria-label="Rechercher un tiers" data-tier-search />
            </div>

            <div class="page-toolbar-info">
                <span class="toolbar-dot"></span>
                <span> {{ tiers|length }} {{ tiers|length > 1 ? 'tiers' : 'tiers' }}</span>
            </div>
        </div>

        <section class="tiers-grid-wrapper">
            {% include 'tiers/_table.html.twig' %}
        </section>
    </div>
{% endblock %}
