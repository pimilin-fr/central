
<div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">

    {# SOLDE #}
    <div class="md:col-span-1 bg-gray-100 p-5 rounded-xl border shadow">
        <div class="text-sm text-gray-800">Solde réel</div>

        {% set solde = portefeuille.balanceActuelle %}


        <div class="text-2xl font-bold
             {{ solde >= 0 ? 'text-green-600' : 'text-red-500' }}">
            {{ solde|number_format(2, ',', ' ') }} €
        </div>
    </div>

    {# OPTIONS DE GROUPEMENT #}
    <div class="md:col-span-2 bg-gray-100 p-5 rounded-xl border shadow">
        {% include 'detail/v2/_grouping.html.twig' with {
            groupBy: groupBy,
            route: 'app_portefeuille_show',
            routeParams: {
                id: portefeuille.id,
                tab: 'summary'
            }
        } %}
    </div>

    {# INFOS PORTEFEUILLE #}
    <div class="md:col-span-2 bg-gray-100 p-5 rounded-xl shadow border relative overflow-hidden">

        {# Liseré couleur #}
        <div
            class="absolute right-0 top-0 h-full w-5"
            style="background-color: {{ portefeuille.couleur ?? '#e5e7eb' }}"
            ></div>

        <div class="pr-4 grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-5 text-sm">

            {# LIBELLÉ #}
            <div>
                <p class="text-xs text-gray-500 tracking-wide">
                    Libellé
                </p>
                <p class="font-medium text-gray-800 mt-1">
                    {{ portefeuille.libelle }}
                </p>
            </div>

            {# ORIGINE #}
            <div>
                <p class="text-xs text-gray-500 tracking-wide">
                    Origine
                </p>
                <p class="font-medium text-gray-800 mt-1">
                    {{ portefeuille.origine ?? '—' }}
                </p>
            </div>

            {# COULEUR #}
            <div>
                <p class="text-xs text-gray-500 tracking-wide">
                    Couleur
                </p>

                <div class="flex items-center gap-2 mt-1">
                    <div
                        class="w-4 h-4 rounded border border-gray-300"
                        style="background-color: {{ portefeuille.couleur ?? '#e5e7eb' }}"
                        ></div>

                    <span class="font-medium text-gray-800">
                        {{ portefeuille.couleur ?? '—' }}
                    </span>
                </div>
            </div>

            {# DÉFAUT #}
            <div>
                <p class="text-xs text-gray-500 tracking-wide">
                    Défaut
                </p>

                <div class="mt-1">
                    {% if portefeuille.isDefault %}
                        {{ ux_icon('mdi:check-circle', {
                        class: 'w-5 h-5 text-green-500'
                    }) }}
                    {% else %}
                        {{ ux_icon('mdi:close-circle', {
                        class: 'w-5 h-5 text-gray-400'
                    }) }}
                    {% endif %}
                </div>
            </div>

            {# DÉPENSES RÉELLES #}
            <div>
                <p class="text-xs text-gray-500 tracking-wide">
                    Dépenses réelles
                </p>

                <div class="mt-1">
                    {% if portefeuille.isReal %}
                        {{ ux_icon('mdi:check-circle', {
                        class: 'w-5 h-5 text-green-500'
                    }) }}
                    {% else %}
                        {{ ux_icon('mdi:close-circle', {
                        class: 'w-5 h-5 text-red-500'
                    }) }}
                    {% endif %}
                </div>
            </div>

        </div>

    </div>

</div>

<div>
    <form method="post" action="{{ path('app_depenses_bulk_update') }}" class="mb-4"  data-bulk-form>
        <div class="flex flex-wrap items-end gap-4 bg-gray-100 p-4 rounded-lg border shadow-sm space-y-3 mb-4">
            {{ include('depenses/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include('detail/v2/_releve.html.twig')%}
        </div>
    </form>
</div>

