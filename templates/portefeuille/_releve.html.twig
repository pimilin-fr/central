

{% for releve in releves %}
    {% set releveId = releve.getId() ?? 0 %}
{#    {{ releve }}#}
    {#{% set releve = item.releve %}#}

    <div class="border-b border-gray-200">

        {# HEADER RELEVÉ (résumé) #}
        <div 
            class="flex items-center justify-between py-3 cursor-pointer hover:bg-gray-50 transition"
            onclick="toggleReleve({{ releve.date|date('Ymd') }})"
            >

            <div class="flex items-center gap-4">
                {%if releve.date is null%}
                    <span class="text-sm font-semibold text-orange-500">
                        {{releve.label}} 
                    </span>
                {%else%}
                    <span class="text-sm font-semibold text-gray-700">
                        {{ releve.date|date('d/m/Y') }}
                    </span>
                {% endif %}
                <span class="text-xs text-gray-500">
                    {% if releve.depenses is not empty %}
                        {{ releve.depenses|length }} opérations
                    {% else %}
                        aucune opérations
                    {% endif %}
                </span>

            </div>

            <div class="flex items-center gap-6 text-sm">

                <span class="text-red-500 font-medium">
                    - {{ releve.totalDepense|number_format(2, ',', ' ') }} €
                </span>

                <span class="text-green-600 font-medium">
                    + {{ releve.totalRevenu|number_format(2, ',', ' ') }} €
                </span>

                <span class="text-gray-500">
                    {{ releve.previousBalance|number_format(2, ',', ' ') }} €
                </span>

                <span class="font-semibold">
                    → {{ releve.currentBalance|number_format(2, ',', ' ') }} €
                </span>

            </div>

        </div>

        {# DETAILS #}
        <div 
            id="releve-{{ releve.date|date('Ymd') }}" 
            class="hidden"
            >

            {{ include('depenses/_table.html.twig', {
            depenses: releve.depenses
        }) }}

        </div>

    </div>

{% endfor %}

