<div class="resume-layout">

    {# REGROUPEMENT #}
    {% include 'depenses/list/_grouping.html.twig' with {
        groupBy: groupBy,
        route: 'app_portefeuille_show',
        routeParams: {
            id: portefeuille.id,
            tab: 'summary'
        }
    } %}

    {# CARTE RESUME : cercle (type) | identité + infos | solde | liseré (couleur + libellé) #}
    <section class="summary-card {{ portefeuille.deletedAt ? 'is-archived' : '' }}"
             style="--entity-color: {{ (portefeuille.couleur ?? null)|entity_color }}; --entity-text: {{ (portefeuille.couleur ?? null)|entity_text }};">

        {% include 'portefeuille/card/_circle.html.twig' %}

        <div class="summary-body">

            <div class="summary-head">
                <h2 class="summary-name" title="{{ portefeuille.libelle }}">{{ portefeuille.libelle }}</h2>

                {% if portefeuille.type %}
                    <span class="entity-pill" style="--entity-color: {{ (portefeuille.couleur ?? null)|entity_color }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ portefeuille.type }}</span>
                    </span>
                {% endif %}
            </div>

            <div class="summary-grid-2-cols">
                <div class="summary-field">
                    <p class="summary-label">Libellé</p>
                    <p class="summary-value" title="{{ portefeuille.libelle ?? '' }}">{{ portefeuille.libelle ?? '—' }}</p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Origine</p>
                    <p class="summary-value">{{ portefeuille.origine ?? '—' }}</p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Par défaut</p>
                    <p class="summary-value">
                        <span class="flag {{ portefeuille.isDefault ? 'is-on' : '' }}">
                            <twig:ux:icon name="{{ portefeuille.isDefault ? 'lucide:circle-check' : 'lucide:circle-x' }}" />
                            {{ portefeuille.isDefault ? 'Oui' : 'Non' }}
                        </span>
                    </p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Dépenses réelles</p>
                    <p class="summary-value">
                        <span class="flag {{ portefeuille.isReal ? 'is-on' : '' }}">
                            <twig:ux:icon name="{{ portefeuille.isReal ? 'lucide:circle-check' : 'lucide:circle-x' }}" />
                            {{ portefeuille.isReal ? 'Oui' : 'Non' }}
                        </span>
                    </p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Démo</p>
                    <p class="summary-value">
                        {% include 'demo/card/_pill.html.twig' with { entity: portefeuille } %}
                    </p>
                </div>
            </div>
        </div>

        <div class="summary-aside">
            {% include 'portefeuille/card/_balance.html.twig' with { portefeuille: portefeuille } only %}
        </div>

        <div class="summary-ribbon">
            <span class="summary-ribbon-label">{{ portefeuille.libelle ?? portefeuille.name }}</span>
        </div>
    </section>

    {# MODIFICATION EN MASSE + RELEVES #}
    <form method="post" action="{{ path('app_depenses_bulk_update') }}" class="bulk-form" data-bulk-form>
        <div class="bulk-bar" data-bulk-bar>
            {{ include('depenses/list/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include 'depenses/list/_group.html.twig' %}
        </div>
    </form>
</div>
