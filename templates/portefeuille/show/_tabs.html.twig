{% set activeTab = app.request.query.get('tab') ?? 'summary' %}
{% set tabs = [
    {
        id: 'summary',
        label: 'Informations',
        icon: 'solar:wallet-money-bold',
        content: include('portefeuille/show/_activite.html.twig', {
            portefeuille: entity,
            groups: groups
        })
    },{
        id: 'releves',
        label: 'Relevés',
        icon: 'fluent:task-list-ltr-24-regular',
        content: render(controller(
            'App\\Controller\\ReleveController::fragment',
            { id: entity.id }
        ))
    },{
        id: 'prevision',
        label: 'Prévisions',
        icon: 'lucide:calendar-clock',
        content: render(controller(
            'App\\Controller\\PrevisionController::fragment',
            { id: entity.id }
        ))
    },{
        id: 'edit',
        label: 'Modifier',
        icon: 'mingcute:edit-2-fill',
        content: render(controller(
            'App\\Controller\\PortefeuilleController::edit',
            { id: entity.id }
        ))
    }
] %}

{% include 'layout/modern/components/_tabs.html.twig' with {
    tabs: tabs,
    activeTab: activeTab
} %}