<div id="portefeuilles-list" class="entity-grid" data-search-target>
    {% for item in items %}
        {% set portefeuille = item.portefeuille %}
        {% set isDeleted = portefeuille.deletedAt is not null %}

        <article class="entity-card {{ isDeleted ? 'is-archived' : '' }}"
                 style="--entity-color: {{ portefeuille.couleur ?? 'var(--accent)' }}; --entity-text: {{ portefeuille.textColor ?? '#FFFFFF' }};"
                 data-search-item
                 data-search-value="{{ (
                    (portefeuille.name ?? '') ~ ' ' ~
                    (portefeuille.libelle ?? '') ~ ' ' ~
                    (portefeuille.origine ?? '') ~ ' ' ~
                    (portefeuille.type ?? '')
                 )|lower }}">
            <a href="{{ path('app_portefeuille_show', { id: portefeuille.id }) }}" class="entity-card-link">

                <div class="entity-circle">
                    {% include 'portefeuille/_type_icon.html.twig' with { portefeuille: portefeuille } only %}
                </div>

                <div class="entity-ribbon">
                    <span class="entity-ribbon-label">{{ portefeuille.libelle ?? portefeuille.name }}</span>
                </div>

                <div class="entity-body">
                    <div class="entity-head">
                        <h2 class="entity-title" title="{{ portefeuille.name }}">{{ portefeuille.name }}</h2>
                        <span class="entity-sub">
                            {{ portefeuille.type }}{% if portefeuille.origine %} · {{ portefeuille.origine }}{% endif %}
                        </span>
                    </div>

                    <div class="sep sep-inset">
                        <span class="sep-dot"></span>
                        <span class="sep-line"></span>
                    </div>

                    {% include 'portefeuille/_balance.html.twig' with { portefeuille: portefeuille } only %}
                </div>
            </a>
        </article>
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon"><twig:ux:icon name="lucide:wallet" /></div>
            <div>
                <h2>Aucun portefeuille</h2>
                <p>Aucun portefeuille ne correspond actuellement à votre liste.</p>
            </div>
            <a href="{{ path('app_portefeuille_new') }}" class="page-action page-action-primary">
                <twig:ux:icon name="ic:round-add" />
                Ajouter un portefeuille
            </a>
        </div>
    {% endfor %}
</div>

<div id="portefeuilles-search-empty" class="empty-state tier-search-empty" hidden>
    <div class="empty-state-icon"><twig:ux:icon name="lucide:search-x" /></div>
    <div>
        <h2>Aucun résultat</h2>
        <p>Aucun portefeuille ne correspond à votre recherche.</p>
    </div>
</div>
