{% extends 'modern.html.twig' %}

{% set breadcrumb_current = entity.libelle ?? entity.name %}

{% block title %}Portefeuille - {{ entity.name }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">

                <h1 class="page-title">{{ entity.libelle }}</h1>

                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ entity.couleur ?? 'var(--accent)' }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ entity.type ?? '—' }} {% if entity.origine %}- {{ entity.origine }}{%endif%}</span>
                    </span>
                    
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Retour',
                        path: path('app_portefeuille_index'),
                        icon: 'mdi:arrow-left',
                        color: 'neutral'
                    },
                    {
                        label: 'Suppr.',
                        path: path('app_portefeuille_delete', { id: entity.id }),
                        icon: 'gridicons:trash',
                        color: 'danger'
                    }
                ]
            } %}
        </div>

        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}

        {% set tabs = [
            {
                id: 'summary',
                label: 'Résumé',
                content: include('portefeuille/show/_activite.html.twig', {
                    portefeuille: entity,
                    groups: groups
                })
            },{
                id: 'edit',
                label: 'Modifier',
                icon: 'mdi:pencil',
                content: render(controller(
                    'App\\Controller\\PortefeuilleController::edit',
                    { id: entity.id }
                ))
            },{
                id: 'addoperation',
                label: 'Opération',
                icon: 'ic:round-add',
                content: render(controller(
                    'App\\Controller\\PortefeuilleController::addOperation',
                    { id: entity.id }
                ))
            }
        ] %}

        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
        } %}
    </div>
{% endblock %}
