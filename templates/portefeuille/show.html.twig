{% extends 'modern.html.twig' %}

{% set breadcrumb_current = entity.libelle ?? entity.name %}

{% block title %}Portefeuille - {{ entity.name }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">

                <h1 class="page-title">{{ entity.libelle }}</h1>

                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ (entity.couleur ?? null)|entity_color }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ entity.type ?? '—' }} {% if entity.origine %}- {{ entity.origine }}{%endif%}</span>
                    </span>
                    
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Retour',
                        path: path('app_portefeuille_index'),
                        icon: 'mdi:arrow-left',
                        color: 'neutral'
                    },
                    {
                        label: 'Suppr.',
                        path: path('app_portefeuille_delete', { id: entity.id }),
                        icon: 'gridicons:trash',
                        color: 'danger'
                    }
                ]
            } %}
        </div>

        {# Onglets fonctionnels #}
        {% include 'portefeuille/show/_tabs.html.twig' %}
    </div>
{% endblock %}
