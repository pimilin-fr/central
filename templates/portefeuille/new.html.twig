{% extends 'modern.html.twig' %}

{% block title %}Nouveau portefeuille{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="page-eyebrow">Central / Portefeuilles</div>
                <h1 class="page-title">Nouveau portefeuille</h1>
                <p class="page-subtitle">Définissez le type, la couleur et le comportement de votre portefeuille.</p>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Retour',
                        path: path('app_portefeuille_index'),
                        icon: 'mdi:arrow-left',
                        color: 'neutral'
                    }
                ]
            } %}
        </div>

        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}
        {% set tabs = [
            {
                id: 'summary',
                content: include('portefeuille/_form.html.twig'),
                label: 'Informations',
                icon: 'lucide:wallet'
            }
        ] %}

        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
        } %}
    </div>
{% endblock %}
