{% extends 'base.html.twig' %}

{% block title %}Portefeuille{% endblock %}

{% block body %}
    <div class="space-y-6">
        {# =========================
            HEADER : Titre + actions (modernisé)
            ========================= #}
        {% set btns = [] %}
        {% set btns = btns|merge([{
                label: "Retour",
                path: path('app_portefeuille_index'),
                color: 'gray',
                icon: 'mdi:arrow-left',
            }]) %}


        {% include 'partials/header.html.twig' with {
            btns: btns,
            title: 'Nouveau portefeuille',
            item: null
        } %}


        {# =========================
          ONGLETS FONCTIONNELS
          ========================= #}
        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}

        {% set tabs = [
            {
                id: 'summary', 
                content: include('portefeuille/_form.html.twig'),
                label: 'Ajout',
                icon: 'ic:round-add'
            }
        ] %}

        {% include 'partials/tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
        } %}

    </div>
{% endblock %}
