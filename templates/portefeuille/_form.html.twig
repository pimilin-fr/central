{% set isEdit = portefeuille.id is not null %}
{% set formAction = isEdit
    ? path('app_portefeuille_edit', { id: portefeuille.id })
    : path('app_portefeuille_new') %}

{{ form_start(form, {
    action: formAction,
    attr: { class: 'modern-form' }
}) }}

<div class="modern-form-intro">
    <div>
        <span class="modern-form-kicker">IDENTITÉ DU PORTEFEUILLE</span>
        <h2 class="modern-form-title">Informations essentielles</h2>
    </div>
    <span class="modern-form-step">01 — 04</span>
</div>

<div class="form-section-grid">

    {# 01 — Nom #}
    <div class="form-field-card form-field-card-wide">
        <div class="form-field-heading">
            <span class="form-field-index">01</span>
            <h3>Nom du portefeuille</h3>
        </div>
        {{ form_label(form.name, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.name, { attr: { class: 'modern-form-control', placeholder: 'Ex. Compte courant' } }) }}
        {{ form_errors(form.name) }}
    </div>

    {# 02 — Type & origine #}
    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">02</span>
            <h3>Type &amp; origine</h3>
        </div>
        <div class="form-stack">
            <div>
                {{ form_label(form.type, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.type, { attr: { class: 'modern-form-control' } }) }}
                {{ form_errors(form.type) }}
            </div>
            <div>
                {{ form_label(form.origine, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.origine, { attr: { class: 'modern-form-control' } }) }}
                {{ form_errors(form.origine) }}
            </div>
        </div>
    </div>

    {# 03 — Apparence #}
    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">03</span>
            <h3>Apparence</h3>
        </div>
        <div class="form-stack">
            <div>
                {{ form_label(form.libelle, 'Libellé du liseré', { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.libelle, { attr: { class: 'modern-form-control', placeholder: 'Texte affiché sur le liseré' } }) }}
                {{ form_errors(form.libelle) }}
            </div>
            <div>
                {{ form_label(form.couleur, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.couleur, { attr: { class: 'modern-form-control' } }) }}
                {{ form_errors(form.couleur) }}
            </div>
        </div>
    </div>

    {# 04 — Comportement #}
    <div class="form-field-card form-field-card-wide">
        <div class="form-field-heading">
            <span class="form-field-index">04</span>
            <h3>Comportement</h3>
        </div>
        <div class="form-section-grid">
            <div class="choice-list">
                <label class="choice-card">
                    {{ form_widget(form.isDefault) }}
                    <span>Portefeuille par défaut</span>
                </label>
                {{ form_errors(form.isDefault) }}

                <label class="choice-card">
                    {{ form_widget(form.isReal) }}
                    <span>Dépenses réelles</span>
                </label>
                {{ form_errors(form.isReal) }}
            </div>

            <div>
                {{ form_label(form.demoStrategy, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.demoStrategy, { attr: { class: 'modern-form-control' } }) }}
                {{ form_errors(form.demoStrategy) }}
            </div>
        </div>
    </div>
</div>

<div class="modern-form-footer">
    <span class="modern-form-footer-copy">
        {{ isEdit ? 'Les modifications s’appliquent immédiatement.' : 'Vous pourrez ajouter des opérations après la création.' }}
    </span>

    {% include 'layout/modern/components/_btns.html.twig' with {
        btns: [
            {
                label: isEdit ? 'Enregistrer' : 'Créer le portefeuille',
                type: 'submit',
                icon: isEdit ? 'mdi:content-save-outline' : 'ic:round-add',
                color: 'primary'
            }
        ]
    } %}
</div>

{{ form_end(form) }}
