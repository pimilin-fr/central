{% extends 'modern.html.twig' %}

{% block title %}Portefeuilles{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="toolbar">
                    {% include 'layout/modern/components/_search.html.twig' with {
                        target: '#portefeuilles-list',
                        placeholder: 'Rechercher un portefeuille...',
                        aria_label: 'Rechercher un portefeuille',
                        empty: '#portefeuilles-search-empty',
                        count: '#portefeuilles-visible-count'
                    } %}

                    <div class="toolbar-info">
                        <span class="toolbar-dot"></span>
                        <span><strong id="portefeuilles-visible-count">{{ items|length }}</strong> portefeuilles</span>
                    </div>
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Tous les relevés',
                        path: path('app_releve_all'),
                        icon: 'lucide:list-ordered',
                        color: 'neutral'
                    },
                    {
                        label: 'Ajouter',
                        path: path('app_portefeuille_new'),
                        icon: 'gridicons:add',
                        color: 'primary'
                    }
                ]
            } %}
        </div>

        <section class="entity-list">
            {% include 'portefeuille/show/_table.html.twig' %}
        </section>
    </div>
{% endblock %}
