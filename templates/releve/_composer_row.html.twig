{#
    Une opération (liste « À pointer », ou « partie » d'une ligne du relevé).
    L'affichage dépend du conteneur (CSS) ; l'en-tête des lignes est construit par le JS.
    Paramètres : op (Depenses), inList (bool : dans une ligne du relevé)
#}
{% set signed = op.categorie.isDepense ? -(op.montant * 1) : (op.montant * 1) %}
<li class="rc-op tile" data-rc-op {{ inList ? '' : 'draggable="true"' }}
    data-id="{{ op.id }}"
    data-date="{{ op.date|date('Y-m-d') }}"
    data-date-fr="{{ op.date|date('d/m/Y') }}"
    data-amount="{{ signed }}"
    data-tiers="{{ op.tiers.id }}"
    data-tiers-name="{{ op.tiers.name }}"
    data-category="{{ op.categorie.name }}"
    data-search="{{ (op.tiers.name ~ ' ' ~ op.categorie.name ~ ' ' ~ (op.numCommande ?? '') ~ ' ' ~ (op.note ?? '') ~ ' ' ~ op.date|date('d/m/Y') ~ ' ' ~ signed)|lower|e('html_attr') }}">
    <label class="rc-pick rc-only-pool" title="Cocher pour ajouter plusieurs opérations ensemble (un détail)"><input type="checkbox" data-rc-check></label>
    <span class="rc-grip rc-only-pool" aria-hidden="true">⋮⋮</span>
    <span class="rc-date">{{ op.date|date('d/m/Y') }}</span>
    <span class="rc-main">
        <strong>{{ op.tiers.name }}</strong>
        <small>{{ op.categorie.name }}{% if op.numCommande %} · n° {{ op.numCommande }}{% endif %}{% if op.note %} · {{ op.note|slice(0, 40) }}{% endif %}</small>
    </span>
    <button type="button" class="pill rc-only-pool" data-rc-siblings hidden></button>
    <span class="rc-amount {{ signed < 0 ? 'amount-expense' : 'amount-income' }}">{{ signed < 0 ? '−' : '+' }} {{ signed|abs|number_format(2, ',', ' ') }} €</span>
    <span class="rc-tools">
        <button type="button" class="btn btn-icon btn-primary rc-add rc-only-pool" data-rc-add title="Ajouter au relevé" aria-label="Ajouter au relevé">＋</button>
        <button type="button" class="btn btn-icon rc-only-part" data-rc-detach title="Sortir du détail (devient une ligne à part)" aria-label="Sortir du détail">✂</button>
        <button type="button" class="btn btn-icon rc-only-part" data-rc-remove-part title="Retirer du relevé" aria-label="Retirer du relevé">✕</button>
    </span>
    <input type="hidden" value="{{ op.id }}" data-rc-input {{ inList ? '' : 'disabled' }}>
</li>
