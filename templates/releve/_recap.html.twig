{# Repères du relevé : relevé précédent (mouvement) et solde cumulé avant. Paramètres : previous (résumé ou null), cumulBefore #}
<div class="rc-recap card-bar{{ inline|default(false) ? ' is-inline' : '' }}" aria-label="Relevé précédent">
    {% if previous %}
        <div class="rc-recap-item">
            <span class="rc-recap-label">Relevé précédent</span>
            <strong>
                <a href="{{ path('app_releve_compose', { id: previous.releve.portefeuille.id, releve: previous.releve.id }) }}">{{ previous.releve.date|date('d/m/Y') }}</a>
                {% if previous.releve.closed %}<span class="ops-group-badge is-closed">Clos</span>{% else %}<span class="ops-group-badge is-open">Non clos</span>{% endif %}
            </strong>
        </div>
        <div class="rc-recap-item">
            <span class="rc-recap-label">Montant du précédent <small>(mouvement)</small></span>
            <strong class="{{ previous.total < 0 ? 'amount-expense' : 'amount-income' }}">{{ previous.total < 0 ? '−' : '+' }} {{ previous.total|abs|number_format(2, ',', ' ') }} €</strong>
        </div>
        <div class="rc-recap-item">
            <span class="rc-recap-label">Solde cumulé avant ce relevé</span>
            <strong>{{ cumulBefore|number_format(2, ',', ' ') }} €</strong>
        </div>
    {% else %}
        <div class="rc-recap-item"><span class="rc-recap-label">Relevé précédent</span><strong>Aucun : premier relevé de ce portefeuille</strong></div>
    {% endif %}
</div>
