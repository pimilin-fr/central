{# Une ligne du relevé de compte = une ou plusieurs opérations (détail). L'en-tête est construit par le JS. Paramètre : line (liste de Depenses) #}
<li class="rc-line" data-rc-line draggable="true">
    <div class="rc-line-head" data-rc-head></div>
    <ul class="rc-parts" data-rc-parts>
        {% for op in line %}
            {% include 'releve/_composer_row.html.twig' with { op: op, inList: true } only %}
        {% endfor %}
    </ul>
</li>
