{#
    Mini formulaire « Nouvelle opération » (ex. frais bancaires, opération absente de la base).
    Seuls date, montant, catégorie et tiers sont visibles ; le portefeuille est celui de l'écran (non affiché).
    Les autres champs existent mais restent repliés. Formulaire séparé (hors du formulaire du relevé).
    Paramètres : portefeuille, releve, token
#}
<dialog class="rc-dialog" data-rc-dialog aria-labelledby="rc-dialog-title">
    <form method="post" class="modern-form rc-op-form" data-rc-op-form
          action="{{ path('app_releve_add_operation', { id: portefeuille.id }) }}"
          data-default-date="{{ releve.date|date('Y-m-d') }}">
        <input type="hidden" name="_token" value="{{ csrf_token(token) }}">

        <header class="rc-dialog-head">
            <h2 id="rc-dialog-title">Nouvelle opération</h2>
            <span class="rc-dialog-ptf">{{ portefeuille.libelle }}</span>
        </header>

        <div class="rc-dialog-grid">
            <label class="rc-field">
                <span class="modern-form-label">Date</span>
                <input type="date" name="op[date]" class="modern-form-control" required value="{{ releve.date|date('Y-m-d') }}">
            </label>
            <label class="rc-field">
                <span class="modern-form-label">Montant <small>(négatif = remboursement)</small></span>
                <input type="text" inputmode="decimal" name="op[montant]" class="modern-form-control" required placeholder="0,00" autocomplete="off">
            </label>
            <label class="rc-field">
                <span class="modern-form-label">Catégorie</span>
                <input type="text" name="op[categorie]" class="modern-form-control autocomplete" data-endpoint="/categories/search" autocomplete="off" required>
                <input type="hidden" name="op[categorie_id]">
            </label>
            <label class="rc-field">
                <span class="modern-form-label">Tiers</span>
                <input type="text" name="op[tiers]" class="modern-form-control autocomplete" data-endpoint="/tiers/search" autocomplete="off" required>
                <input type="hidden" name="op[tiers_id]">
            </label>
        </div>

        <details class="rc-more">
            <summary>Plus de champs <small>(projet, adresse, n° de commande, note)</small></summary>
            <div class="rc-dialog-grid">
                <label class="rc-field">
                    <span class="modern-form-label">Projet</span>
                    <input type="text" name="op[projet]" class="modern-form-control autocomplete" data-endpoint="/projet/search" autocomplete="off">
                    <input type="hidden" name="op[projet_id]">
                </label>
                <label class="rc-field">
                    <span class="modern-form-label">Adresse <small>(après le choix du tiers)</small></span>
                    <select name="op[adresse]" class="modern-form-control"><option value="">Adresse</option></select>
                    <input type="hidden" name="op[adresse_id]">
                </label>
                <label class="rc-field">
                    <span class="modern-form-label">N° de commande</span>
                    <input type="text" name="op[numCommande]" class="modern-form-control" maxlength="255">
                </label>
                <label class="rc-field rc-field-grow">
                    <span class="modern-form-label">Note</span>
                    <textarea name="op[note]" class="modern-form-control" rows="2"></textarea>
                </label>
            </div>
        </details>

        <p class="rc-msg" data-rc-op-error role="alert" hidden></p>

        <footer class="rc-dialog-foot">
            <label class="rc-check"><input type="checkbox" data-rc-op-direct checked> Ajouter directement au relevé</label>
            <span class="rc-dialog-actions">
                <button type="button" class="page-action page-action-neutral" data-rc-op-cancel>Annuler</button>
                <button type="submit" class="page-action page-action-primary" data-rc-op-submit><twig:ux:icon name="lucide:plus" /><span>Créer</span></button>
            </span>
        </footer>
    </form>
</dialog>
