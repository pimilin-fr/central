{% extends 'modern.html.twig' %}

{% set closed = releve.closed %}
{% set isNew = releve.id is null %}
{% set previous = history.previous %}
{% set cumulBefore = history.cumulBefore %}

{# Fil d'Ariane : Central > Portefeuilles > [portefeuille] > Relevés > Relevé du [date] #}
{% set breadcrumb_current = isNew ? 'Nouveau relevé' : 'Relevé du ' ~ releve.date|date('d/m/Y') %}
{% set breadcrumb_trail = [
    { label: portefeuille.libelle, path: path('app_portefeuille_show', { id: portefeuille.id }) },
    { label: 'Relevés', path: path('app_releve_index', { id: portefeuille.id }) }
] %}

{% block title %}Relevé — {{ portefeuille.libelle }}{% endblock %}

{% block body %}
    <div class="page-container rc-page">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Faire le relevé</h1>
                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ (portefeuille.couleur ?? null)|entity_color }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ portefeuille.libelle }}</span>
                    </span>
                    {% if closed %}
                        <span class="ops-group-badge is-closed"><twig:ux:icon name="lucide:lock" /> Clos le {{ releve.closedAt|date('d/m/Y') }}</span>
                    {% elseif not isNew %}
                        <span class="ops-group-badge is-draft"><twig:ux:icon name="lucide:pencil-line" /> En cours</span>
                    {% endif %}
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [{
                    label: 'Retour',
                    path: path('app_releve_index', { id: portefeuille.id }),
                    icon: 'mdi:arrow-left',
                    color: 'neutral'
                }]
            } %}
        </div>

        {% if foreign > 0 %}
            <p class="rc-msg" role="alert">
                {{ foreign }} opération{{ foreign > 1 ? 's' : '' }} rattachée{{ foreign > 1 ? 's' : '' }} à ce relevé appartien{{ foreign > 1 ? 'nent' : 't' }} à un autre portefeuille : elle{{ foreign > 1 ? 's sont' : ' est' }} ignorée{{ foreign > 1 ? 's' : '' }} ici.
                Corrigez avec <code>php bin/console app:releve:verifier</code> (lecture seule par défaut).
            </p>
        {% endif %}

        {% if closed %}
            {% include 'releve/_recap.html.twig' with { previous: previous, cumulBefore: cumulBefore } only %}
            {# ---------- RELEVÉ FINALISÉ : lecture seule, tel le relevé de compte ---------- #}
            <section class="rc-panel card">
                <header class="block-head">
                    <h2>Relevé du {{ releve.date|date('d/m/Y') }}</h2>
                    <form method="post" action="{{ path('app_releve_reopen', { id: releve.id }) }}"
                          onsubmit="return confirm('Rouvrir ce relevé pour corriger l\'ordre des opérations ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                        <button type="submit" class="btn btn-neutral"><twig:ux:icon name="lucide:lock-open" /><span>Rouvrir</span></button>
                    </form>
                </header>
                <ol class="rc-list is-readonly">
                    {% set run = cumulBefore %}
                    {% for line in lines %}
                        {% set total = 0 %}
                        {% for op in line %}
                            {% set total = total + (op.categorie.isDepense ? -(op.montant * 1) : (op.montant * 1)) %}
                        {% endfor %}
                        {% set run = run + total %}
                        {% set names = [] %}
                        {% for op in line %}{% if op.tiers.name not in names %}{% set names = names|merge([op.tiers.name]) %}{% endif %}{% endfor %}
                        <li class="rc-line is-readonly tile" {{ names|length > 1 ? 'data-multi-tiers=1' : '' }}>
                            <div class="rc-line-head">
                                <span class="rc-rank">{{ line[0].releveOrdre ?? loop.index }}</span>
                                <span class="rc-date">{{ line[0].date|date('d/m/Y') }}</span>
                                <span class="rc-main"><strong>{{ names|join(' + ') }}</strong>{% if line|length == 1 %}<small>{{ line[0].categorie.name }}</small>{% endif %}</span>
                                {% if line|length > 1 %}<span class="pill pill-accent">Détail × {{ line|length }}</span>{% endif %}
                                <span class="rc-amount {{ total < 0 ? 'amount-expense' : 'amount-income' }}">{{ total < 0 ? '−' : '+' }} {{ total|abs|number_format(2, ',', ' ') }} €</span>
                                <span class="rc-balance is-visible">{{ run|number_format(2, ',', ' ') }} €</span>
                            </div>
                            {% if line|length > 1 %}
                                <ul class="rc-parts is-open">
                                    {% for op in line %}
                                        {% set signed = op.categorie.isDepense ? -(op.montant * 1) : (op.montant * 1) %}
                                        <li class="rc-op tile"><span class="rc-main">{% if names|length > 1 %}<strong>{{ op.tiers.name }}</strong>{% endif %}<small>{{ op.categorie.name }}</small></span><span class="rc-amount {{ signed < 0 ? 'amount-expense' : 'amount-income' }}">{{ signed < 0 ? '−' : '+' }} {{ signed|abs|number_format(2, ',', ' ') }} €</span></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
                {% set movement = run - cumulBefore %}
                <footer class="rc-total rc-total-multi">
                    <span>Solde du relevé <small>(mouvement)</small></span>
                    <strong class="{{ movement < 0 ? 'amount-expense' : 'amount-income' }}">{{ movement|number_format(2, ',', ' ') }} €</strong>
                    <span>Solde cumulé</span>
                    <strong>{{ run|number_format(2, ',', ' ') }} €</strong>
                </footer>
            </section>
        {% else %}
            {# ---------- COMPOSITION ---------- #}
            <form method="post" action="{{ path('app_releve_save', { id: portefeuille.id }) }}"
                  class="rc" data-releve-composer data-rc-ptf="{{ portefeuille.id }}" data-rc-cumul-before="{{ cumulBefore }}" {{ isNew ? 'data-rc-new' : '' }}>
                <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                <input type="hidden" name="releve" value="{{ releve.id }}">

                {# Bandeau compact : date, solde avant, relevé précédent, autres brouillons, aide #}
                <section class="rc-panel rc-top card">
                    <label class="rc-field">
                        <span class="modern-form-label">Date du relevé</span>
                        <input type="date" name="date" class="modern-form-control" required value="{{ releve.date|date('Y-m-d') }}">
                    </label>
                    <label class="rc-field">
                        <span class="modern-form-label">Solde avant <small>({{ previous ? 'calculé, modifiable' : 'à saisir si besoin' }})</small></span>
                        <input type="number" step="0.01" class="modern-form-control" data-rc-start placeholder="{{ cumulBefore|number_format(2, '.', '') }}" inputmode="decimal">
                    </label>
                    {% include 'releve/_recap.html.twig' with { previous: previous, cumulBefore: cumulBefore, inline: true } only %}
                    {% if drafts|length > (isNew ? 0 : 1) %}
                        <p class="rc-drafts">
                            Autres relevés en cours :
                            {% for draft in drafts %}
                                {% if draft.id != releve.id %}
                                    <a href="{{ path('app_releve_compose', { id: portefeuille.id, releve: draft.id }) }}">{{ draft.date|date('d/m/Y') }}</a>{{ not loop.last ? ' · ' : '' }}
                                {% endif %}
                            {% endfor %}
                        </p>
                    {% endif %}
                    <details class="rc-helpbox">
                        <summary>Aide</summary>
                        <p class="rc-help">Cliquez sur ＋ dans l'ordre d'apparition sur le relevé de compte, ou glissez-déposez. Une commande éclatée en plusieurs catégories se pointe en <strong>un seul détail</strong> : cochez ses opérations (même date, tiers libres) puis « En un détail ». Quand vous cochez plusieurs éléments, leur montant cumulé s'affiche (Maj+clic pour cocher une plage).<br><strong>✓</strong> = ligne vérifiée sur votre relevé de compte : automatique quand vous ajoutez ou déplacez une ligne (pas quand vous regroupez) ; en cliquant ✓ à la main, les lignes au-dessus sont pointées aussi. <strong>⤒</strong> place une ligne juste après la dernière ligne pointée (en premier si aucune). Ce suivi n'est pas enregistré en base : il est gardé dans ce navigateur.</p>
                    </details>
                </section>

                <div class="rc-columns">
                    {# ---- RELEVÉ : l'élément principal (pleine hauteur, c'est la page qui défile) ---- #}
                    <section class="rc-panel rc-panel-main card">
                        <header class="block-head rc-sticky">
                            <h2>Relevé <span class="pill pill-solid" data-rc-count title="Lignes du relevé">0</span> <small data-rc-ops-count></small></h2>
                            <div class="rc-progress" data-rc-progress-box hidden>
                                <span class="rc-progress-text" data-rc-progress-text></span>
                                <span class="rc-bar" aria-hidden="true"><i data-rc-progress-bar></i></span>
                                <button type="button" class="btn-link" data-rc-done-all></button>
                                <button type="button" class="btn-link" data-rc-hide-done aria-pressed="false">Masquer les pointées</button>
                            </div>
                            <div class="rc-sorts" role="group" aria-label="Outils du relevé">
                                <button type="button" class="btn btn-icon" data-rc-sort="asc" title="Trier par date : du plus ancien au plus récent (ex. espèces)">↑</button>
                                <button type="button" class="btn btn-icon" data-rc-sort="desc" title="Trier par date : du plus récent au plus ancien">↓</button>
                            </div>
                            <div class="rc-selsum" data-rc-sel-lines hidden><span data-rc-sel-text></span><span class="rc-selsum-actions"><button type="button" class="btn btn-primary" data-rc-merge title="Regrouper les lignes cochées en un seul détail (même date, tiers libres)"><twig:ux:icon name="lucide:layers" /><span>Regrouper</span></button><button type="button" class="btn-link" data-rc-sel-clear>Désélectionner</button></span></div>
                            <p class="rc-msg" data-rc-msg role="status" hidden></p>
                        </header>
                        <ol class="rc-list is-selected" data-rc-list>
                            {% for line in lines %}
                                {% include 'releve/_composer_line.html.twig' with { line: line } only %}
                            {% endfor %}
                        </ol>
                        <p class="rc-empty" data-rc-empty hidden>Aucune opération pour l'instant : choisissez-les dans « À pointer ».</p>
                    </section>

                    {# ---- À POINTER : colonne latérale qui reste en vue ---- #}
                    <aside class="rc-panel rc-pool-panel card">
                        <header class="block-head">
                            <h2>À pointer <span class="pill pill-solid" data-rc-pool-count>{{ pool|length }}</span></h2>
                            <div class="rc-pool-actions">
                                <button type="button" class="btn btn-neutral" data-rc-add-group title="Ajoute les opérations cochées comme UN SEUL détail (même date, tiers libres)"><twig:ux:icon name="lucide:layers" /><span>En un détail</span></button>
                                <button type="button" class="btn btn-neutral" data-rc-add-all title="Ajouter toutes les opérations affichées, une ligne chacune, par date"><twig:ux:icon name="lucide:list-plus" /><span>Tout ajouter</span></button>
                                <button type="button" class="btn btn-neutral" data-rc-open-op title="Créer une opération qui n'existe pas encore (ex. frais bancaires)"><twig:ux:icon name="lucide:plus" /><span>Nouvelle</span></button>
                            </div>
                        </header>
                        {% include 'releve/_operation_panel.html.twig' with { portefeuille: portefeuille, releve: releve, token: token } only %}
                        <div class="rc-selsum" data-rc-sel-pool hidden><span data-rc-sel-text></span><span class="rc-selsum-actions"><button type="button" class="btn btn-primary" data-rc-add-group title="Ajoute les opérations cochées comme UN SEUL détail (même date, tiers libres)"><twig:ux:icon name="lucide:layers" /><span>En un détail</span></button><button type="button" class="btn-link" data-rc-sel-clear>Désélectionner</button></span></div>
                        <input type="search" class="modern-form-control rc-filter" placeholder="Filtrer (tiers, catégorie, montant, date…)" data-rc-filter>
                        <ul class="rc-list is-pool" data-rc-pool>
                            {% for op in pool %}
                                {% include 'releve/_composer_row.html.twig' with { op: op, inList: false } only %}
                            {% endfor %}
                        </ul>
                        <p class="rc-empty" data-rc-pool-empty hidden>Plus aucune opération à pointer.</p>
                    </aside>
                </div>

                {# Barre fixe en bas : soldes + actions, toujours visibles même avec 60 lignes #}
                <div class="rc-actions card-bar">
                    <div class="rc-sums">
                        <span>Mouvement <strong data-rc-total>0,00 €</strong></span>
                        <span>Solde cumulé <strong data-rc-cumul>0,00 €</strong></span>
                    </div>
                    <span class="rc-actions-buttons">
                        <button type="submit" name="action" value="save" class="btn btn-neutral" data-rc-submit>
                            <twig:ux:icon name="lucide:save" /><span>Enregistrer</span>
                        </button>
                        <button type="submit" name="action" value="finalize" class="btn btn-primary" data-rc-submit data-rc-finalize
                                data-confirm="Finaliser ce relevé ? L'ordre des opérations sera figé (vous pourrez le rouvrir au besoin).">
                            <twig:ux:icon name="lucide:lock" /><span>Finaliser</span>
                        </button>
                    </span>
                </div>
            </form>

            {# Prévisions de ce portefeuille : « Ajouter au relevé » crée l'opération et la place dans les lignes #}
            {{ render(controller('App\\Controller\\PrevisionController::prochaines', { id: portefeuille.id, mode: 'releve' })) }}

        {% endif %}
    </div>
{% endblock %}
