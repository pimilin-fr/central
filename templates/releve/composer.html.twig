{% extends 'modern.html.twig' %}

{% set closed = releve.closed %}
{% set isNew = releve.id is null %}

{% block title %}Relevé — {{ portefeuille.libelle }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Faire le relevé</h1>
                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ (portefeuille.couleur ?? null)|entity_color }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ portefeuille.libelle }}</span>
                    </span>
                    {% if closed %}
                        <span class="ops-group-badge is-closed"><twig:ux:icon name="lucide:lock" /> Finalisé le {{ releve.closedAt|date('d/m/Y') }}</span>
                    {% elseif not isNew %}
                        <span class="ops-group-badge is-draft"><twig:ux:icon name="lucide:pencil-line" /> En cours</span>
                    {% endif %}
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [{
                    label: 'Retour',
                    path: path('app_portefeuille_show', { id: portefeuille.id, groupBy: 'releve' }),
                    icon: 'mdi:arrow-left',
                    color: 'neutral'
                }]
            } %}
        </div>

        {% if closed %}
            {# ---------- RELEVÉ FINALISÉ : lecture seule, tel le relevé de compte ---------- #}
            <section class="rc-panel">
                <header class="rc-panel-head">
                    <h2>Relevé du {{ releve.date|date('d/m/Y') }}{% if releve.label and releve.label != 'Relevé du ' ~ releve.date|date('d/m/Y') %} <small>— {{ releve.label }}</small>{% endif %}</h2>
                    <form method="post" action="{{ path('app_releve_reopen', { id: releve.id }) }}"
                          onsubmit="return confirm('Rouvrir ce relevé pour corriger l\'ordre des opérations ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                        <button type="submit" class="page-action page-action-neutral"><twig:ux:icon name="lucide:lock-open" /><span>Rouvrir</span></button>
                    </form>
                </header>
                <ol class="rc-list is-readonly">
                    {% set run = 0 %}
                    {% for op in selected %}
                        {% set signed = op.categorie.isDepense ? -(op.montant * 1) : (op.montant * 1) %}
                        {% set run = run + signed %}
                        <li class="rc-op">
                            <span class="rc-rank">{{ op.releveOrdre ?? loop.index }}</span>
                            <span class="rc-date">{{ op.date|date('d/m/Y') }}</span>
                            <span class="rc-main"><strong>{{ op.tiers.name }}</strong><small>{{ op.categorie.name }}</small></span>
                            <span class="rc-amount {{ signed < 0 ? 'amount-expense' : 'amount-income' }}">{{ signed < 0 ? '−' : '+' }} {{ signed|abs|number_format(2, ',', ' ') }} €</span>
                            <span class="rc-balance is-visible">{{ run|number_format(2, ',', ' ') }} €</span>
                        </li>
                    {% endfor %}
                </ol>
            </section>
        {% else %}
            {# ---------- COMPOSITION ---------- #}
            <form method="post" action="{{ path('app_releve_save', { id: portefeuille.id }) }}"
                  class="rc" data-releve-composer {{ isNew ? 'data-rc-new' : '' }}>
                <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                <input type="hidden" name="releve" value="{{ releve.id }}">

                <section class="rc-panel rc-meta">
                    <label class="rc-field">
                        <span class="modern-form-label">Date du relevé</span>
                        <input type="date" name="date" class="modern-form-control" required value="{{ releve.date|date('Y-m-d') }}">
                    </label>
                    <label class="rc-field rc-field-grow">
                        <span class="modern-form-label">Libellé <small>(facultatif)</small></span>
                        <input type="text" name="label" class="modern-form-control" maxlength="255" value="{{ releve.label ?? '' }}">
                    </label>
                    <label class="rc-field">
                        <span class="modern-form-label">Solde de départ <small>(pour vérifier)</small></span>
                        <input type="number" step="0.01" class="modern-form-control" data-rc-start placeholder="0,00" inputmode="decimal">
                    </label>
                </section>

                {% if drafts|length > (isNew ? 0 : 1) %}
                    <p class="rc-drafts">
                        Autres relevés en cours :
                        {% for draft in drafts %}
                            {% if draft.id != releve.id %}
                                <a href="{{ path('app_releve_compose', { id: portefeuille.id, releve: draft.id }) }}">{{ draft.date|date('d/m/Y') }}</a>{{ not loop.last ? ' · ' : '' }}
                            {% endif %}
                        {% endfor %}
                    </p>
                {% endif %}

                <div class="rc-columns">
                    {# ---- À POINTER ---- #}
                    <section class="rc-panel">
                        <header class="rc-panel-head">
                            <h2>À pointer <span class="rc-count" data-rc-pool-count>{{ pool|length }}</span></h2>
                            <button type="button" class="page-action page-action-neutral" data-rc-add-all title="Ajouter toutes les opérations affichées, par date"><twig:ux:icon name="lucide:list-plus" /><span>Tout ajouter</span></button>
                        </header>
                        <input type="search" class="modern-form-control rc-filter" placeholder="Filtrer (tiers, catégorie, montant, date…)" data-rc-filter>
                        <ul class="rc-list is-pool" data-rc-pool>
                            {% for op in pool %}
                                {% include 'releve/_composer_row.html.twig' with { op: op, inList: false } only %}
                            {% endfor %}
                        </ul>
                        <p class="rc-empty" data-rc-pool-empty hidden>Plus aucune opération à pointer.</p>
                    </section>

                    {# ---- RELEVÉ ---- #}
                    <section class="rc-panel rc-panel-main">
                        <header class="rc-panel-head">
                            <h2>Relevé <span class="rc-count" data-rc-count>0</span></h2>
                            <div class="rc-sorts" role="group" aria-label="Trier automatiquement">
                                <span class="group-bar-label">Trier par date</span>
                                <button type="button" class="rc-btn" data-rc-sort="asc" title="Du plus ancien au plus récent (ex. espèces)">↑</button>
                                <button type="button" class="rc-btn" data-rc-sort="desc" title="Du plus récent au plus ancien">↓</button>
                            </div>
                        </header>
                        <p class="rc-help">Cliquez sur ＋ dans l'ordre d'apparition sur le relevé de compte, ou glissez-déposez. <strong>⤓</strong> place les prochaines opérations après une ligne donnée (pour reprendre un relevé en cours).</p>
                        <ol class="rc-list is-selected" data-rc-list>
                            {% for op in selected %}
                                {% include 'releve/_composer_row.html.twig' with { op: op, inList: true } only %}
                            {% endfor %}
                        </ol>
                        <p class="rc-empty" data-rc-empty hidden>Aucune opération pour l'instant : choisissez-les à gauche.</p>
                        <footer class="rc-total">
                            <span>Solde du relevé</span>
                            <strong data-rc-total>0,00 €</strong>
                        </footer>
                    </section>
                </div>

                <div class="rc-actions">
                    <button type="submit" name="action" value="save" class="page-action page-action-neutral" data-rc-submit>
                        <twig:ux:icon name="lucide:save" /><span>Enregistrer (reste en cours)</span>
                    </button>
                    <button type="submit" name="action" value="finalize" class="page-action page-action-primary" data-rc-submit data-rc-finalize
                            data-confirm="Finaliser ce relevé ? L'ordre des opérations sera figé (vous pourrez le rouvrir au besoin).">
                        <twig:ux:icon name="lucide:lock" /><span>Finaliser le relevé</span>
                    </button>
                </div>
            </form>
        {% endif %}
    </div>
{% endblock %}
