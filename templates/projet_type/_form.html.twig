{#
    Formulaire type de projet — frise + aperçu (carte réelle).
    L'action conserve la logique historique (variable `tiers` si définie).
#}
{% set formAction = path('app_projet_type_new') %}
{% if tiers is defined %}
    {% set formAction = path('app_projet_type_edit', { id: tiers.id }) %}
{% endif %}
{% set isEdit = form.vars.value.id is not null %}

{{ form_start(form, {
    action: formAction,
    attr: { class: 'modern-form', 'data-live-form': '' }
}) }}

<div class="form-layout" data-live-scope>

    <div class="form-timeline">

        <div class="form-field-card card-inset">
            <div class="form-field-heading">
                <span class="form-field-index">01</span>
                <h3>Identité</h3>
            </div>
            <div class="form-row" style="--cols: minmax(0, 1fr) minmax(0, 1fr)">
                <div>
                    {{ form_label(form.name, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.name, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.name) }}
                </div>
                <div>
                    {{ form_label(form.libelle, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.libelle, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.libelle) }}
                </div>
            </div>
        </div>

        <div class="form-field-card card-inset">
            <div class="form-field-heading">
                <span class="form-field-index">02</span>
                <h3>Hiérarchie</h3>
            </div>
            <div class="form-row" style="--cols: minmax(0, 1fr)">
                <div>
                    {{ form_label(form.parent, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.parent, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.parent) }}
                    <p class="form-hint">Laisser vide pour créer un type racine.</p>
                </div>
            </div>
        </div>
    </div>

    <aside class="form-layout-aside">
        {% include 'layout/modern/components/_form_preview.html.twig' with {
            icon: 'lucide:folder-kanban',
            ribbon: 'name',
            title: 'libelle',
            placeholder: 'Libellé du type',
            sub: 'parent',
            lines: [
                { icon: 'lucide:folder-tree', label: 'Parent', live: 'parent', empty: 'Racine' }
            ]
        } only %}
    </aside>
</div>

<div class="modern-form-footer">
    <span class="modern-form-footer-copy">
        <span class="required-legend">Champ obligatoire</span>
    </span>

    {% include 'layout/modern/components/_btns.html.twig' with {
        btns: [{
            label: isEdit ? 'Enregistrer' : 'Créer le type',
            type: 'submit',
            icon: isEdit ? 'mdi:content-save-outline' : 'ic:round-add',
            color: 'primary'
        }]
    } %}
</div>

{{ form_end(form) }}
