{{ form_start(form, { attr: { class: 'space-y-6' } }) }}

{# =========================
   CHAMPS
   ========================= #}
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    {# Nom #}
    <div>
        {{ form_label(form.name, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.name, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.name) }}
    </div>

    {# Parent #}
    <div>
        {{ form_label(form.parent, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.parent, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.parent) }}
    </div>
    {# Libellé #}
    <div>
        {{ form_label(form.libelle, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.libelle, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.libelle) }}
    </div>

</div>

{# =========================
   ACTIONS
   ========================= #}
<div class="flex justify-end gap-3 pt-4">
    <button type="submit"
            class="inline-flex items-center gap-2 px-4 py-2
                   text-sm font-medium rounded-lg
                   bg-orange-500 hover:bg-orange-600 text-white transition">
        {{ ux_icon('mdi:content-save-outline', { class: 'w-4 h-4' }) }}
        Enregistrer
    </button>
</div>

{{ form_end(form) }}
