{% extends 'modern.html.twig' %}

{% set breadcrumb_current = 'Types de projet' %}

{% block title %}Types de projet{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="toolbar">
                    {% include 'layout/modern/components/_search.html.twig' with {
                        target: '#projet-type-list',
                        placeholder: 'Rechercher un type de projet...',
                        aria_label: 'Rechercher un type de projet',
                        empty: '#projet-type-search-empty',
                        count: '#projet-type-visible-count'
                    } %}

                    <div class="toolbar-info">
                        <span class="toolbar-dot"></span>
                        <span><strong id="projet-type-visible-count">0</strong> types</span>
                    </div>
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Projets',
                        path: path('app_projet_index'),
                        icon: 'ix:project',
                        color: 'info'
                    },
                    {
                        label: 'Ajouter',
                        path: path('app_projet_type_new'),
                        icon: 'gridicons:add',
                        color: 'primary'
                    }
                ]
            } %}
        </div>

        <section class="entity-list">
            {% include 'projet_type/_table.html.twig' %}
        </section>
    </div>
{% endblock %}
