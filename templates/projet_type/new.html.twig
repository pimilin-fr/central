{% extends 'modern.html.twig' %}

{% set breadcrumb_trail = [{ label: 'Types de projet', path: path('app_projet_type_index') }] %}
{% set breadcrumb_current = 'Nouveau' %}

{% block title %}Nouveau type de projet{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Nouveau type de projet</h1>
                <p class="page-subtitle">Nommez le type et rattachez-le éventuellement à un type parent.</p>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [{
                    label: 'Retour',
                    path: path('app_projet_type_index'),
                    icon: 'mdi:arrow-left',
                    color: 'neutral'
                }]
            } %}
        </div>

        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: [{
                id: 'summary',
                label: 'Informations',
                icon: 'lucide:folder-tree',
                content: include('projet_type/_form.html.twig')
            }],
            activeTab: 'summary'
        } %}
    </div>
{% endblock %}
