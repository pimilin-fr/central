{% extends 'modern.html.twig' %}

{# Fil d'Ariane : Projets / Types de projet / ancêtres… / libellé #}
{% set trail = [{ label: 'Types de projet', path: path('app_projet_type_index') }] %}
{% set ancestors = [] %}
{% set ancestor = type.parent %}
{% for i in 1..50 %}
    {% if ancestor %}
        {% set ancestors = [{ label: ancestor.libelle, path: path('app_projet_type_show', { id: ancestor.id }) }]|merge(ancestors) %}
        {% set ancestor = ancestor.parent %}
    {% endif %}
{% endfor %}
{% set breadcrumb_trail = trail|merge(ancestors) %}
{% set breadcrumb_current = type.libelle %}

{% block title %}Type de projet - {{ type.libelle }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">{{ type.libelle }}</h1>

                {% if type.parent %}
                    <div class="page-subline">
                        <span class="entity-pill">
                            <span class="entity-pill-dot"></span>
                            <span>{{ type.parent.libelle }}</span>
                        </span>
                    </div>
                {% endif %}
            </div>

            {% set btns = [{
                label: 'Retour',
                path: path('app_projet_type_index'),
                icon: 'mdi:arrow-left',
                color: 'neutral'
            }] %}
            {% if type.parent %}
                {% set btns = btns|merge([{
                    label: 'Parent',
                    path: path('app_projet_type_show', { id: type.parent.id }),
                    icon: 'icon-park-solid:up-c',
                    color: 'primary'
                }]) %}
            {% endif %}

            {% include 'layout/modern/components/_btns.html.twig' with { btns: btns } %}
        </div>

        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}
        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: [
                {
                    id: 'summary',
                    label: 'Résumé',
                    icon: 'ooui:info-filled',
                    content: include('projet_type/_resume.html.twig')
                },
                {
                    id: 'childs',
                    label: 'Enfants',
                    icon: 'lucide:folder-tree',
                    badge: type.children|length,
                    content: include('projet_type/_table.html.twig', { types: type.children })
                },
                {
                    id: 'projets',
                    label: 'Projets',
                    icon: 'ix:project',
                    badge: projets|length,
                    content: include('projet/_table.html.twig', { projets: projets })
                },
                {
                    id: 'edit',
                    label: 'Modifier',
                    icon: 'mingcute:edit-2-fill',
                    content: include('projet_type/_form.html.twig')
                }
            ],
            activeTab: activeTab
        } %}
    </div>
{% endblock %}
