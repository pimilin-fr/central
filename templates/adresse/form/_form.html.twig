{#
    Formulaire adresse — frise verticale (3 étapes) + aperçu en direct.
    - champs requis : astérisque automatique (label.required, forms.css)
    - type : <select data-entity-select> ; la couleur vient des data-color
      posées par choice_attr (aucun style généré côté PHP)
    - aperçu : app.js liveForm (form[data-live-form], [data-live], [data-live-color])
#}
{% set isEdit = adresse.id is not null %}
{% set formAction = isEdit
    ? path('app_adresse_edit', { id: adresse.id })
    : path('app_adresse_new') %}

{{ form_start(form, {
    action: formAction,
    attr: { class: 'modern-form', 'data-live-form': '' }
}) }}

<div class="form-layout" data-live-scope>

    <div class="form-timeline">

        {# 01 — Identité #}
        <div class="form-field-card">
            <div class="form-field-heading">
                <span class="form-field-index">01</span>
                <h3>Identité</h3>
            </div>
            <div class="form-grid-3">
                <div>
                    {{ form_label(form.adresseType, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.adresseType, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.adresseType) }}
                </div>
                <div class="form-span-2">
                    {{ form_label(form.name, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.name, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="form-span-3">
                    {{ form_label(form.adresseParent, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.adresseParent, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.adresseParent) }}
                </div>
            </div>
        </div>

        {# 02 — Adresse (voie + localité) #}
        <div class="form-field-card">
            <div class="form-field-heading">
                <span class="form-field-index">02</span>
                <h3>Adresse</h3>
            </div>
            <div class="form-stack">
                <div class="form-grid-5">
                    {% for field in [form.prefix, form.num, form.bisTer, form.typeVoie, form.nomVoie] %}
                        <div>
                            {{ form_label(field, null, { label_attr: { class: 'modern-form-label' } }) }}
                            {{ form_widget(field, { attr: { class: 'modern-form-control' } }) }}
                            {{ form_errors(field) }}
                        </div>
                    {% endfor %}
                </div>
                <div class="form-grid-4">
                    {% for field in [form.codePostal, form.ville, form.cedex, form.pays] %}
                        <div>
                            {{ form_label(field, null, { label_attr: { class: 'modern-form-label' } }) }}
                            {{ form_widget(field, { attr: { class: 'modern-form-control' } }) }}
                            {{ form_errors(field) }}
                        </div>
                    {% endfor %}
                </div>
                <div>
                    {{ form_label(form.adresse, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.adresse, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.adresse) }}
                </div>
            </div>
        </div>

        {# 03 — Géolocalisation #}
        <div class="form-field-card">
            <div class="form-field-heading">
                <span class="form-field-index">03</span>
                <h3>Géolocalisation</h3>
            </div>
            <div class="coords-field" data-coords-state>
                {{ form_label(form.adresseForcee, 'Coordonnées forcées (latitude, longitude)', { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.adresseForcee, { attr: {
                    class: 'modern-form-control',
                    'data-coords': '',
                    placeholder: '48.8566, 2.3522',
                    inputmode: 'text',
                    autocomplete: 'off'
                } }) }}
                <p class="form-hint" data-coords-hint>Laisser vide pour une géolocalisation automatique.</p>
                {{ form_errors(form.adresseForcee) }}
            </div>
        </div>
    </div>

    {# Aperçu en direct — mêmes composants entity-* que la liste #}
    <aside class="form-layout-aside">
        <h3 class="form-aside-title">Aperçu</h3>

        <article class="entity-card" data-live-color>
            <div class="entity-card-link">
                <div class="entity-circle"><twig:ux:icon name="lucide:map-pin" /></div>

                <div class="entity-ribbon">
                    <span class="entity-ribbon-label" data-live="city">···</span>
                </div>

                <div class="entity-body">
                    <div class="entity-head">
                        <h2 class="entity-title" data-live="name">Nom de l’adresse</h2>
                        <span class="entity-sub" data-live="type">Type non choisi</span>
                    </div>

                    <div class="sep sep-inset">
                        <span class="sep-dot"></span>
                        <span class="sep-line"></span>
                    </div>

                    <div class="entity-lines">
                        <div class="entity-line">
                            <span class="entity-line-icon"><twig:ux:icon name="lucide:map" /></span>
                            <span class="entity-line-body">
                                <span class="entity-line-label">Adresse</span>
                                <span class="entity-line-value is-wrap" data-live="address">—</span>
                            </span>
                        </div>
                        <div class="entity-line is-muted">
                            <span class="entity-line-icon"><twig:ux:icon name="lucide:crosshair" /></span>
                            <span class="entity-line-body">
                                <span class="entity-line-label">Coordonnées</span>
                                <span class="entity-line-value is-wrap" data-live="coords">Calculées automatiquement</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </aside>
</div>

<div class="modern-form-footer">
    <span class="modern-form-footer-copy">
        <span class="is-required"></span> Champ obligatoire —
        {{ isEdit ? 'les modifications s’appliquent immédiatement.' : 'la géolocalisation pourra être complétée ensuite.' }}
    </span>

    {% include 'layout/modern/components/_btns.html.twig' with {
        btns: [
            {
                label: isEdit ? 'Enregistrer' : 'Créer l’adresse',
                type: 'submit',
                icon: isEdit ? 'mdi:content-save-outline' : 'ic:round-add',
                color: 'primary'
            }
        ]
    } %}
</div>

{{ form_end(form) }}
