{#
    Formulaire adresse — frise verticale, sans aperçu.
    Localisation sur 3 lignes : préfixe/num/bis/type · voie · CP/ville/cedex/pays.
#}
{% set isEdit = adresse.id is not null %}
{% set formAction = isEdit
    ? path('app_adresse_edit', { id: adresse.id })
    : path('app_adresse_new') %}

{{ form_start(form, {
    action: formAction,
    attr: { class: 'modern-form' }
}) }}

<div class="form-layout is-single">

    <div class="form-timeline">

        {# 01 — Identité #}
        <div class="form-field-card">
            <div class="form-field-heading">
                <span class="form-field-index">01</span>
                <h3>Identité</h3>
            </div>

            <div class="form-row" style="--cols: minmax(160px, 1fr) minmax(0, 2fr)">
                <div>
                    {{ form_label(form.adresseType, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.adresseType, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.adresseType) }}
                </div>
                <div>
                    {{ form_label(form.name, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.name, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.name) }}
                </div>
            </div>

            <details class="form-more" {{ form.adresseParent.vars.value ? 'open' : '' }}>
                <summary>Rattacher à une adresse parente</summary>
                <div class="form-row" style="--cols: 1fr">
                    <div>
                        {{ form_label(form.adresseParent, null, { label_attr: { class: 'modern-form-label' } }) }}
                        {{ form_widget(form.adresseParent, { attr: { class: 'modern-form-control' } }) }}
                        {{ form_errors(form.adresseParent) }}
                    </div>
                </div>
            </details>
        </div>

        {# 02 — Localisation #}
        <div class="form-field-card">
            <div class="form-field-heading">
                <span class="form-field-index">02</span>
                <h3>Localisation</h3>
            </div>

            {# Ligne 1 : préfixe · numéro · bis/ter · type de voie #}
            <div class="form-row is-start" style="--cols: 110px 90px 100px 160px">
                {% for field in [form.prefix, form.num, form.bisTer, form.typeVoie] %}
                    <div>
                        {{ form_label(field, null, { label_attr: { class: 'modern-form-label' } }) }}
                        {{ form_widget(field, { attr: { class: 'modern-form-control' } }) }}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
            </div>

            {# Ligne 2 : la voie #}
            <div class="form-row" style="--cols: 1fr">
                <div>
                    {{ form_label(form.nomVoie, null, { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.nomVoie, { attr: { class: 'modern-form-control' } }) }}
                    {{ form_errors(form.nomVoie) }}
                </div>
            </div>

            {# Ligne 3 : code postal · ville · cedex · pays #}
            <div class="form-row" style="--cols: 110px minmax(0, 2fr) 110px minmax(0, 1.4fr)">
                {% for field in [form.codePostal, form.ville, form.cedex, form.pays] %}
                    <div>
                        {{ form_label(field, null, { label_attr: { class: 'modern-form-label' } }) }}
                        {{ form_widget(field, { attr: { class: 'modern-form-control' } }) }}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
            </div>
        </div>

        {# 03 — Adresse complète & position #}
        <div class="form-field-card">
            <div class="form-field-heading">
                <span class="form-field-index">03</span>
                <h3>Adresse complète &amp; position</h3>
            </div>

            <div>
                <div class="form-label-line">
                    {{ form_label(form.adresse, null, { label_attr: { class: 'modern-form-label' } }) }}
                </div>
                {{ form_widget(form.adresse, { attr: { class: 'modern-form-control', rows: 2 } }) }}
                {{ form_errors(form.adresse) }}
            </div>

            <details class="form-more" {{ form.adresseForcee.vars.value ? 'open' : '' }}>
                <summary>Forcer la géolocalisation</summary>
                <div class="coords-field" data-coords-state>
                    {{ form_label(form.adresseForcee, 'Coordonnées (latitude, longitude)', { label_attr: { class: 'modern-form-label' } }) }}
                    {{ form_widget(form.adresseForcee, { attr: {
                        class: 'modern-form-control',
                        'data-coords': '',
                        placeholder: '48.8566, 2.3522',
                        autocomplete: 'off'
                    } }) }}
                    <p class="form-hint" data-coords-hint>Laisser vide pour une géolocalisation automatique.</p>
                    {{ form_errors(form.adresseForcee) }}
                </div>
            </details>
        </div>
    </div>
</div>

<div class="modern-form-footer">
    <span class="modern-form-footer-copy">
        <span class="required-legend">Champ obligatoire</span>
    </span>

    {% include 'layout/modern/components/_btns.html.twig' with {
        btns: [
            {
                label: isEdit ? 'Enregistrer' : 'Créer l’adresse',
                type: 'submit',
                icon: isEdit ? 'mdi:content-save-outline' : 'ic:round-add',
                color: 'primary'
            }
        ]
    } %}
</div>

{{ form_end(form) }}
