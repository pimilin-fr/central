{# =========================================================
CONSTRUCTION DES TYPES D'ADRESSES
========================================================= #}

{% set types = [] %}

{% for adresse in adresses %}
{% if adresse.adresseType.id not in types|map(type => type.id) %}
{% set types = types|merge([adresse.adresseType]) %}
{% endif %}
{% endfor %}

{# =========================================================
ONGLETS
========================================================= #}

{% set activeTab = app.request.query.get('tab') ?? (
types|length > 0
? 'adresse-type-' ~ types[0].id
: null
) %}

{% set tabs = [] %}

{% for type in types %}


{% set typeAdresses = adresses|filter(adresse =>
    adresse.adresseType.id == type.id
) %}

{% set tabs = tabs|merge([{
    id: 'adresse-type-' ~ type.id,
    label: type.name,
    badge: typeAdresses|length,
    content: include('adresse/_children.html.twig', {
        adresses: typeAdresses
    })
}]) %}


{% endfor %}

{% if tabs|length > 0 %}


{% include 'partials/tabs.html.twig' with {
    tabs: tabs,
    activeTab: activeTab
} %}


{% else %}


<div class="text-center text-gray-500 py-12">

    {{ ux_icon('mdi:map-marker-off-outline', {
        class: 'w-10 h-10 mx-auto text-gray-300 mb-3'
    }) }}

    <p class="text-sm">
        Aucune adresse trouvée
    </p>

</div>


{% endif %}
