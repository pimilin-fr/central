{% extends 'modern.html.twig' %}

{% set breadcrumb_current = 'Nouvelle' %}

{% block title %}Nouvelle adresse{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Nouvelle adresse</h1>
                <p class="page-subtitle">Saisissez l'adresse complète : le détail, la position et le rattachement (quartier, ville…) sont proposés automatiquement.</p>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Retour',
                        path: path('app_adresse_index'),
                        icon: 'mdi:arrow-left',
                        color: 'neutral'
                    }
                ]
            } %}
        </div>

        {% include 'layout/modern/components/_tabs.html.twig' with {
            tabs: [{
                id: 'summary',
                label: 'Informations',
                icon: 'entypo:address',
                content: include('adresse/form/_form.html.twig')
            }],
            activeTab: 'summary'
        } %}
    </div>
{% endblock %}
