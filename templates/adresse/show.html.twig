{% extends 'base.html.twig' %}

{% block title %}Adresse{% endblock %}

{% block body %}
    <div class="space-y-6">
        {# =========================
            HEADER : Titre + actions (modernisé)
            ========================= #}
        {% set btns = [] %}
        {% if adresse.adresseParent %}
            {% set btns = btns|merge([
                {
                    label: "Parent",
                    path: path('app_adresse_show', { id: adresse.adresseParent.id }),
                    color: 'green',
                    icon: 'icon-park-solid:up-c',
                }
            ]) %}
        {% endif %}
        {% if adresse.deletedAt is null %}
            {% set btns = btns|merge([{
                label: "Suppr",
                path: path('app_adresse_delete',{id: adresse.id}),
                color: 'red',
                icon: 'gridicons:trash',
            }]) %}
        {% else %}
            {% set btns = btns|merge([ {
                label: "Retaure",
                path: path('app_adresse_restore', {id:adresse.id}),
                color: 'blue',
                icon: 'fa-solid:trash-restore-alt'
            }])%}
        {% endif %}
        {% set btns = btns|merge([{
                label: "Retour",
                path: path('app_adresse_index'),
                color: 'gray',
                icon: 'mdi:arrow-left',
            }]) %}


        {% include 'partials/header.html.twig' with {
            btns: btns,
            title: 'Adresse : '~adresse.name,
            item: adresse
        } %}


        {# =========================
          ONGLETS FONCTIONNELS
          ========================= #}
        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}

        {% set tabs = [
            {
                id: 'summary',
                label: 'Résumé',
                content: include('adresse/_resume.html.twig')
            },{
                id: 'childs',
                label: 'Enfants',
                badge: adresse.children|length,
                icon: 'mdi:baby-bottle',
                content: include('adresse/_children.html.twig', { adresses: adresse.children})
            },{
                id: 'tiers',
                label: 'Tiers liés',
                badge: adresse.tiers|length,
                icon: 'mage:user-fill',
                content: include('tiers/_table.html.twig', {tiers: adresse.tiers}),
            },{
                id:'edit',
                content: include('adresse/_form.html.twig'),
                label: 'Modifier',
                icon: 'mdi:pencil'
            }
        ] %}

        {% include 'partials/tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
        } %}
    </div>
{% endblock %}
