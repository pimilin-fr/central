{% extends 'modern.html.twig' %}

{% set breadcrumb_current = adresse.name %}

{% block title %}Adresse - {{ adresse.name }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">{{ adresse.name }}</h1>

                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ (adresse.adresseType.couleur ?? null)|entity_color }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ adresse.adresseType.name }}</span>
                    </span>
                    {% if adresse.villeCourte %}
                        <span class="entity-sub">{{ adresse.villeCourte }}</span>
                    {% endif %}
                </div>
            </div>

            {% include 'adresse/show/_btns.html.twig' %}
        </div>

        {% include 'adresse/show/_tabs.html.twig' %}
    </div>
{% endblock %}
