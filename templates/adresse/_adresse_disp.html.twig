{% set bgColor = adresse.adresseType.couleur ?? '#F97316' %}
{% set textColor = adresse.adresseType.textColor ?? '#FFFFFF' %}

{% set isDeleted = adresse.deletedAt is not null %}
{% set hasGeolocation = adresse.latitude is not null and adresse.longitude is not null %}

{# AdresseTiers optionnel #}
{% set isAdresseTiers = tierAdresse is defined and tierAdresse is not null %}
{% set isPrincipale = isAdresseTiers and tierAdresse.isPrincipale %}

<div class="relative bg-white rounded-xl shadow-sm hover:shadow-lg transition border overflow-hidden {{ isDeleted ? 'opacity-40' : '' }}">

    {# =================================================
       LISERÉ TYPE D'ADRESSE
       ================================================= #}

    <div class="absolute top-0 right-0 h-full w-8 flex items-center justify-center rounded-r-xl"
         style="background-color: {{ bgColor }}; color: {{ textColor }};">

        <span class="text-xs font-bold tracking-wider rotate-90 whitespace-nowrap">
            {{ adresse.villeCourte }}
        </span>

    </div>


    <div class="p-5 pr-12">

        {# =================================================
           EN-TÊTE
           ================================================= #}

        <div class="flex items-start gap-3">

            {# Géolocalisation #}

            <div class="shrink-0 w-11 h-11 rounded-full flex items-center justify-center shadow-sm {{ hasGeolocation ? 'bg-green-500 text-white' : 'bg-red-500 text-white' }}"
                 title="{{ hasGeolocation ? 'Adresse géolocalisée' : 'Adresse non géolocalisée' }}">

                {{ ux_icon(
                    hasGeolocation
                        ? 'mdi:map-marker'
                        : 'mdi:map-marker-off-outline',
                    {
                        class: 'w-5 h-5'
                    }
                ) }}

            </div>


            <div class="min-w-0 flex-1">

                {# Nom #}

                <div class="flex items-center gap-2">

                    <a href="{{ path('app_adresse_show', {id: adresse.id}) }}"
                       class="text-lg font-semibold text-gray-900 hover:text-orange-600 transition truncate">

                        {{ adresse.name }}

                    </a>


                    {# Adresse principale #}

                    {% if isAdresseTiers and isPrincipale %}

                        <span class="shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600"
                              title="Adresse principale">

                            {{ ux_icon('pajamas:star', {
                                class: 'w-4 h-4'
                            }) }}

                        </span>

                    {% endif %}

                </div>


                {# Type #}

                <div class="mt-1">

                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold"
                          style="background-color: {{ bgColor }}; color: {{ textColor }};">

                        {{ ux_icon('mdi:tag-outline', {
                            class: 'w-3 h-3'
                        }) }}

                        {{ adresse.adresseType.name }}

                    </span>

                </div>

            </div>

        </div>


        <hr class="my-4">


        {# =================================================
           ADRESSE
           ================================================= #}

        <a href="{{ path('app_adresse_show', {id: adresse.id}) }}"
           class="block text-sm text-gray-600 leading-relaxed hover:text-gray-900 transition">

            {{ adresse.adresse }}

        </a>

        {# =================================================
           ACTIONS ADRESSETIERS
           ================================================= #}

        {% if isAdresseTiers %}

            <div class="flex items-center justify-between gap-2 mt-4 pt-3 border-t border-gray-100">

                {# Principal #}

                <a href="{{ path(
                    'app_tiers_adresse_toggle_principale',
                    {
                        id: tierAdresse.id,
                        tiers: tierAdresse.tiers.id
                    }
                ) }}"
                   class="inline-flex items-center gap-1.5 text-xs font-medium transition {{ isPrincipale ? 'text-orange-600 hover:text-orange-700' : 'text-green-600 hover:text-green-700' }}"
                   title="{{ isPrincipale ? 'Retirer comme adresse principale' : 'Définir comme adresse principale' }}">

                    {{ ux_icon(
                        isPrincipale
                            ? 'pajamas:star'
                            : 'mdi:star-outline',
                        {
                            class: 'w-4 h-4'
                        }
                    ) }}

                    {{ isPrincipale ? 'Principale' : 'Définir principale' }}

                </a>


                {# Délier #}

                <a href="{{ path(
                    'app_tiers_adresse_unlink',
                    {
                        id: tierAdresse.id
                    }
                ) }}"
                   class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-400 hover:text-red-600 transition"
                   title="Délier l'adresse">

                    {{ ux_icon('mdi:link-off', {
                        class: 'w-4 h-4'
                    }) }}

                    Délier

                </a>

            </div>

        {% endif %}

    </div>

</div>
