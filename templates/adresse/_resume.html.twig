{% set bgColor = adresse.adresseType.couleur ?? '#F97316' %}
{% set textColor = adresse.adresseType.textColor ?? '#FFFFFF' %}

{# =========================================================
GÉOLOCALISATION
========================================================= #}

{# L'adresse actuellement consultée possède-t-elle ses coordonnées ? #}
{% set hasCurrentGeolocation = adresse.latitude is not null and adresse.longitude is not null%}

{# Y a-t-il au moins une Rue géolocalisée dans les descendants ? #}
{% set hasChildGeolocation = false %}

{% for zone in adresseMap.zones %}
    {% if zone.points|length > 0 %}
        {% set hasChildGeolocation = true %}
    {% endif %}
{% endfor %}

{# La carte peut être affichée si :
* l'adresse courante est géolocalisée
  OU
* au moins une Rue descendante est géolocalisée #}
{% set hasMapData = hasCurrentGeolocation or hasChildGeolocation%}

{% set isDeleted = adresse.deletedAt is not null %}

<div class="grid grid-cols-1 xl:grid-cols-10 gap-6">

    {# =========================================================
       INFORMATIONS
       ========================================================= #}

    <div class="xl:col-span-4 relative bg-white rounded-xl shadow-sm border overflow-hidden">

        {# Liseré du type #}

        <div class="absolute top-0 right-0 z-20 h-full w-8 flex items-center justify-center rounded-r-xl"
             style="background-color: {{ bgColor }}; color: {{ textColor }};">

            <span class="text-xs font-bold tracking-wider rotate-90 whitespace-nowrap">
                {{ adresse.villeCourte }}
            </span>

        </div>

        <div class="p-5 pr-14">
            {# =====================================================
               EN-TÊTE
               ===================================================== #}
            <div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold"
                      style="background-color: {{ bgColor }}; color: {{ textColor }};">
                    {{ ux_icon('mdi:tag-outline', {class: 'w-3.5 h-3.5'}) }} 
                    {{ adresse.adresseType.name }}
                </span>

                <h2 class="mt-3 text-xl font-semibold text-gray-900 break-words">
                    {{ adresse.name }}
                </h2>

                {% if isDeleted %}
                    <span class="mt-2 inline-flex items-center gap-1 px-2 py-1 rounded-md bg-gray-100 text-gray-500 text-xs font-medium">
                        {{ ux_icon('mdi:delete-outline', { class: 'w-3.5 h-3.5'}) }} 
                        Supprimée
                    </span>
                {% endif %}
            </div>

            <hr class="my-5"/>

            {# =====================================================
               ADRESSE
               ===================================================== #}
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">
                    Adresse
                </p>

                <div class="text-sm text-gray-800 leading-relaxed">
                    {% if adresse.prefix %}
                        {{ adresse.prefix }}
                    {% endif %}

                    {% if adresse.num != 0 %}
                        {{ adresse.num }}
                    {% endif %}

                    {{ adresse.bisTer }}
                    {{ adresse.typeVoie }}
                    {{ adresse.nomVoie }}

                    <br>

                    {{ adresse.codePostal }}
                    {{ adresse.ville }}

                    {% if adresse.cedex %}
                        CEDEX {{ adresse.cedex }}
                    {% endif %}

                    <br>

                    {{ adresse.pays }}
                </div>

            </div>

            <hr class="my-5">

            {# =====================================================
               PARENT
               ===================================================== #}
            {% if adresse.adresseParent %}
                {% include 'adresse/_adresse_disp.html.twig' with {
                    'adresse': adresse.adresseParent
                } %}
            {% endif %}
        </div>

    </div>


    {# =========================================================
       CARTE / GÉOLOCALISATION
       ========================================================= #}

    <div class="xl:col-span-6 relative bg-white rounded-xl shadow-sm border overflow-hidden">

        {# Liseré géolocalisation #}
        <div class="absolute top-0 left-0 z-20 h-full w-2"
             style="background-color: {{ hasMapData ? '#22C55E' : '#D1D5DB' }};">
        </div>

        {% if hasMapData %}
            <div class="p-5 pl-7 h-full flex flex-col">
                {# =================================================
                   EN-TÊTE
                   ================================================= #}
                <div class="flex items-center justify-between gap-4 mb-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                            Géolocalisation
                        </p>

                        <p class="mt-1 text-sm font-medium text-green-600 flex items-center gap-1.5">

                            {{ ux_icon('mdi:map-marker-multiple', {class: 'w-4 h-4'}) }}

                            {% if hasCurrentGeolocation %}
                                Localisation disponible
                            {% else %}
                                Localisation des rues
                            {% endif %}

                        </p>
                    </div>


                    <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-green-50 text-green-600">
                        {{ ux_icon('mdi:crosshairs-gps', {class: 'w-5 h-5'}) }}
                    </span>

                </div>


                {# =================================================
                   CARTE HIÉRARCHIQUE
                   ================================================= #}

                <div id="adresse-map-{{ adresse.id }}"
                     data-map
                     data-map-type="hierarchical"
                     class="app-map w-full rounded-lg overflow-hidden border"
                     style="height: 650px;">

                    {# =================================================
                       ADRESSE COURANTE
                       ================================================= #}
                    {% if hasCurrentGeolocation %}
                        <span data-map-current
                              data-id="{{ adresseMap.current.id }}"
                              data-name="{{ adresseMap.current.name }}"
                              data-url="{{ adresseMap.current.url }}"
                              data-latitude="{{ adresseMap.current.latitude }}"
                              data-longitude="{{ adresseMap.current.longitude }}">
                        </span>
                    {% endif %}

                    {# =================================================
                       ZONES / RUES
                       ================================================= #}
                    {% for zone in adresseMap.zones %}
                        <div data-map-zone
                             data-zone="{{ zone.id }}"
                             data-zone-name="{{ zone.name }}">
                            {% for point in zone.points %}
                                <span data-map-point
                                      data-id="{{ point.id }}"
                                      data-name="{{ point.name }}"
                                      data-url="{{ point.url }}"
                                      data-latitude="{{ point.latitude }}"
                                      data-longitude="{{ point.longitude }}">
                                </span>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>


                {# =================================================
                   COORDONNÉES DE L'ADRESSE COURANTE
                   ================================================= #}

                {% if hasCurrentGeolocation %}

                    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-400">

                        <span>
                            Latitude : {{ adresse.latitude }}
                        </span>

                        <span>
                            Longitude : {{ adresse.longitude }}
                        </span>

                    </div>

                {% elseif hasChildGeolocation %}

                    <div class="mt-3 text-xs text-gray-400">
                        L'adresse courante n'est pas géolocalisée.
                        La carte affiche les rues géolocalisées de ses descendants.
                    </div>

                {% endif %}

            </div>
        {% else %}

            {# =====================================================
               PAS DE GÉOLOCALISATION
               ===================================================== #}
            <div class="p-6 pl-8">
                <div class="flex items-center gap-3 mb-5">
                    <div class="shrink-0 w-11 h-11 rounded-xl bg-gray-100 text-gray-400 flex items-center justify-center">
                        {{ ux_icon('mdi:map-marker-off-outline', {class: 'w-6 h-6'}) }}
                    </div>

                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                            Géolocalisation
                        </p>

                        <p class="text-sm font-medium text-gray-600">
                            Non renseignée
                        </p>
                    </div>
                </div>

                {# =================================================
                   ADRESSE COMPLÈTE
                   ================================================= #}
                {% if adresse.adresse %}
                    <div class="p-4 rounded-lg bg-orange-50 border border-orange-100 mb-4">
                        <p class="flex items-center gap-2 text-xs font-semibold text-orange-600 mb-2">
                            {{ ux_icon('mdi:map-marker-alert', {class: 'w-4 h-4'}) }} 
                            Adresse complète
                        </p>

                        <p class="text-sm text-gray-700 leading-relaxed break-words">
                            {{ adresse.adresse }}
                        </p>

                    </div>
                {% endif %}

                {# =================================================
                   ADRESSE FORCÉE
                   ================================================= #}

                {% if adresse.adresseForcee %}
                    <div class="p-4 rounded-lg bg-orange-50 border border-orange-100 mb-4">
                        <p class="flex items-center gap-2 text-xs font-semibold text-orange-600 mb-2">
                            {{ ux_icon('mdi:map-marker-alert', {class: 'w-4 h-4'}) }} Adresse forcée
                        </p>

                        <p class="text-sm text-gray-700 leading-relaxed break-words">
                            {{ adresse.adresseForcee }}
                        </p>
                    </div>

                {% endif %}

                {# =================================================
                   ADRESSE EXACTE
                   ================================================= #}

                {% if adresse.adresseExact %}
                    <div class="p-4 rounded-lg bg-gray-50 border">
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">
                            Adresse exacte
                        </p>

                        <p class="text-sm text-gray-700 leading-relaxed break-words">
                            {{ adresse.adresseExact }}
                        </p>
                    </div>
                {% endif %}

            </div>

        {% endif %}

    </div>


</div>
