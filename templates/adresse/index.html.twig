{% extends 'modern.html.twig' %}

{% block title %}Adresses{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="toolbar">
                    {% include 'layout/modern/components/_search.html.twig' with {
                        target: '#adresses-list',
                        placeholder: 'Rechercher une adresse...',
                        aria_label: 'Rechercher une adresse',
                        empty: '#adresses-search-empty',
                        count: '#adresses-visible-count'
                    } %}

                    <div class="toolbar-info">
                        <span class="toolbar-dot"></span>
                        <span><strong id="adresses-visible-count">{{ adresses|length }}</strong> adresses</span>
                    </div>
                    {# TEMPORAIRE (refonte des adresses) : nombre d'adresses sans parent — à retirer ensuite #}
                    {% set orphelines = adresses|filter(a => a.adresseParent is null and 'planète' not in a.adresseType.name|lower) %}
                    <div class="toolbar-info" title="Adresses sans parent, y compris supprimées (hors Planète)">
                        <span style="color: var(--warning, #d98e04);">⚠ <strong>{{ orphelines|length }}</strong> sans parent</span>
                    </div>
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label: 'Ajouter',
                        path: path('app_adresse_new'),
                        icon: 'gridicons:add',
                        color: 'primary'
                    }
                ]
            } %}
        </div>

        <section class="entity-list">
            {% include 'adresse/list/_table.html.twig' %}
        </section>
    </div>
{% endblock %}
