{% extends 'modern.html.twig' %}

{% block title %}Tiers{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div class="toolbar">
                    {% include 'layout/modern/components/_search.html.twig' with {
                        target: '#tiers-list',
                        placeholder: 'Rechercher un tiers...',
                        aria_label: 'Rechercher un tiers',
                        empty: '#tiers-search-empty',
                        count: '#tiers-visible-count'
                    } %}

                    <div class="toolbar-info">
                        <span class="toolbar-dot"></span>
                        <span><strong id="tiers-visible-count">{{ tiers|length }}</strong> tiers</span>
                    </div>
                </div>
            </div>

            {% include 'layout/modern/components/_btns.html.twig' with {
                btns: [
                    {
                        label:'Type de tiers',
                        path: path('app_type_tiers_index'),
                        icon: 'mage:users-fill',
                        color: null
                    },{
                        label:'Ajouter',
                        path : path('app_tiers_new'),
                        icon: 'gridicons:add',     
                        color: 'primary'
                    }
                ]
            } %}

        </div>



        <section class="tiers-grid-wrapper">
            {% include 'tiers/list/_table.html.twig' %}
        </section>
    </div>
{% endblock %}
