{% set formAction = path('app_tiers_new') %}
{% if tiers is defined %}
    {% set formAction = path('app_tiers_edit', { id: tiers.id }) %}
{% endif %}

{{ form_start(form, {
    action: formAction,
    attr: { class: 'modern-form' }
}) }}

<div class="form-hero">
    <div class="form-hero-icon"><twig:ux:icon name="solar:user-id-bold" /></div>
    <div>
        <span class="form-hero-kicker">IDENTITÉ DU TIERS</span>
        <h2 class="form-hero-title">Construisons sa fiche</h2>
        <p class="form-hero-text">Les informations principales servent à identifier rapidement ce tiers dans Central.</p>
    </div>
</div>

<div class="form-section-grid">
    <div class="form-field-card form-field-card-wide">
        <div class="form-field-heading">
            <span class="form-field-index">01</span>
            <div>
                <span class="form-field-kicker">IDENTITÉ</span>
                <h3>Nom du tiers</h3>
            </div>
        </div>
        {{ form_label(form.name, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.name, { attr: { class: 'modern-form-control', placeholder: 'Ex. Jean Dupont ou Société Martin' } }) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">02</span>
            <div>
                <span class="form-field-kicker">CLASSIFICATION</span>
                <h3>Type de tiers</h3>
            </div>
        </div>
        {{ form_label(form.tiersType, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.tiersType, { attr: { class: 'modern-form-control autocomplete', placeholder: 'Choisir un type' } }) }}
        {{ form_errors(form.tiersType) }}
    </div>

    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">03</span>
            <div>
                <span class="form-field-kicker">RECHERCHE</span>
                <h3>Texte secondaire</h3>
            </div>
        </div>
        {{ form_label(form.searchText, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.searchText, { attr: { class: 'modern-form-control', placeholder: 'Alias, nom abrégé, repère...' } }) }}
        {{ form_errors(form.searchText) }}
    </div>

    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">04</span>
            <div>
                <span class="form-field-kicker">CONFIGURATION</span>
                <h3>Stratégie de démo</h3>
            </div>
        </div>
        {{ form_label(form.demoStrategy, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.demoStrategy, { attr: { class: 'modern-form-control' } }) }}
        {{ form_errors(form.demoStrategy) }}
    </div>
</div>

<div class="modern-form-footer">
    <div class="modern-form-footer-copy">
        <twig:ux:icon name="lucide:shield-check" />
        <span>Vous pourrez compléter les adresses et autres informations après création.</span>
    </div>

    {% include 'layout/modern/components/_btns.html.twig' with {
        btns: [
            {
                label: 'Créer le tiers',
                type: 'submit',
                icon: 'ic:round-add',
                color: 'primary'
            }
        ]
    } %}
</div>

{{ form_end(form) }}
