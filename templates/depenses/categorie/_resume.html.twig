<div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">

    {# OPTIONS DE GROUPEMENT #}
    <div class="md:col-span-3 bg-gray-100 p-5 rounded-xl border shadow">
        {% include 'detail/v2/_grouping.html.twig' with {
            groupBy: groupBy,
            route: 'app_categorie_show',
            routeParams: {
                id: entity.id,
                tab: 'summary'
            }
        } %}
    </div>

    {# INFOS CATEGORIE #}
    <div class="md:col-span-2 bg-gray-100 p-5 rounded-xl shadow border relative overflow-hidden">

        <div class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm pr-4">

            <div>
                <p class="text-gray-500">Nom</p>
                <p class="text-gray-800 font-medium">{{ entity.name }}</p>
            </div>

            <div>
                <p class="text-gray-500">Libelle</p>
                <p class="text-gray-800 font-medium">
                    {{ entity.libelle }}
                </p>
            </div>

            <div>
                <p class="text-gray-500">Statut</p>
                {% if entity.deletedAt %}
                    <p class="flex items-center gap-2 text-xs text-red-600 font-bold">
                        {{ ux_icon('fluent-mdl2:status-error-full', { class: 'w-4 h-4' }) }}
                        <span>Inactif</span>
                    </p>
                {% else %}
                    <p class="flex items-center gap-2 text-xs text-green-600 font-bold">
                        {{ ux_icon('pajamas:status-active', { class: 'w-4 h-4' }) }}
                        <span>Actif</span>
                    </p>
                {% endif %}
            </div>

            <div>
                <p class="text-gray-500 uppercase text-xs">Créé le</p>
                <p class="text-gray-800">
                    {{ entity.createdAt|date('d/m/Y') }}
                </p>
            </div>

            {% if entity.deletedAt %}
                <div>
                    <p class="text-gray-500 uppercase text-xs">Suppr le</p>
                    <p class="text-gray-800">
                        {{ entity.deletedAt|date('d/m/Y') }}
                    </p>
                </div>
            {% endif %}

        </div>

        {# =========================
           STATUT - LISERÉ VERTICAL
           ========================= #}

        {% if entity.natureLibelle == "Revenu" %}
            {% set badgeClass = "bg-green-500 text-white" %}
            {% set badgeLabel = "Revenu" %}
        {% elseif entity.natureLibelle == "Dépense" %}
            {% set badgeClass = "bg-red-500 text-white" %}
            {% set badgeLabel = "Dépense" %}
        {% else %}
            {% set badgeClass = "bg-gray-300 text-gray-700" %}
            {% set badgeLabel = "Indéfini" %}
        {% endif %}

        <div class="absolute right-0 top-0 h-full w-6 flex items-center justify-center {{ badgeClass }}">
            <span class="font-bold uppercase whitespace-nowrap" style="transform: rotate(90deg);">
                {{ badgeLabel }}
            </span>
        </div>

    </div>

</div>

<div>
    <form method="post"
          action="{{ path('app_depenses_bulk_update') }}"
          class="mb-4"
          data-bulk-form>

        <div class="flex flex-wrap items-end gap-4 bg-gray-100 p-4 rounded-lg border shadow-sm space-y-3 mb-4">
            {{ include('depenses/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include('detail/v2/_releve.html.twig') %}
        </div>

    </form>
</div>
