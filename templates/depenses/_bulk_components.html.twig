<!-- Action -->
<div>
    <label class="block text-sm font-medium text-gray-700">Action</label>
    <select id="bulk-action"
            name="action"
            class="mt-1 block w-56 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
        <option value="">-- Choisir --</option>
        <option value="set_date_releve" data-fields="date">Date relevé</option>
        <option value="set_projet" data-fields="projet">Affecter à un projet</option>
        <option value="delete" data-fields="">Supprimer la ligne</option>
    </select>
</div>

<!-- Date -->
<div data-field="date" class="hidden">
    <label class="block text-sm font-medium text-gray-700">Date</label>
    <input type="date"
           name="date_value"
           class="mt-1 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
</div>

<!-- Projet (Autocomplete + Hidden ID) -->
<div data-field="projet" class="hidden w-64">
    <label class="block text-sm font-medium text-gray-700">Projet</label>

    <input type="text"
           name="projet"
           class="autocomplete w-full mt-1 rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500"
           data-endpoint="/projet/search"/>

    <input type="hidden" name="projet_id">
</div>

<button type="submit"
        class="bg-blue-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-md shadow">
    Appliquer
</button>