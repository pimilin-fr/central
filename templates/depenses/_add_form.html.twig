{#
    Formulaire « Nouvelle opération » — briques du design system, multi-thème.
    On conserve tous les ids / names attendus par app.js (#depense-form, [tiers], [adresse], [adresse_id]).
#}
{{ form_start(form, {
    action: path('app_depenses_new', { portefeuille: form.vars.value.portefeuille ? form.vars.value.portefeuille.id : null }),
    attr: { id: 'depense-form', class: 'modern-form' },
}) }}

<div class="modern-form-intro">
    <div>
        <span class="modern-form-kicker">NOUVELLE OPÉRATION</span>
        <h2 class="modern-form-title">Saisir une dépense ou un revenu</h2>
    </div>
</div>

<div class="form-section-grid form-section-grid-3">

    {# ---- Opération ---- #}
    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">01</span>
            <h3>Opération</h3>
        </div>
        <div class="form-stack">
            <div>
                {{ form_label(form.date, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.date, { attr: { class: 'modern-form-control' } }) }}
                {{ form_errors(form.date) }}
            </div>
            <div>
                {{ form_label(form.montant, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.montant, { attr: { class: 'modern-form-control' } }) }}
                {{ form_errors(form.montant) }}
            </div>
            <div>
                {{ form_label(form.numCommande, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.numCommande, { attr: { class: 'modern-form-control' } }) }}
                {{ form_errors(form.numCommande) }}
            </div>
        </div>
    </div>

    {# ---- Imputation ---- #}
    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">02</span>
            <h3>Imputation</h3>
        </div>
        <div class="form-stack">
            <div>
                {{ form_label(form.categorie, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.categorie, { attr: { class: 'modern-form-control autocomplete' } }) }}
                {{ form_errors(form.categorie) }}
            </div>
            <div>
                {{ form_label(form.tiers, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.tiers, { attr: { class: 'modern-form-control autocomplete' } }) }}
                {{ form_errors(form.tiers) }}
            </div>
            <div>
                {{ form_label(form.adresse, null, { label_attr: { class: 'modern-form-label' } }) }}
                <select id="{{ form.adresse.vars.id }}"
                        name="{{ form.adresse.vars.full_name }}"
                        class="modern-form-control">
                    <option value="">Adresse</option>
                </select>
                {{ form_widget(form.adresse_id) }}
                {{ form_errors(form.adresse) }}
            </div>
            <div>
                {{ form_label(form.projet, null, { label_attr: { class: 'modern-form-label' } }) }}
                {{ form_widget(form.projet, { attr: { class: 'modern-form-control autocomplete' } }) }}
                {{ form_errors(form.projet) }}
            </div>
        </div>
    </div>

    {# ---- Portefeuille ---- #}
    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">03</span>
            <h3>Portefeuille</h3>
        </div>
        <div class="choice-list">
            {% for choice in form.portefeuille %}
                <label class="choice-card">
                    {{ form_widget(choice) }}
                    <span>{{ choice.vars.label }}</span>
                </label>
            {% endfor %}
        </div>
        {{ form_errors(form.portefeuille) }}
    </div>

    {# ---- Note ---- #}
    <div class="form-field-card form-field-card-wide">
        <div class="form-field-heading">
            <span class="form-field-index">04</span>
            <h3>Note</h3>
        </div>
        {{ form_label(form.note, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.note, { attr: { class: 'modern-form-control' } }) }}
        {{ form_errors(form.note) }}
    </div>
</div>

{# Champ technique conservé tel quel (rempli par le JS) #}
<div hidden>{{ form_widget(form.adresse) }}</div>

<div class="modern-form-footer">
    <span class="modern-form-footer-copy"><span class="required-legend">Champ obligatoire</span>{{ form_errors(form) }}</span>

    <button type="submit" class="page-action page-action-primary">
        <twig:ux:icon name="mdi:content-save-outline" />
        <span>Enregistrer</span>
    </button>
</div>

{{ form_end(form) }}
