
{{ form_start(form, {
    action: path('app_depenses_new'),
    attr: { id: 'depense-form', class:'space-y-6' },
}) }}

{# =========================
   CHAMPS
   ========================= #}
<div class="grid grid-cols-1 md:grid-cols-4 gap-6">

    {# Date #}
    <div>
        {{ form_label(form.date, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.date, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.date) }}
    </div>

    {# montant #}
    <div>
        {{ form_label(form.montant, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.montant, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.montant) }}
    </div>
    {# numCommande #}
    <div>
        {{ form_label(form.numCommande, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.numCommande, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.numCommande) }}
    </div>
    {# ptf #}
    <div class="md:row-span-3">
        {{ form_label(form.portefeuille, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-2' }
        }) }}

        <div class="space-y-2">
            {% for choice in form.portefeuille %}
                <label class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50">
                    {{ form_widget(choice, {
                    attr: {
                        class: 'h-4 w-4 text-orange-600 border-gray-300 focus:ring-orange-500'
                    }
                }) }}
                    <span class="text-sm text-gray-700">
                        {{ choice.vars.label }}
                    </span>
                </label>
            {% endfor %}
        </div>

        {{ form_errors(form.portefeuille) }}
    </div>


    {# categorie #}
    <div>
        {{ form_label(form.categorie, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.categorie, {
            attr: {
                class: 'autocomplete w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.categorie) }}
    </div>
    {# tiers #}
    <div class="relative">
        {{ form_label(form.tiers, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.tiers, {
            attr: {
                class: 'autocomplete w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.tiers) }}
    </div>
    {# projet #}
    <div class="relative">
        {{ form_label(form.projet, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.projet, {
            attr: {
                class: 'autocomplete w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.projet) }}
    </div>
    {# note #}
    <div class="md:col-span-3">
        {{ form_label(form.note, null, {
            label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
        }) }}

        {{ form_widget(form.note, {
            attr: {
                class: 'w-full rounded-lg border-gray-300 bg-white focus:border-orange-500 focus:ring-orange-500'
            }
        }) }}

        {{ form_errors(form.note) }}
    </div>

</div>

{# =========================
   ACTIONS
   ========================= #}
<div class="flex justify-end gap-3 pt-4">
    <button type="submit"
            class="inline-flex items-center gap-2 px-4 py-2
            text-sm font-medium rounded-lg
            bg-orange-500 hover:bg-orange-600 text-white transition">
        {{ ux_icon('mdi:content-save-outline', { class: 'w-4 h-4' }) }}
        Enregistrer
    </button>
</div>

{{ form_end(form) }}
