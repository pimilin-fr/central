{% extends 'base.html.twig' %}

{% block title %}Dépenses - Liste{% endblock %}

{% block body %}
    <div class="space-y-6">
        {# =========================
            HEADER : Titre + actions (modernisé)
            ========================= #}
        {% 
            set btns = [
                
            ]
        
        %}
        {% include 'partials/header.html.twig' with {
            btns: btns,
            title: "Dépenses - Liste",
            item: null
        } %}
        
        {# =========================
           ONGLETS FONCTIONNELS
           ========================= #}
        {% set activeTab = app.request.query.get('tab') ?? 'list' %}

        {% set tabs = [
            {
                id: 'list',
                label: 'Listes',
                content: include('depenses/_bulk_depense.html.twig')
            },{
                id: 'dépense',
                label: 'Dépense',
                icon: 'ic:round-add',
                content: include('depenses/_depenses_form.html.twig', { form: depensesForm })
            }
        ] %}

        {% include 'partials/tabs.html.twig' with {
            tabs: tabs,
            activeTab: activeTab
        } %}
    </div>
{% endblock %}