{% for group in groups %}

    {% set groupKey = group.key %}

    {% set isReleve = group.extra.releveId is defined %}
    <div class="ops-group{{ isReleve ? ' is-releve ' ~ (group.extra.closed ? 'is-closed' : 'is-open') : '' }}">

        {# HEADER DU GROUPE : couleurs des montants identiques à celles d'une ligne #}
        <div class="block-head is-bar is-clickable ops-group-header" onclick="toggleGroup('{{ groupKey }}')">

            <div class="ops-group-title">
                <span class="ops-group-label {{ groupKey == '0' ? 'is-unassigned' : '' }}">
                    {{ group.label }}
                </span>

                {# Relevé : état (finalisé = ordre du relevé de compte figé) + accès à l'écran de composition #}
                {% if group.extra.releveId is defined %}
                    {% if group.extra.closed %}
                        <span class="ops-group-badge is-closed" title="Relevé clos : opérations dans l'ordre du relevé de compte">
                            <twig:ux:icon name="lucide:lock" /> Clos
                        </span>
                    {% elseif group.extra.ordered %}
                        <span class="ops-group-badge is-open" title="Relevé non clos, en cours de pointage : à compléter puis finaliser">
                            <twig:ux:icon name="lucide:lock-open" /> Non clos · en cours
                        </span>
                    {% else %}
                        <span class="ops-group-badge is-open is-legacy" title="Relevé non clos (ancien relevé, sans ordre)">
                            <twig:ux:icon name="lucide:lock-open" /> Non clos
                        </span>
                    {% endif %}
                    <a class="ops-group-link"
                       href="{{ path('app_releve_compose', { id: group.extra.portefeuilleId, releve: group.extra.releveId }) }}"
                       onclick="event.stopPropagation()"
                       title="{{ group.extra.closed ? 'Voir le relevé' : 'Ordonner / compléter / clore le relevé' }}">
                        {{ group.extra.closed ? 'Voir' : (group.extra.ordered ? 'Compléter' : 'Ordonner / clore') }}
                    </a>
                {% endif %}

                <span class="ops-group-count">
                    {% if group.depenses is not empty %}
                        {{ group.depenses|length }} opération{{ group.depenses|length > 1 ? 's' : '' }}
                    {% else %}
                        aucune opération
                    {% endif %}
                </span>
            </div>

            <div class="ops-group-totals">

                {# Dépenses : rouge ; négatives = remboursement, bleu #}
                {% if group.totalDepense > 0 %}
                    <span class="amount-expense">
                        - {{ group.totalDepense|number_format(2, ',', ' ') }} €
                    </span>
                {% elseif group.totalDepense < 0 %}
                    <span class="amount-refund">
                        + {{ group.totalDepense|abs|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}

                {# Revenus : vert ; négatifs = rouge #}
                {% if group.totalRevenu > 0 %}
                    <span class="amount-income">
                        + {{ group.totalRevenu|number_format(2, ',', ' ') }} €
                    </span>
                {% elseif group.totalRevenu < 0 %}
                    <span class="amount-expense">
                        - {{ group.totalRevenu|abs|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}

                {# Balances : uniquement si cumulatif #}
                {% if group.cumulative %}
                    <span class="ops-balance-prev">
                        {{ group.previousBalance|number_format(2, ',', ' ') }} €
                    </span>
                    <strong>→</strong>
                    <span class="ops-balance {{ group.currentBalance < 0 ? 'amount-expense' : 'amount-income' }}">
                        {{ group.currentBalance|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}
            </div>

        </div>

        {# DETAILS #}
        <div id="group-{{ groupKey }}" class="hidden">
            {# « Tri : Relevé » : un sous-groupe par relevé (même visuel que les groupes), sauf si le groupe EST déjà un relevé #}
            {% set runs = (app.request.query.get('tri') == 'releve' and not isReleve) ? group.releveRuns : [] %}
            {% if runs|length > 1 or (runs|length == 1 and runs[0].releve is not null) %}
                {% for run in runs %}
                    {% set releve = run.releve %}
                    <section class="ops-subgroup{{ releve ? ' is-releve ' ~ (releve.closed ? 'is-closed' : 'is-open') : ' is-none' }}">
                        <header class="block-head ops-group-header ops-subgroup-header">
                            <div class="ops-group-title">
                                {% if releve %}
                                    <span class="ops-group-label">Relevé du {{ releve.date|date('d/m/Y') }}</span>
                                    {% if releve.closed %}
                                        <span class="ops-group-badge is-closed" title="Relevé clos : opérations dans l'ordre du relevé de compte"><twig:ux:icon name="lucide:lock" /> Clos</span>
                                    {% else %}
                                        <span class="ops-group-badge is-open" title="Relevé non clos"><twig:ux:icon name="lucide:lock-open" /> Non clos</span>
                                    {% endif %}
                                    <a class="ops-group-link" href="{{ path('app_releve_compose', { id: releve.portefeuille.id, releve: releve.id }) }}"
                                       title="{{ releve.closed ? 'Voir le relevé' : 'Ordonner / compléter / clore le relevé' }}">{{ releve.closed ? 'Voir' : 'Compléter' }}</a>
                                {% else %}
                                    <span class="ops-group-label is-unassigned">Hors relevé</span>
                                {% endif %}
                                <span class="ops-group-count">{{ run.depenses|length }} opération{{ run.depenses|length > 1 ? 's' : '' }}</span>
                            </div>
                            <div class="ops-group-totals">
                                {% if run.totalDepense > 0 %}<span class="amount-expense">- {{ run.totalDepense|number_format(2, ',', ' ') }} €</span>{% endif %}
                                {% if run.totalRevenu > 0 %}<span class="amount-income">+ {{ run.totalRevenu|number_format(2, ',', ' ') }} €</span>{% endif %}
                            </div>
                        </header>
                        {{ include('depenses/list/_table.html.twig', { depenses: run.depenses, numbered: run.numbered }) }}
                    </section>
                {% endfor %}
            {% else %}
                {{ include('depenses/list/_table.html.twig', {
                    depenses: group.depenses,
                    numbered: group.statementOrder,
                    before: (group.statementOrder and group.cumulative) ? group.previousBalance : null
                }) }}
            {% endif %}
        </div>

    </div>

{% endfor %}
