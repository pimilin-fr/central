{% for group in groups %}

    {% set groupKey = group.key %}

    <div class="ops-group">

        {# HEADER DU GROUPE : couleurs des montants identiques à celles d'une ligne #}
        <div class="ops-group-header" onclick="toggleGroup('{{ groupKey }}')">

            <div class="ops-group-title">
                <span class="ops-group-label {{ groupKey == '0' ? 'is-unassigned' : '' }}">
                    {{ group.label }}
                </span>

                {# Relevé : état (finalisé = ordre du relevé de compte figé) + accès à l'écran de composition #}
                {% if group.extra.releveId is defined %}
                    {% if group.extra.closed %}
                        <span class="ops-group-badge is-closed" title="Relevé finalisé : opérations dans l'ordre du relevé de compte">
                            <twig:ux:icon name="lucide:lock" /> Finalisé
                        </span>
                    {% elseif group.extra.ordered %}
                        <span class="ops-group-badge is-draft" title="Relevé en cours : à compléter puis finaliser">
                            <twig:ux:icon name="lucide:pencil-line" /> En cours
                        </span>
                    {% endif %}
                    <a class="ops-group-link"
                       href="{{ path('app_releve_compose', { id: group.extra.portefeuilleId, releve: group.extra.releveId }) }}"
                       onclick="event.stopPropagation()"
                       title="{{ group.extra.closed ? 'Voir le relevé' : 'Ordonner / compléter le relevé' }}">
                        {{ group.extra.closed ? 'Voir' : (group.extra.ordered ? 'Compléter' : 'Ordonner') }}
                    </a>
                {% endif %}

                <span class="ops-group-count">
                    {% if group.depenses is not empty %}
                        {{ group.depenses|length }} opération{{ group.depenses|length > 1 ? 's' : '' }}
                    {% else %}
                        aucune opération
                    {% endif %}
                </span>
            </div>

            <div class="ops-group-totals">

                {# Dépenses : rouge ; négatives = remboursement, bleu #}
                {% if group.totalDepense > 0 %}
                    <span class="amount-expense font-medium">
                        - {{ group.totalDepense|number_format(2, ',', ' ') }} €
                    </span>
                {% elseif group.totalDepense < 0 %}
                    <span class="amount-refund font-medium">
                        + {{ group.totalDepense|abs|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}

                {# Revenus : vert ; négatifs = rouge #}
                {% if group.totalRevenu > 0 %}
                    <span class="amount-income font-medium">
                        + {{ group.totalRevenu|number_format(2, ',', ' ') }} €
                    </span>
                {% elseif group.totalRevenu < 0 %}
                    <span class="amount-expense font-medium">
                        - {{ group.totalRevenu|abs|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}

                {# Balances : uniquement si cumulatif #}
                {% if group.cumulative %}
                    <span class="ops-balance-prev">
                        {{ group.previousBalance|number_format(2, ',', ' ') }} €
                    </span>
                    <strong>→</strong>
                    <span class="ops-balance {{ group.currentBalance < 0 ? 'amount-expense' : 'amount-income' }}">
                        {{ group.currentBalance|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}
            </div>

        </div>

        {# DETAILS #}
        <div id="group-{{ groupKey }}" class="hidden">
            {{ include('depenses/list/_table.html.twig', {
                depenses: group.depenses,
                numbered: group.statementOrder
            }) }}
        </div>

    </div>

{% endfor %}
