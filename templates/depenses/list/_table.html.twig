{% if numbered|default(false) %}
    {{ include('depenses/list/_lines.html.twig', { depenses: depenses, before: before|default(null) }, with_context = false) }}
{% else %}
{% set numbered = numbered|default(false) %}
{% set colCount = numbered ? 7 : 6 %}
{% set releveId = depense.releveId ?? 0 %}
<table class="ops-table" data-releve="{{ releveId }}">
    <thead>
        <tr>
            <th><input type="checkbox" class="select-all"/></th>
            {% if numbered %}<th class="ops-rank-head" title="Ordre sur le relevé de compte">N°</th>{% endif %}
            <th>Date</th>
            <th>Catégorie</th>
            <th>Tiers</th>
            <th>Projet</th>
            <th>Montant</th>
        </tr>
    </thead>

    <tbody>

        {% set prevRank = null %}
        {% for depense in depenses %}
            {% set sub = numbered and depense.releveOrdre is not null and depense.releveOrdre == prevRank %}
            {% set rankCount = 0 %}
            {% if numbered and depense.releveOrdre is not null %}{% for o in depenses %}{% if o.releveOrdre == depense.releveOrdre %}{% set rankCount = rankCount + 1 %}{% endif %}{% endfor %}{% endif %}
            <tr class="ops-row depense-row{{ sub ? ' is-sub' : '' }}{{ rankCount > 1 ? ' is-multi' : '' }}"
                data-id="{{ depense.id }}">

                <td onclick="event.stopPropagation()">
                    <input type="checkbox"
                           name="ids[]"
                           value="{{ depense.id }}"
                           class="row-checkbox">
                </td>

                {% if numbered %}<td class="ops-rank{{ sub ? ' is-sub' : '' }}"{% if rankCount > 1 and not sub %} title="Détail : {{ rankCount }} opérations pointées ensemble"{% endif %}>{{ sub ? '↳' : (depense.releveOrdre ?? '·') }}</td>{% endif %}

                <td>
                    {{ depense.date|date('d/m/Y') }}
                </td>

                <td>
                    {{ depense.categorie.name ?? '-' }}
                </td>

                <td>
                    <span class="pill pill-entity"
                          style="
                          background-color: {{ (depense.tiers.tiersType.couleur ?? null)|entity_color }};
                          color: {{ (depense.tiers.tiersType.couleur ?? null)|entity_text }};
                          ">

                        <span>{{ depense.tiers.name }}</span>
                    </span>
                </td>

                <td>
                    {% if (depense.projet) %}
                        <span class="pill pill-entity"
                              style="
                              background-color: {{ (depense.projet.couleur ?? null)|entity_color }};
                              color: {{ (depense.projet.couleur ?? null)|entity_text }};
                              ">

                            <span>{{ depense.projet.name }}</span>
                        </span>
                    {% else %}
                        -
                    {% endif %}
                </td>

                {#<td class="{{ depense.categorie.isDepense ? 'text-red-500' : 'text-green-500' }}">
                    {{ depense.montant|number_format(2, ',', ' ') }} €
                </td>#}

                {% if depense.categorie.isDepense %}
                    {% if  depense.montant < 0 %}
                        <td class="amount-refund">
                            + {{ 
                            (
                                (depense.montant|default('0')|replace({' ': '', ',': '.'})) * -1
                            )
                            |number_format(2, ',', ' ')
                            }} €
                        </td>
                    {% else %}
                        <td class="amount-expense">
                            - {{ depense.montant|number_format(2, ',', ' ') }} €
                        </td>
                    {% endif %}
                {% else %}
                    <td class="amount-income">
                        + {{ depense.montant|number_format(2, ',', ' ') }} €
                    </td>
                {% endif %}
            </tr>

            {% set prevRank = depense.releveOrdre %}
            {# DETAILS (hidden) #}
            <tr class="hidden ops-detail-row detail-row" id="detail-{{ depense.id }}">
                <td colspan="{{ colCount }}" class="ops-detail-cell">

                    <div>

                        <div>
                            <strong>Commande :</strong> {{ depense.numCommande ?? '-' }}
                        </div>

                        <div>
                            <strong>Portefeuille :</strong> {{ depense.portefeuille.libelle }}
                        </div>

                        <div>
                            <strong>Relevé :</strong>
                            {{ depense.releve ? depense.releve.date|date('d/m/Y') : '-' }}
                        </div>
                        
                        <div>
                            <strong>Note :</strong> {{ depense.note ? depense.note  : '-' }}
                        </div>

                    </div>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="{{ colCount }}" class="ops-empty">Pas de dépenses</td>
            </tr>
        {% endfor %}

    </tbody>
</table>
{% endif %}
