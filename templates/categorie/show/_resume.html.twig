{# Nature : couleur + icône via --entity-color / --entity-text #}
{% set nature = entity.natureLibelle %}
{% if nature == 'Revenu' %}
    {% set natureColor = 'var(--category-income)' %}
    {% set natureIcon = 'healthicons:low-income-level-outline-24px' %}
{% elseif nature == 'Dépense' %}
    {% set natureColor = 'var(--category-expense)' %}
    {% set natureIcon = 'reicon:money-send3-filled' %}
{% else %}
    {% set natureColor = 'var(--text-muted)' %}
    {% set natureIcon = 'lucide:folder-tree' %}
{% endif %}

<div class="resume-layout">

    {# REGROUPEMENT #}
    {% include 'depenses/list/_grouping.html.twig' with {
        groupBy: groupBy,
        route: 'app_categorie_show',
        routeParams: {
            id: entity.id,
            tab: 'summary'
        }
    } %}

    {# CARTE RESUME : cercle (nature) | identité + infos | liseré (nature) #}
    <section class="summary-card" style="--entity-color: {{ natureColor }}; --entity-text: #fff;">

        <div class="entity-circle" title="{{ nature ?: 'Indéfini' }}">
            <twig:ux:icon name="{{ natureIcon }}" />
        </div>

        <div class="summary-body">
            <div class="summary-head">
                <h2 class="summary-name" title="{{ entity.libelle }}">{{ entity.libelle }}</h2>

                <span class="entity-pill" style="--entity-color: {{ natureColor }};">
                    <span class="entity-pill-dot"></span>
                    <span>{{ nature ?: 'Indéfini' }}</span>
                </span>
            </div>

            <div class="summary-grid-2-cols">
                <div class="summary-field">
                    <p class="summary-label">Nom</p>
                    <p class="summary-value" title="{{ entity.name }}">{{ entity.name ?? '—' }}</p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Statut</p>
                    <p class="summary-value">
                        <span class="demo-pill" style="--entity-color: {{ entity.deletedAt ? 'var(--danger)' : 'var(--success)' }};">
                            <twig:ux:icon name="{{ entity.deletedAt ? 'lucide:circle-x' : 'lucide:circle-check' }}" />
                            {{ entity.deletedAt ? 'Inactif' : 'Actif' }}
                        </span>
                    </p>
                </div>

                <div class="summary-field">
                    <p class="summary-label">Créé le</p>
                    <p class="summary-value">{{ entity.createdAt ? entity.createdAt|date('d/m/Y') : '—' }}</p>
                </div>

                {% if entity.deletedAt %}
                    <div class="summary-field">
                        <p class="summary-label">Supprimé le</p>
                        <p class="summary-value">{{ entity.deletedAt|date('d/m/Y') }}</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="summary-ribbon">
            <span class="summary-ribbon-label">{{ nature ?: 'Indéfini' }}</span>
        </div>
    </section>

    {# MODIFICATION EN MASSE + RELEVES #}
    <form method="post" action="{{ path('app_depenses_bulk_update') }}" class="bulk-form" data-bulk-form>
        <div class="bulk-bar" data-bulk-bar>
            {{ include('depenses/list/_bulk_components.html.twig') }}
        </div>

        <div id="releves-container">
            {% include 'depenses/list/_group.html.twig' %}
        </div>
    </form>
</div>
