{% set activeTab = app.request.query.get('tab') ?? 'summary' %}

{% set tabs = [
    {
        id: 'summary',
        label: 'Résumé',
        content: include('categorie/show/_resume.html.twig')
    },{
        id: 'childs',
        label: 'Enfants',
        icon: 'lucide:folder-tree',
        badge: entity.children|length,
        content: include('categorie/list/_table.html.twig', {
            categories: childs
        })
    },{
        id: 'edit',
        label: 'Modifier',
        icon: 'mdi:pencil',
        content: render(controller(
            'App\\Controller\\CategorieController::edit',
            { id: entity.id }
        ))
    }
] %}

{% include 'layout/modern/components/_tabs.html.twig' with {
    tabs: tabs,
    activeTab: activeTab
} %}
