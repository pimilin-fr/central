<div class="grid grid-cols-1 lg:grid-cols-4 gap-4">

    {# Résumé #}
    <div class="lg:col-span-3 bg-white p-5">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
            <div>
                <p class="text-gray-500">Nom</p>
                <p class="text-gray-800 font-medium">{{ categorie.name }}</p>
            </div>

            <div>
                <p class="text-gray-500">Libelle</p>
                <p class="text-gray-800 font-medium">
                    {{ categorie.libelle }}
                </p>
            </div>

            {# <div>
                 <p class="text-gray-500">Parent</p>
                 <p class="text-gray-800 font-medium">
                     {{ categorie.parent.name ?? "--" }}
                 </p>
             </div>#}

            <div>
                <p class="text-gray-500">Nature</p>
                <p class="text-gray-800 font-medium text-center px-2 py-1 rounded-full
                   {%  if categorie.natureLibelle == "Revenu" %}
                       bg-green-100 text-green-700
                   {% elseif categorie.natureLibelle == "Dépense"%}
                       bg-red-100 text-red-700    
                   {% else %}
                       bg-gray-100 text-gray-700
                   {% endif %}">
                    
                    {{ categorie.natureLibelle??"N/A" }}
                </p>
            </div>

        </div>
    </div>

    {# Dates (tuile compacte à droite) #}
    <div class="bg-gray-200 rounded-xl border shadow-sm p-4 text-sm">
        {% if categorie.deletedAt %}
            <p class="flex items-center gap-2 text-xs text-red-600 font-bold">
                {{ ux_icon('fluent-mdl2:status-error-full', { class: 'w-4 h-4' }) }}
                <span>Inactif</span>
            </p>
        {% else %}
            <p class="flex items-center gap-2 text-xs text-green-600 font-bold">
                {{ ux_icon('pajamas:status-active', { class: 'w-4 h-4' }) }}
                <span>Actif</span>
            </p>
        {% endif %}
        <p class="mt-2 text-xs text-gray-500 uppercase">Créé le</p>
        <p class="text-gray-800">{{ categorie.createdAt|date('d/m/Y') }}</p>
        {% if categorie.deletedAt %}
            <p class="mt-2 text-xs text-gray-500 uppercase">Suppr le</p>
            <p class="text-gray-800">{{ categorie.deletedAt|date('d/m/Y') }}</p>
        {% endif %}
    </div>
</div>