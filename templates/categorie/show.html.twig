{% extends 'modern.html.twig' %}

{# Fil d'Ariane : Central / Catégories / ancêtres… / libellé #}
{% set trail = [] %}
{% set ancestor = entity.parent %}
{% for i in 1..50 %}
    {% if ancestor %}
        {% set trail = [{ label: ancestor.libelle, path: path('app_categorie_show', { id: ancestor.id }) }]|merge(trail) %}
        {% set ancestor = ancestor.parent %}
    {% endif %}
{% endfor %}
{% set breadcrumb_trail = trail %}
{% set breadcrumb_current = entity.libelle %}

{# Nature : couleur (aucune classe liée à la nature, tout passe par --entity-color) #}
{% set nature = entity.natureLibelle %}
{% set natureColor = nature == 'Revenu' ? 'var(--category-income)' : (nature == 'Dépense' ? 'var(--category-expense)' : 'var(--text-muted)') %}

{% block title %}Catégorie - {{ entity.libelle }}{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">{{ entity.libelle }}</h1>

                <div class="page-subline">
                    <span class="entity-pill" style="--entity-color: {{ natureColor }};">
                        <span class="entity-pill-dot"></span>
                        <span>{{ nature ?: 'Indéfini' }}</span>
                    </span>
                </div>
            </div>

            {% include 'categorie/show/_btns.html.twig' %}
        </div>

        {% include 'categorie/show/_tabs.html.twig' %}
    </div>
{% endblock %}
