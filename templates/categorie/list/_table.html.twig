<div id="categorie-list" class="categorie-tree">
    {% for node in categories %}
        {% include 'categorie/list/_node.html.twig' with { node: node } %}
    {% else %}
        <div class="empty-state categorie-empty-state">
            <div class="empty-state-icon"><twig:ux:icon name="lucide:folder-tree" /></div>
            <div>
                <h2>Aucune catégorie</h2>
                <p>Aucune catégorie n'est actuellement disponible.</p>
            </div>
            <a href="{{ path('app_categorie_new') }}" class="page-action page-action-primary">
                <twig:ux:icon name="ic:round-add" />
                <span>Ajouter une catégorie</span>
            </a>
        </div>
    {% endfor %}
</div>

<div id="categorie-search-empty" class="empty-state categorie-search-empty" hidden>
    <div class="empty-state-icon"><twig:ux:icon name="lucide:search-x" /></div>
    <div>
        <h2>Aucun résultat</h2>
        <p>Aucune catégorie ne correspond à votre recherche.</p>
    </div>
</div>
