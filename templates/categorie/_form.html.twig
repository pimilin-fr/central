{% set isEdit = categorie is defined %}
{% set formAction = isEdit
    ? path('app_categorie_edit', { id: categorie.id })
    : path('app_categorie_new') %}

{{ form_start(form, {
    action: formAction,
    attr: { class: 'modern-form' }
}) }}

<div class="modern-form-intro">
    <div>
        <span class="modern-form-kicker">IDENTITÉ DE LA CATÉGORIE</span>
        <h2 class="modern-form-title">Informations essentielles</h2>
    </div>
    <span class="modern-form-step">01 — 03</span>
</div>

<div class="form-section-grid">

    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">01</span>
            <h3>Nom</h3>
        </div>
        {{ form_label(form.name, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.name, { attr: { class: 'modern-form-control' } }) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="form-field-card">
        <div class="form-field-heading">
            <span class="form-field-index">02</span>
            <h3>Libellé</h3>
        </div>
        {{ form_label(form.libelle, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.libelle, { attr: { class: 'modern-form-control' } }) }}
        {{ form_errors(form.libelle) }}
    </div>

    <div class="form-field-card form-field-card-wide">
        <div class="form-field-heading">
            <span class="form-field-index">03</span>
            <h3>Nature</h3>
        </div>
        {{ form_label(form.nature, null, { label_attr: { class: 'modern-form-label' } }) }}
        {{ form_widget(form.nature, { attr: { class: 'modern-form-control' } }) }}
        {{ form_errors(form.nature) }}
    </div>
</div>

<div class="modern-form-footer">
    <span class="modern-form-footer-copy">
        <span class="required-legend">Champ obligatoire</span> — {{ isEdit ? 'Les modifications s’appliquent immédiatement.' : 'La catégorie pourra être rattachée à un parent ensuite.' }}
    </span>

    {% include 'layout/modern/components/_btns.html.twig' with {
        btns: [
            {
                label: isEdit ? 'Enregistrer' : 'Créer la catégorie',
                type: 'submit',
                icon: isEdit ? 'mdi:content-save-outline' : 'ic:round-add',
                color: 'primary'
            }
        ]
    } %}
</div>

{{ form_end(form) }}
