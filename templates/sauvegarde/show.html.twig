{% extends 'sauvegarde/layout.html.twig' %}

{% set crumb = item.id %}
{% block title %}{{ item.id }}{% endblock %}

{% block body %}
    {% set st = item.state %}
    {% set spark = history|job_spark %}
    <div class="ops-page" data-jobs-page data-jobs-state-url="{{ path('app_jobs_state') }}"
         data-jobs-busy="{{ item.status == 'running' or item.pending ? '1' : '0' }}">

        <header class="ops-head">
            <div>
                <div class="ops-prompt">pi@central:~$ <span>jobs --show {{ item.id }}</span></div>
                <h1 class="ops-title">{{ item.job.label }} {% include 'sauvegarde/_badge.html.twig' with { status: item.status } %}</h1>
                {% if item.job.description is defined %}<p class="ops-desc">{{ item.job.description }}</p>{% endif %}
            </div>
            <div class="ops-head-actions">
                <form method="post" action="{{ path('app_jobs_run', {id: item.id}) }}" data-jobs-confirm="Relancer cette tâche maintenant ?">
                    <input type="hidden" name="_token" value="{{ csrf_token('jobs_run') }}">
                    <input type="hidden" name="back" value="show">
                    {% include 'layout/modern/components/_btns.html.twig' with {
                        removeContainer: true,
                        btns: [{ label: 'Relancer', type: 'submit', icon: 'mdi:refresh', color: 'primary', attrs: (item.status == 'running' or item.pending) ? { disabled: true } : {} }]
                    } %}
                </form>
                {% include 'layout/modern/components/_btns.html.twig' with {
                    removeContainer: true,
                    btns: [{ label: 'Retour', path: path('app_jobs_index'), icon: 'mdi:arrow-left', color: 'neutral' }]
                } %}
            </div>
        </header>

        <div class="ops-section">// ÉTAT</div>
        <section class="ops-card is-{{ item.status }}">
            <p class="ops-reason-line">{{ item.reason }}</p>
            <dl class="ops-facts">
                <div><dt>planification</dt><dd>{{ item.job.schedule ?? '—' }}</dd></div>
                <div><dt>commande</dt><dd><code>{{ item.job.command }}</code></dd></div>
                <div><dt>dernier début</dt><dd>{{ st.startedAt is defined ? (st.startedAt|job_dt) ~ ' · ' ~ (st.startedAt|job_ago) : '—' }}</dd></div>
                <div><dt>durée</dt><dd>{{ st.duration is defined ? st.duration|job_duration : '—' }}</dd></div>
                <div><dt>déclenchement</dt><dd>{{ st.trigger is defined ? (st.trigger == 'manual' ? 'manuel (relance)' : 'planifié (cron)') : '—' }}</dd></div>
                <div><dt>fichier produit</dt><dd>{% if st.artifact is defined and st.artifact %}<code>{{ st.artifact.name }}</code> · {{ st.artifact.size|job_size }}{% else %}—{% endif %}</dd></div>
            </dl>
        </section>

        {% if st.status is defined and st.status == 'failed' %}
            <div class="ops-section">// ERREUR</div>
            <section class="ops-card is-failed">
                <p class="ops-reason-line">{{ st.message }}</p>
                {% if log %}<pre class="ops-log">{{ log }}</pre>{% endif %}
            </section>
        {% elseif log %}
            <div class="ops-section">// SORTIE</div>
            <section class="ops-card"><pre class="ops-log">{{ log }}</pre></section>
        {% endif %}

        {% if item.job.artifact is defined %}
            <div class="ops-section">// TAILLE</div>
            <section class="ops-card">
                {% if spark %}
                    <svg class="ops-chart" viewBox="0 0 {{ spark.w }} {{ spark.h }}" preserveAspectRatio="none" role="img" aria-label="Évolution de la taille des sauvegardes">
                        <polygon points="{{ spark.area }}" class="ops-chart-area"/>
                        <polyline points="{{ spark.points }}" class="ops-chart-line"/>
                    </svg>
                    <p class="ops-muted">{{ spark.n }} sauvegardes · min {{ spark.min|job_size }} · max {{ spark.max|job_size }}</p>
                {% else %}
                    <p class="ops-muted">La courbe apparaîtra dès deux exécutions réussies.</p>
                {% endif %}
            </section>
        {% endif %}

        <div class="ops-section">// HISTORIQUE ({{ history|length }})</div>
        {% if history %}
            <div class="ops-table-wrap">
                <table class="ops-table">
                    <thead><tr><th>DÉBUT</th><th>STATUT</th><th>DURÉE</th><th>TAILLE</th><th>Δ</th><th>MESSAGE</th></tr></thead>
                    <tbody>
                    {% for row in history %}
                        {% set prev = history[loop.index] ?? null %}
                        {% set size = row.artifact.size ?? null %}
                        {% set psize = prev ? (prev.artifact.size ?? null) : null %}
                        <tr class="is-{{ row.status }}">
                            <td>{{ row.startedAt|job_dt }}</td>
                            <td>{% include 'sauvegarde/_badge.html.twig' with { status: row.status } %}</td>
                            <td>{{ row.duration is defined ? row.duration|job_duration : '—' }}</td>
                            <td>{{ size is not null ? size|job_size : '—' }}</td>
                            <td>{% if size and psize %}{% set d = (size - psize) / psize * 100 %}<span class="ops-delta {{ d <= -20 ? 'is-down' : '' }}">{{ d >= 0 ? '+' : '' }}{{ d|round(1)|replace({'.': ','}) }} %</span>{% else %}—{% endif %}</td>
                            <td class="ops-msg">{{ row.status == 'ok' ? '' : row.message }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="ops-muted">Aucune exécution enregistrée pour l'instant.</p>
        {% endif %}
    </div>
{% endblock %}
