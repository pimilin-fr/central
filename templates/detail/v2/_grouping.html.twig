<div class="mb-4 p-4">

    {# TITRE #}
    <div class="text-sm font-semibold text-gray-700 mb-3">
        Regrouper les opérations par
    </div>


    {# =========================
       DATE
       ========================= #}

    <div class="flex flex-wrap items-center gap-2 mb-2">

        <span class="w-20 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            Date
        </span>

        {% set periodOptions = {
            annee: 'Année',
            trimestre: 'Trimestre',
            mois: 'Mois',
            semaine: 'Semaine'
        } %}

        {% for key, label in periodOptions %}

            {% set queryParams = app.request.query.all|merge({
                groupBy: key
            }) %}

            <a
                href="{{ path(route, routeParams|merge(queryParams)) }}"
                class="
                    inline-flex items-center
                    px-3 py-1.5
                    rounded-md
                    text-sm font-medium
                    border
                    transition
                    {{ groupBy == key
                        ? 'bg-orange-500 text-white border-orange-500'
                        : 'bg-white text-gray-600 border-gray-300 hover:bg-gray-100'
                    }}
                "
            >
                {{ label }}
            </a>

        {% endfor %}

    </div>


    {# =========================
       ÉLÉMENT
       ========================= #}

    <div class="flex flex-wrap items-center gap-2">

        <span class="w-20 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            Élément
        </span>

        {% set elementOptions = {
            releve: 'Relevé',
            categorie: 'Catégorie',
            tiers: 'Tiers',
            projet: 'Projet'
        } %}

        {% for key, label in elementOptions %}

            {% set queryParams = app.request.query.all|merge({
                groupBy: key
            }) %}

            <a
                href="{{ path(route, routeParams|merge(queryParams)) }}"
                class="
                    inline-flex items-center
                    px-3 py-1.5
                    rounded-md
                    text-sm font-medium
                    border
                    transition
                    {{ groupBy == key
                        ? 'bg-orange-500 text-white border-orange-500'
                        : 'bg-white text-gray-600 border-gray-300 hover:bg-gray-100'
                    }}
                "
            >
                {{ label }}
            </a>

        {% endfor %}

    </div>

</div>