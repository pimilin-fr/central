{% extends 'base.html.twig' %}

{% block title %}Portefeuille - {{ entity.name }} {% endblock %}

{% block body %}        
    <div class="space-y-6">
        {# =========================
            HEADER : Titre + actions (modernisé)
            ========================= #}
        {% set btns = [
                {
                    label: "Suppr.",
                    path: path('app_portefeuille_delete', {id:entity.id}),
                    color: 'red',
                    icon: 'gridicons:trash'
                }, {
                    label: "Retour",
                    path: path('app_portefeuille_index'),
                    color: 'gray',
                    icon: 'mdi:arrow-left',
            }] %}


        {% include 'partials/header.html.twig' with {
            btns: btns,
            title: 'Portefeuille : '~entity.name,
            item: entity
        } %}

        {# =========================
        ONGLETS FONCTIONNELS
        ========================= #}
        {% set activeTab = app.request.query.get('tab') ?? 'summary' %}

        {% set tabs = [{
                id: 'summary',
                label: 'Résumé',
                content: include('detail/v2/_activite.html.twig',{
                    portefeuille: entity
                })
            }
        ] %}

        {#% set tabs = [
        {
            id: 'summary',
            label: 'Résumé',
            content: include('portefeuille/_activite.html.twig')
        },{
            id: 'edit',
            label: 'Modifier',
            icon: 'mdi:pencil',
            content: include('portefeuille/_form.html.twig')
        },{
            id: 'addoperation',
            label: 'Opération',
            icon: 'ic:round-add',
            content: include('depenses/_add_form.html.twig', {
                form: depensesForm
            })
        }
    ] %#}

        {% include 'partials/tabs.html.twig' with {
        tabs: tabs,
        activeTab: activeTab
    } %}
    </div>

{% endblock %}