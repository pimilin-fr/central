{#
    Cercle « stratégie de démo » : couleur + icône (plus de texte).
    Paramètre : entity (doit exposer demoStrategy).
    Générique : ne dépend que de --entity-color / --entity-text.
#}
{% set strategy = entity.demoStrategy.value ?? null %}

{% set mapping = {
    'copy':      { label: 'Copie',     icon: 'lucide:copy',          color: 'var(--info)',       ink: '#ffffff' },
    'anonymize': { label: 'Anonymisé', icon: 'lucide:venetian-mask', color: 'var(--warning)',    ink: '#2b1d02' },
    'exclude':   { label: 'Exclue',    icon: 'lucide:eye-off',       color: 'var(--danger)',     ink: '#ffffff' }
} %}

{% set item = mapping[strategy] ?? { label: 'Erreur', icon: 'lucide:circle-help', color: 'var(--text-muted)', ink: '#ffffff' } %}

<div class="summary-circle-wrap">
    <div class="entity-circle"
         style="--entity-color: {{ item.color }}; --entity-text: {{ item.ink }};"
         title="Stratégie de démo : {{ item.label }}"
         role="img"
         aria-label="Stratégie de démo : {{ item.label }}">
        <twig:ux:icon name="{{ item.icon }}" />
    </div>
    <span class="summary-circle-caption">{{ item.label }}</span>
</div>
