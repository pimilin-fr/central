{% extends 'modern.html.twig' %}

{% set breadcrumb_current = 'Paramètres' %}
{% block title %}Paramètres{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Paramètres</h1>
                <p class="page-subtitle">Réglages de l'application. Une valeur vide revient à la valeur par défaut.</p>
            </div>
        </div>

        <form method="post" action="{{ path('app_settings') }}" class="modern-form">
            <input type="hidden" name="_token" value="{{ csrf_token('app_settings') }}">

            {% for group, items in groups %}
                <section class="envp-card" style="margin-bottom:16px">
                    <h2>{{ group }}</h2>
                    {% for s in items %}
                        <div class="form-row" style="display:grid;grid-template-columns:minmax(220px,1fr) 160px;gap:6px 16px;align-items:center;padding:8px 0">
                            <label for="set-{{ s.field }}">
                                {{ s.label }}
                                {% if s.help %}<small style="display:block;color:var(--text-muted)">{{ s.help }}</small>{% endif %}
                            </label>
                            <span style="display:flex;gap:8px;align-items:center">
                                <input type="number" inputmode="decimal" step="{{ s.float ?? false ? 'any' : 1 }}" id="set-{{ s.field }}" name="{{ s.field }}" value="{{ s.value }}" min="{{ s.min }}" max="{{ s.max }}" placeholder="{{ s.default }}" style="width:110px">
                                <small style="color:var(--text-muted)">{{ s.unit }}{% if s.value != s.default %} · défaut {{ s.default }}{% endif %}</small>
                            </span>
                        </div>
                    {% endfor %}
                </section>
            {% endfor %}

            <div class="modern-form-footer">
                <span class="modern-form-footer-copy"></span>
                <button type="submit" name="reset" value="1" class="btn btn-neutral btn-sm" onclick="return confirm('Rétablir toutes les valeurs par défaut ?');">Valeurs par défaut</button>
                {% include 'layout/modern/components/_btns.html.twig' with {
                    btns: [{label: 'Enregistrer', type: 'submit', icon: 'material-symbols:save-rounded', color: 'primary'}]
                } %}
            </div>
        </form>
    </div>
{% endblock %}
