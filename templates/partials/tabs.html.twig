<div class="bg-white rounded-xl border shadow-sm"
     data-tabs
     data-default-tab="{{ activeTab ?? 'summary' }}">

    <div class="border-b px-5">
        <nav class="flex gap-6 text-sm font-medium text-gray-600">
            {% for tab in tabs %}
                <button
                    type="button"
                    class="tab-button py-2 px-4 border-b-4 flex items-center gap-2
                    {{ activeTab == tab.id
                            ? 'border-orange-500 text-orange-600'
                            : 'border-transparent text-gray-500 hover:text-gray-700' }}"
                    data-tab="{{ tab.id }}">

                    {# Icône (optionnelle) #}
                    {% if tab.icon is defined %}
                        {{ ux_icon(tab.icon, { class: 'w-4 h-4' }) }}
                    {% endif %}

                    {# Libellé #}
                    <span class="">{{ tab.label }}</span>

                    {# Pastille (optionnelle) #}
                    {% if tab.badge is defined %}
                        <span class="ml-1 inline-flex items-center justify-center
                              min-w-[1.25rem] h-5 px-1
                              text-xs font-bold text-white
                              bg-gray-500 rounded-full">
                            {{ tab.badge }}
                        </span>
                    {% endif %}
                </button>
            {% endfor %}
        </nav>
    </div>

    <div class="p-6 text-sm text-gray-500">
        {% for tab in tabs %}
            <div id="tab-{{ tab.id }}"
                 class="tab-content {{ activeTab != tab.id ? 'hidden' }}"

                 {% if tab.url is defined %}
                     data-url="{{ tab.url }}"
                     data-loaded="0"
                 {% endif %}
                 >

                {% if tab.content is defined %}
                    {{ tab.content|raw }}
                {% endif %}

            </div>
        {% endfor %}
    </div>
</div>
