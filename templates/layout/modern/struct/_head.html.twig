<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (() => {
            const themes = {{ themes|map(t => t.id)|json_encode|raw }};
            const savedTheme = localStorage.getItem('central-theme');
            document.documentElement.dataset.theme = themes.includes(savedTheme)
                    ? savedTheme
                    : themes[0];
        })();
    </script>

    <title>
        {% block appname %}Central{% endblock %} - {% block title %}Accueil{% endblock %}
    </title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>◈</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%2300c2ff%22>C</text></svg>"/>
    <link rel="stylesheet"  href="{{ asset('css/autocomplete.css') }}" />
    {# Un fichier CSS par thème, généré depuis le registre (templates/modern.html.twig) #}
    {% for theme in themes %}
        <link rel="stylesheet" href="{{ asset('css/themes/' ~ theme.id ~ '.css') }}?v=17" />
    {% endfor %}
    {# Palette d'entités calculée depuis l'accent du thème (après les thèmes) #}
    <link rel="stylesheet" href="{{ asset('css/palette.css') ~ '?v=5' }}" />
    <link rel="stylesheet" href="{{ asset('css/app.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/env.css') ~ '?v=1' }}" />
    <link rel="stylesheet" href="{{ asset('css/categories.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/forms.css')  }}" />
    <link rel="stylesheet" href="{{ asset('css/ui.css')  }}" />
    <link rel="stylesheet" href="{{ asset('css/detail.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/releve.css') ~ '?v=15' }}" />
    <link rel="stylesheet" href="{{ asset('css/prevision.css') ~ '?v=12' }}" />
    <link rel="stylesheet" href="{{ asset('css/entities.css')  }}" />
    <link rel="stylesheet" href="{{ asset('css/ui-kit.css') ~ '?v=3' }}" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    {% block importmap %}
        {{ importmap('app') }}
    {% endblock %}
    <script defer src="{{ asset('js/design.js') ~ '?v=14' }}"></script>
    <script defer src="{{ asset('js/env.js') ~ '?v=1' }}"></script>
    <script defer src="{{ asset('js/maps.js') ~ '?v=14' }}"></script>
    <script defer src="{{ asset('js/releve.js') ~ '?v=5' }}"></script>
    <script defer src="{{ asset('js/prevision.js') ~ '?v=5' }}"></script>
    <script defer src="{{ asset('js/app.js') ~ '?v=30' }}"></script>


    {% block stylesheets %}{% endblock %}
</head>
