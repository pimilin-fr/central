<aside id="central-sidebar" class="central-sidebar" data-sidebar>
    <div class="sidebar-header">
        <div class="sidebar-context">
            <span class="sidebar-context-indicator"></span>

            <div class="sidebar-context-copy">
                <span class="sidebar-context-label">Application</span>
                <span class="sidebar-context-name">Central</span>
            </div>
        </div>

        <button type="button" class="sidebar-collapse-button" 
                data-sidebar-toggle 
                aria-label="Réduire le menu"
                title="Réduire le menu"
        >
            <twig:ux:icon name="lucide:panel-left-close" />
        </button>
    </div>

    <div class="sidebar-separator"></div>

    <nav class="sidebar-nav">
        <div class="sidebar-section-label">Gestion</div>

        {# ____ Menu Tiers ____ #}
        <a href="{{ path('app_tiers_index') }}"
            class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_tiers_' or app.request.attributes.get('_route') starts with 'app_type_tiers_' ? 'is-active' : '' }}"
            title="Tiers"
        >
            <span class="sidebar-link-icon">
                <twig:ux:icon name="mage:users-fill" />
            </span>

            <span class="sidebar-link-label">
                Tiers
            </span>

            {% if app.request.attributes.get('_route') starts with 'app_tiers_' or app.request.attributes.get('_route') starts with 'app_type_tiers_' %}
                <span class="sidebar-link-active"></span>
            {% endif %}
        </a>

        {# ____ Menu Categories ____ #}
        <a href="{{ path('app_categorie_index') }}"
            class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_categorie_' ? 'is-active' : '' }}"
            title="Catégories"
        >
            <span class="sidebar-link-icon">
                <twig:ux:icon name="streamline-flex:search-category-solid" />
            </span>
            <span class="sidebar-link-label">
                Catégories
            </span>

            {% if app.request.attributes.get('_route') starts with 'app_categorie_' %}
                <span class="sidebar-link-active"></span>
            {% endif %}
        </a>

        {# ____ Menu Portefeuilles ____ #}
        <a href="{{ path('app_portefeuille_index') }}"
            class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_portefeuille_' ? 'is-active' : '' }}"
            title="Portefeuilles"
        >
            <span class="sidebar-link-icon">
                <twig:ux:icon name="solar:wallet-money-bold" />
            </span>
            <span class="sidebar-link-label">Portefeuilles</span>

            {% if app.request.attributes.get('_route') starts with 'app_portefeuille_' %}
                <span class="sidebar-link-active"></span>
            {% endif %}
        </a>

        {# ____ Menu Adresses ____ #}
        <a
            href="{{ path('app_adresse_index') }}"
            class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_adresse_' ? 'is-active' : '' }}"
            title="Adresses"
        >
            <span class="sidebar-link-icon">
                <twig:ux:icon name="entypo:address" />
            </span>
            <span class="sidebar-link-label">Adresses</span>

            {% if app.request.attributes.get('_route') starts with 'app_adresse_' %}
                <span class="sidebar-link-active"></span>
            {% endif %}
        </a>

        {# ____ Menu Projets ____ #}
        <a href="{{ path('app_projet_index') }}"
            class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_projet_' ? 'is-active' : '' }}"
            title="Projets"
        >
            <span class="sidebar-link-icon">
                <twig:ux:icon name="ix:project" />
            </span>
            <span class="sidebar-link-label">
                Projets
            </span>

            {% if app.request.attributes.get('_route') starts with 'app_projet_' %}
                <span class="sidebar-link-active"></span>
            {% endif %}
        </a>

        {# ____ Menu Depenses ____ #}
        <a href="{{ path('app_depenses_index') }}"
            class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_depenses_' ? 'is-active' : '' }}"
            title="Dépenses"
        >
            <span class="sidebar-link-icon">
                <twig:ux:icon name="healthicons:money-bag" />
            </span>
            <span class="sidebar-link-label">
                Dépenses
            </span>

            {% if app.request.attributes.get('_route') starts with 'app_depenses_' %}
                <span class="sidebar-link-active"></span>
            {% endif %}
        </a>
    </nav>

    <div class="sidebar-bottom">
        <div class="sidebar-bottom-card">
            <div class="sidebar-bottom-icon">
                <twig:ux:icon name="lucide:zap" />
            </div>

            <div class="sidebar-bottom-copy">
                <span>Central</span>
                <small>Finance</small>
            </div>

            <span class="sidebar-bottom-status"></span>
        </div>
    </div>
</aside>
