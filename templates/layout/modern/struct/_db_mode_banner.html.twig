{#
    Bandeau « DÉMO » affiché quand l'application tourne sur la base démo.
    Inclus une fois, juste après <body>, dans modern.html.twig.
    Retour à la production : menu en haut à droite (ou ./app prod).
#}
{% if app_db_mode() == 'demo' %}
    <div class="env-banner" role="status">
        <twig:ux:icon name="lucide:flask-conical" />
        Base de démonstration — données fictives, jetables
        <span class="env-banner-hint">retour à Central : menu en haut à droite</span>
    </div>
{% endif %}
