{% set ctx = app.request.attributes.get('_route') starts with 'app_jobs_' ? 'sauvegardes' : 'central' %}
{% set jsum = app_jobs_summary() %}
<div class="app-switcher" data-app-switcher>
    <button type="button" class="app-switcher-trigger" data-app-switcher-toggle aria-expanded="false" aria-haspopup="true" aria-label="Changer d'application">
        <span class="app-logo" aria-hidden="true">
            {% if ctx == 'sauvegardes' %}<twig:ux:icon name="mdi:backup-restore" />{% else %}<twig:ux:icon name="streamline:bank-solid" />{% endif %}
        </span>
        <span class="app-switcher-trigger-copy">
            <span class="app-switcher-kicker">Application</span>
            <span class="app-switcher-title">{{ ctx == 'sauvegardes' ? 'Sauvegardes' : 'Central' }}</span>
        </span>
        <twig:ux:icon name="lucide:chevrons-up-down" class="app-switcher-chevron" />
    </button>

    <div class="app-switcher-menu" aria-hidden="true">
        <div class="app-switcher-menu-header">
            <span>Applications</span>
            <small>Changer d'espace</small>
        </div>

        <div class="app-switcher-list">
            <a href="{{ path('app_home') }}" class="app-switcher-item">
                <span class="app-switcher-icon"><twig:ux:icon name="lucide:layout-grid" /></span>
                <span class="app-switcher-copy">
                    <span class="app-switcher-name">Accueil</span>
                    <span class="app-switcher-status">Toutes les applications</span>
                </span>
            </a>

            {# App. Centrale #}
            <a href="{{ path('app_tiers_index') }}" class="app-switcher-item{{ ctx == 'central' ? ' is-active' : '' }}">
                <span class="app-switcher-icon"><twig:ux:icon name="streamline:bank-solid" /></span>
                <span class="app-switcher-copy">
                    <span class="app-switcher-name">Central</span>
                    <span class="app-switcher-status">Gestion financière</span>
                </span>
                {% if ctx == 'central' %}<span class="app-switcher-active"></span>{% endif %}
            </a>

            {# milecube : application autonome (autre projet sur le Pi, hors du sous-chemin /central) #}
            <a href="/milecube/" class="app-switcher-item">
                <span class="app-switcher-icon"><twig:ux:icon name="grommet-icons:cubes" /></span>
                <span class="app-switcher-copy">
                    <span class="app-switcher-name">milecube</span>
                    <span class="app-switcher-status">Application de proto · jeux</span>
                </span>
            </a>

            {# App. Domotique #}
            <button type="button" class="app-switcher-item" disabled>
                <span class="app-switcher-icon"><twig:ux:icon name="mdi:home-automation" /></span>
                <span class="app-switcher-copy">
                    <span class="app-switcher-name">Dominique</span>
                    <span class="app-switcher-status">Domotique</span>
                </span>
                <span class="app-switcher-off">OFF</span>
            </button>

            {# Sauvegardes : suivi des tâches planifiées du Pi (indicateur = pire statut) #}
            <a href="{{ path('app_jobs_index') }}" class="app-switcher-item{{ ctx == 'sauvegardes' ? ' is-active' : '' }}">
                <span class="app-switcher-icon"><twig:ux:icon name="mdi:backup-restore" /></span>
                <span class="app-switcher-copy">
                    <span class="app-switcher-name">Sauvegardes</span>
                    <span class="app-switcher-status">{{ jsum.label }}</span>
                </span>
                {% if jsum.level != 'none' %}<span class="jobs-dot is-{{ jsum.level }}" aria-hidden="true"></span>{% endif %}
                {% if ctx == 'sauvegardes' %}<span class="app-switcher-active"></span>{% endif %}
            </a>

            {# Base #}
            <button type="button" class="app-switcher-item" disabled>
                <span class="app-switcher-icon"><twig:ux:icon name="mdi:database-outline" /></span>
                <span class="app-switcher-copy">
                    <span class="app-switcher-name">Base</span>
                    <span class="app-switcher-status">phpMyAdmin</span>
                </span>
                <span class="app-switcher-off">OFF</span>
            </button>
        </div>
    </div>
</div>