<header class="app-topbar">
    <div class="topbar-left">

        <button type="button" class="topbar-menu-button" data-mobile-sidebar-toggle aria-label="Ouvrir le menu" title="Menu">
            <twig:ux:icon name="lucide:menu"/>
        </button>

        {# =========================================================
           APPLICATION SWITCHER
           ========================================================= #}
        {% include 'layout/modern/struct/_app_switcher.html.twig' %}

        <div class="topbar-breadcrumb">
            <span class="topbar-breadcrumb-root">Central</span>
            <span class="topbar-breadcrumb-separator"> / </span>

            <span class="topbar-breadcrumb-current">
                {% block topbar_title %}
                    {% if app.request.attributes.get('_route') starts with 'app_tiers_' %}
                        Tiers
                    {% elseif app.request.attributes.get('_route') starts with 'app_type_tiers_' %}
                        Types de tiers
                    {% elseif app.request.attributes.get('_route') starts with 'app_categorie_' %}
                        Catégories
                    {% elseif app.request.attributes.get('_route') starts with 'app_portefeuille_' %}
                        Portefeuilles
                    {% elseif app.request.attributes.get('_route') starts with 'app_adresse_' %}
                        Adresses
                    {% elseif app.request.attributes.get('_route') starts with 'app_projet_' %}
                        Projets
                    {% elseif app.request.attributes.get('_route') starts with 'app_depenses_' %}
                        Dépenses
                    {% else %}
                        Tableau de bord
                    {% endif %}
                {% endblock %}
            </span>
        </div>
    </div>

    <div class="topbar-right">

        {# =========================================================
           THÈME
           ========================================================= #}
        <button type="button" class="topbar-icon-button" data-theme-toggle aria-label="Changer de thème"title="Changer de thème">
            <twig:ux:icon name="lucide:sun" class="theme-icon-light"/>
            <twig:ux:icon name="lucide:moon" class="theme-icon-dark"/>
        </button>

        <div class="topbar-divider"></div>

        {# =========================================================
           PROFIL
           ========================================================= #}
        <button type="button" class="topbar-user" title="Profil">
            <span class="topbar-user-avatar">C</span>

            <span class="topbar-user-copy">
                <span class="topbar-user-name">Central</span>
                <span class="topbar-user-status">Connecté</span>
            </span>

            <twig:ux:icon
                name="lucide:chevron-down"
                class="topbar-user-chevron"
                />
        </button>
    </div>


</header>

