<header class="app-topbar">
    <div class="topbar-left">
        <button type="button" class="topbar-menu-button" 
                data-mobile-sidebar-toggle
                aria-label="Ouvrir le menu"
                >
            <twig:ux:icon name="lucide:menu" />
        </button>

        <div class="topbar-breadcrumb">
            <span class="topbar-breadcrumb-root">Central</span>
            <span class="topbar-breadcrumb-separator">/</span>
            <span class="topbar-breadcrumb-current">
                {% block topbar_title %}
                    {% if app.request.attributes.get('_route') starts with 'app_tiers_' %}
                        Tiers
                    {% else %}
                        Tableau de bord
                    {% endif %}
                {% endblock %}
            </span>
        </div>
    </div>

    <div class="topbar-right">
        <button type="button" class="topbar-icon-button"
            data-theme-toggle
            aria-label="Changer de thème"
            title="Changer de thème"
            >
            <twig:ux:icon name="lucide:sun" class="theme-icon-light"/>
            <twig:ux:icon name="lucide:moon" class="theme-icon-dark"/>
        </button>

        <div class="topbar-divider"></div>

        <button type="button" class="topbar-user" title="Profil" >
            <span class="topbar-user-avatar">C</span>

            <span class="topbar-user-copy">
                <span class="topbar-user-name">Central</span>
                <span class="topbar-user-status">Connecté</span>
            </span>

            <twig:ux:icon name="lucide:chevron-down" class="topbar-user-chevron"/>
        </button>
    </div>
</header>
