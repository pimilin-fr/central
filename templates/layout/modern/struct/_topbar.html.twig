<header class="app-topbar">
    <div class="topbar-left">
        <button type="button" class="topbar-menu-button" data-mobile-sidebar-toggle aria-label="Ouvrir le menu">
            <twig:ux:icon name="lucide:menu" />
        </button>

        {% include 'layout/modern/struct/_app_switcher.html.twig' %}

        {#
            Fil d'Ariane.
            Les pages peuvent poser (au niveau racine du template enfant) :
              - breadcrumb_current : libellé de la page (nom de l'objet, « Nouveau tiers »…)
              - breadcrumb_trail   : étapes intermédiaires [{ label, path }]
            Sans breadcrumb_current, seule la section est affichée.
        #}
        {% set route = app.request.attributes.get('_route') %}
        {% set sections = [
            { prefixes: ['app_tiers_', 'app_type_tiers_'], label: 'Tiers',        route: 'app_tiers_index' },
            { prefixes: ['app_categorie_'],                label: 'Catégories',   route: 'app_categorie_index' },
            { prefixes: ['app_portefeuille_'],             label: 'Portefeuilles', route: 'app_portefeuille_index' },
            { prefixes: ['app_adresse_'],                  label: 'Adresses',     route: 'app_adresse_index' },
            { prefixes: ['app_projet_'],                   label: 'Projets',      route: 'app_projet_index' },
            { prefixes: ['app_depenses_'],                 label: 'Dépenses',     route: 'app_depenses_index' },
            { prefixes: ['app_styleguide'],                label: 'Styleguide',   route: 'app_styleguide' }
        ] %}
        {% set section = null %}
        {% for candidate in sections %}
            {% for prefix in candidate.prefixes %}
                {% if section is null and route starts with prefix %}
                    {% set section = candidate %}
                {% endif %}
            {% endfor %}
        {% endfor %}

        <nav class="topbar-breadcrumb" aria-label="Fil d'Ariane">
            <span class="topbar-breadcrumb-root">Central</span>

            {% if section is null %}
                <span class="topbar-breadcrumb-separator">/</span>
                <span class="topbar-breadcrumb-current">Tableau de bord</span>
            {% elseif breadcrumb_current is defined and breadcrumb_current %}
                <span class="topbar-breadcrumb-separator">/</span>
                <a class="topbar-breadcrumb-link" href="{{ path(section.route) }}">{{ section.label }}</a>

                {% for step in breadcrumb_trail ?? [] %}
                    <span class="topbar-breadcrumb-separator">/</span>
                    {% if step.path is defined and step.path %}
                        <a class="topbar-breadcrumb-link" href="{{ step.path }}">{{ step.label }}</a>
                    {% else %}
                        <span class="topbar-breadcrumb-link">{{ step.label }}</span>
                    {% endif %}
                {% endfor %}

                <span class="topbar-breadcrumb-separator">/</span>
                <span class="topbar-breadcrumb-current" aria-current="page" title="{{ breadcrumb_current }}">{{ breadcrumb_current }}</span>
            {% else %}
                <span class="topbar-breadcrumb-separator">/</span>
                <span class="topbar-breadcrumb-current" aria-current="page">{{ section.label }}</span>
            {% endif %}
        </nav>
    </div>

    <div class="topbar-right">
        <div class="theme-switcher" data-theme-switcher>
            <button type="button" class="topbar-icon-button theme-switcher-trigger" data-theme-menu-toggle aria-expanded="false" aria-haspopup="true" aria-label="Changer de thème" title="Changer de thème">
                <span class="theme-current-mark" aria-hidden="true"></span>
                <span class="theme-current-name" data-theme-current-name>{{ (themes|first).label }}</span>
                <twig:ux:icon name="lucide:chevron-down" class="theme-switcher-chevron" />
            </button>

            <div class="theme-menu" data-theme-menu aria-hidden="true" role="menu">
                <div class="theme-menu-header">
                    <span class="theme-menu-title">Apparence</span>
                    <span class="theme-menu-subtitle">Choisissez votre ambiance</span>
                </div>

                {% for theme in themes %}
                    <button type="button" class="theme-option" data-theme-option="{{ theme.id }}" data-theme-label="{{ theme.label }}" aria-checked="false">
                        <span class="theme-option-preview" data-theme="{{ theme.id }}"><span></span></span>
                        <span class="theme-option-copy"><strong>{{ theme.label }}</strong><small>{{ theme.hint }}</small></span>
                        <span class="theme-option-check"><twig:ux:icon name="lucide:check" /></span>
                    </button>
                {% endfor %}
            </div>
        </div>

        <div class="topbar-divider"></div>

        <button type="button" class="topbar-user" title="Profil">
            <span class="topbar-user-avatar">C</span>
            <span class="topbar-user-copy">
                <span class="topbar-user-name">Central</span>
                <span class="topbar-user-status">Connecté</span>
            </span>
            <twig:ux:icon name="lucide:chevron-down" class="topbar-user-chevron" />
        </button>
    </div>
</header>
