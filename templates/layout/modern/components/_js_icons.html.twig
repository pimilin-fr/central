{#
    Icônes et boutons à disposition du JavaScript (éléments fabriqués côté navigateur : relevé, prévisions, notifications…).
    Un <template> n'est pas affiché : public/js/icons.js en lit le contenu par son nom.
      - CentralIcons.get('close')        le SVG d'une icône ;
      - CentralIcons.button('rc-up')     le bouton complet, rendu par le composant _btns (donc identique à ceux des templates).
    Pour un nouveau nom : ajouter une ligne ici, rien d'autre.
#}
<template id="central-icons">
    <span data-icon="close"><twig:ux:icon name="mdi:close-box" /></span>
    <span data-icon="check"><twig:ux:icon name="formkit:check" /></span>
    <span data-icon="up"><twig:ux:icon name="fa7-solid:sort-up" /></span>
    <span data-icon="down"><twig:ux:icon name="fa7-solid:sort-down" /></span>
    <span data-icon="move"><twig:ux:icon name="ic:outline-move-up" /></span>
    <span data-icon="group"><twig:ux:icon name="material-symbols:stack-group" /></span>
    <span data-icon="cut"><twig:ux:icon name="fa-solid:cut" /></span>
    <span data-icon="add"><twig:ux:icon name="gridicons:add" /></span>
</template>

<template id="central-btns">
    {% set js_btns = [
        { name: 'rc-bring', label: 'Placer après la dernière ligne pointée', title: 'Placer cette ligne juste après la dernière ligne pointée (en premier si aucune n\'est pointée)', icon: 'ic:outline-move-up', attrs: { 'data-rc-bring': true } },
        { name: 'rc-up', label: 'Monter', icon: 'fa7-solid:sort-up', attrs: { 'data-rc-up': true } },
        { name: 'rc-down', label: 'Descendre', icon: 'fa7-solid:sort-down', attrs: { 'data-rc-down': true } },
        { name: 'rc-split', label: 'Dégrouper', title: 'Dégrouper : une ligne par opération', icon: 'material-symbols:stack-group', attrs: { 'data-rc-split': true } },
        { name: 'rc-remove-line', label: 'Retirer la ligne', title: 'Retirer la ligne du relevé', icon: 'mdi:close-box', attrs: { 'data-rc-remove-line': true } },
        { name: 'pv-remove', label: 'Retirer ce montant', icon: 'mdi:close-box', color: 'ghost', class: 'is-danger', attrs: { 'data-pv-remove': true } }
    ] %}
    {% for b in js_btns %}
        <div data-btn="{{ b.name }}">
            {% include 'layout/modern/components/_btns.html.twig' with {
                removeContainer: true,
                btns: [{
                    type: 'button',
                    iconOnly: true,
                    label: b.label,
                    title: b.title ?? b.label,
                    icon: b.icon,
                    color: b.color ?? 'neutral',
                    class: b.class ?? '',
                    attrs: b.attrs
                }]
            } %}
        </div>
    {% endfor %}
</template>
