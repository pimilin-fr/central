{#
    Sélecteur de couleur d'entité (champ EntityColorType).
      - Par défaut : accent du thème (valeur vide)
      - Libre      : couleur figée (#rrggbb), non liée au thème
      - Familles   : chaque famille = 5 nuances, de la plus FONCÉE (gauche) à la plus CLAIRE (droite)
          « Couleurs du thème » : accent, info, succès, alerte, danger, neutre (« @a1 » … « @n5 »)
          « Autres teintes »    : 5 teintes décalées depuis l'accent (« @h60-1 » … « @h300-5 »)
    Tout ce qui est « du thème » suit le changement de thème.
    La valeur réelle est dans le champ masqué ; public/js/app.js (colorPicker) le pilote.
#}
{% set raw = field.vars.value|default('') %}
{% set isHex = raw matches '/^#[0-9A-Fa-f]{6}$/' %}
{% set isSlot = raw != '' and not isHex %}

<div class="color-picker" data-color-picker>
    {{ form_widget(field, { type: 'hidden' }) }}

    <div class="color-picker-top" role="group" aria-label="Couleur par défaut ou libre">
        <button type="button" class="color-swatch is-default {{ raw == '' ? 'is-selected' : '' }}"
                data-value="" style="--sw: var(--accent)"
                title="Par défaut (accent du thème)" aria-label="Par défaut"></button>
        <span class="color-picker-option">Par défaut</span>

        <label class="color-swatch is-custom {{ isHex ? 'is-selected' : '' }}"
               style="--sw: {{ isHex ? raw : 'transparent' }}"
               title="Couleur libre (ne suit pas le thème)">
            <input type="color" value="{{ isHex ? raw : '#808080' }}" data-color-custom aria-label="Couleur libre">
        </label>
        <span class="color-picker-option">Couleur libre</span>
    </div>

    {% for group in entity_color_families() %}
        <div class="color-picker-group">
            <p class="color-picker-group-title">{{ group.title }}</p>
            <div class="color-picker-families">
                {% for family in group.families %}
                    <div class="color-family">
                        <span class="color-family-label">{{ family.label }}</span>
                        <div class="color-family-strip" role="group" aria-label="{{ family.label }}, du plus foncé au plus clair">
                            {% for shade in family.shades %}
                                <button type="button" class="color-swatch {{ raw == shade.value ? 'is-selected' : '' }}"
                                        data-value="{{ shade.value }}" style="--sw: {{ shade.var }}"
                                        title="{{ shade.label }}" aria-label="{{ shade.label }}"></button>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    <p class="color-picker-scale" aria-hidden="true">Chaque ligne va du plus foncé (gauche) au plus clair (droite).</p>

    <p class="color-picker-hint" data-color-hint>
        {% if isHex %}Couleur libre : elle ne change pas avec le thème.
        {% elseif isSlot %}Couleur du thème : elle s'adapte au thème choisi.
        {% else %}Par défaut : accent du thème.{% endif %}
    </p>
</div>
