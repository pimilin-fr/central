{% extends 'modern.html.twig' %}

{% block title %}Vérification du kit UI{% endblock %}

{#
    TEMPORAIRE — vérification du chantier « kit UI ».
    À chaque étape : (1) compléter const STEPS dans public/js/verification.js (contrôles automatiques),
    (2) remplacer la liste « À vérifier à l'œil » ci-dessous. Chaque ligne a un VRAI lien, construit par
    StyleguideController::verification() sur des enregistrements existants (lecture seule).
    Suppression en fin de chantier : voir StyleguideController.
#}
{% set breadcrumb_current = 'Vérification' %}

{% set pages = [
    { label: 'Portefeuilles', url: path('app_portefeuille_index') },
    { label: 'Tous les relevés', url: path('app_releve_all') },
    { label: 'Prévisions', url: path('app_prevision_index') },
    { label: 'Suggestions de prévisions', url: path('app_prevision_suggestions') },
    { label: 'Tiers', url: path('app_tiers_index') },
    { label: 'Adresses', url: path('app_adresse_index') },
    { label: 'Catégories', url: path('app_categorie_index') },
    { label: 'Types de tiers', url: path('app_type_tiers_index') },
    { label: 'Projets', url: path('app_projet_index') },
    { label: 'Types de projet', url: path('app_projet_type_index') },
    { label: 'Nouveau tiers', url: path('app_tiers_new') },
    { label: 'Nouveau projet', url: path('app_projet_new') },
    { label: 'Nouvelle adresse', url: path('app_adresse_new') },
    { label: 'Nouvelle règle de prévision', url: path('app_prevision_new') },
    { label: 'Styleguide', url: path('app_styleguide') }
] %}
{% set urlPtf = ptf ? path('app_portefeuille_show', { id: ptf.id }) : null %}
{% set urlPtfPrev = ptf ? path('app_portefeuille_show', { id: ptf.id, tab: 'prevision' }) : null %}
{% set urlComposer = (ptf and releve) ? path('app_releve_compose', { id: ptf.id, releve: releve.id }) : null %}
{% set urlTiers = tiers ? path('app_tiers_show', { id: tiers.id }) : null %}
{% set urlProjet = projet ? path('app_projet_show', { id: projet.id }) : null %}
{% set urlCat = categorie ? path('app_categorie_show', { id: categorie.id }) : null %}
{% set urlAdr = adresse ? path('app_adresse_show', { id: adresse.id }) : null %}
{% set pages = pages|merge([urlPtf, urlPtfPrev, urlComposer, urlTiers, urlProjet, urlCat, urlAdr]|filter(u => u)|map(u => { label: u, url: u })) %}

{# Liste « à l'œil » de l'étape en cours : [texte, url] — url nulle = enregistrement inexistant #}
{% set manual = [
    ['Fiche portefeuille : en-têtes des groupes d’opérations (barre cliquable, survol grisé, clic = déplier)', urlPtf],
    ['Fiche portefeuille : changer « Regrouper par » (Mois, Relevé…) — en-têtes et sous-groupes de relevé identiques à avant', urlPtf],
    ['Fiche portefeuille, onglet Prévision : titres de période, chiffres à droite', urlPtfPrev],
    ['Composeur de relevé : en-têtes « Relevé » et « À pointer » (titre, compteur, boutons à droite)', urlComposer],
    ['Tous les relevés : en-tête du panneau', path('app_releve_all')],
    ['Prévisions : « Règles » replié (flèche, nombre de règles actives) puis « Période en cours » (titre plus grand, totaux à droite)', path('app_prevision_index')],
    ['Prévisions : bouton « Afficher les mois suivants » puis titres des mois (majuscule initiale)', path('app_prevision_index')],
    ['Suggestions : « Récurrences repérées » et « Non retenues » (compteur dans l’en-tête)', path('app_prevision_suggestions')],
    ['Fiche tiers : les groupes d’opérations s’affichent comme avant', urlTiers],
    ['Fiche projet : idem', urlProjet],
    ['Fiche catégorie (arbre) : INCHANGÉE — son en-tête de branche garde son style propre', urlCat],
    ['Styleguide › Structure : nouvel exemple « En-têtes de bloc »', path('app_styleguide') ~ '#structure'],
    ['Styleguide › Listes et Écran du relevé : en-têtes conformes', path('app_styleguide') ~ '#listes']
] %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('css/styleguide.css') }}?v=2">
    <div class="page-container" id="vf" data-sources="{{ path('app_styleguide_verification_sources') }}"
         data-pages='{{ pages|json_encode|e('html_attr') }}'
         data-scripts='{{ [asset('js/app.js'), asset('js/releve.js'), asset('js/prevision.js')]|json_encode|e('html_attr') }}'>

        <div class="page-heading">
            <div class="page-heading-copy">
                <h1 class="page-title">Vérification du kit UI <span class="pill pill-accent">temporaire</span></h1>
                <p>Étape en cours : <strong>3a — en-têtes de bloc</strong>. Contrôles automatiques sur vos vraies pages, puis liste à vérifier à l'œil.</p>
            </div>
            <div class="page-heading-actions">
                <button type="button" class="btn btn-primary" data-vf-run><twig:ux:icon name="lucide:play" /><span>Lancer les contrôles</span></button>
            </div>
        </div>

        <section class="rc-panel" style="margin-bottom:16px">
            <div class="block-head"><h2>Contrôles automatiques <span class="pill pill-solid" data-vf-score>–</span></h2></div>
            <div data-vf-results><p class="pv-range">Cliquez sur « Lancer les contrôles » : {{ pages|length }} pages sont lues (liens ci-dessous pour les ouvrir).</p></div>
        </section>

        <section class="rc-panel" style="margin-bottom:16px">
            <div class="block-head"><h2>Classes utilisées mais sans aucun style</h2></div>
            <p class="pv-range">Présentes dans le HTML ou le JS mais absentes de toutes les feuilles de style. Certaines sont normales (accroches JS, états posés par script) ; en rouge : celles qui ressemblent à du Tailwind.</p>
            <div data-vf-undef><p class="pv-range">—</p></div>
        </section>

        <section class="rc-panel" style="margin-bottom:16px">
            <div class="block-head"><h2>À vérifier à l'œil — étape 3a</h2></div>
            <p class="pv-range">Changements attendus : titres de période un peu plus petits ou plus grands selon l'écran (17px), écarts d'en-têtes homogènes (8/16px). Le reste doit être identique. Les liens ouvrent de vrais enregistrements, en lecture seule.</p>
            {% for item in manual %}
                <label style="display:flex;gap:8px;align-items:baseline;padding:3px 0">
                    <input type="checkbox" data-vf-check="e3a-{{ loop.index }}">
                    <span>{{ item[0] }}
                        {% if item[1] %} — <a class="btn-link" href="{{ item[1] }}" target="_blank" rel="noopener">ouvrir</a>
                        {% else %} — <em class="pv-range">aucun enregistrement : lien indisponible</em>{% endif %}
                    </span>
                </label>
            {% endfor %}
        </section>

        <section class="rc-panel">
            <div class="block-head"><h2>Pages lues par les contrôles <span class="pill pill-solid">{{ pages|length }}</span></h2></div>
            <p>{% for p in pages %}<a class="btn-link is-muted" href="{{ p.url }}" target="_blank" rel="noopener" style="margin-right:12px">{{ p.label }}</a>{% endfor %}</p>
        </section>
    </div>
    <script src="{{ asset('js/verification.js') }}?v=6" defer></script>
{% endblock %}
