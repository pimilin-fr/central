{% import 'styleguide/_ex.html.twig' as sg %}

<p class="sg-sub">Mois / période</p>
{% set code %}{% verbatim %}
<section class="rc-panel pv-month">
    <header class="pv-month-head">
        <h3>Période en cours <span class="pv-range">du 06/10 au 05/11/2026 · fin estimée</span></h3>
        <span class="pv-month-sums">3 à venir · Prévu : <strong>− 96,30 €</strong> · pondéré : <strong>− 84,10 €</strong></span>
    </header>
    <div class="rc-table-wrap"><table class="ops-table"><tbody>
        <tr class="ops-row">
            <td>12/10</td>
            <td><a class="ops-group-link" href="#">Abonnement internet</a><div class="pv-range">Free · Compte courant</div></td>
            <td><span class="pill pill-success">Certain</span></td>
            <td class="amount-expense">− 39,99 €</td>
            <td>
                <form class="pv-concretise" onsubmit="return false">
                    <label><span class="pv-range">Date réelle</span><input type="date" class="modern-form-control" value="2026-10-12"></label>
                    <label><span class="pv-range">Montant réel (€)</span><input type="text" class="modern-form-control" value="39.99"></label>
                    <button type="submit" class="btn btn-primary">Concrétiser</button>
                </form>
            </td>
            <td><div class="pv-actions"><button type="button" class="btn-link is-muted">Ajuster</button><button type="button" class="btn-link is-muted">Ignorer</button></div></td>
        </tr>
    </tbody></table></div>
</section>
<details class="pv-more"><summary class="btn">Afficher les mois suivants <span class="pv-range">(2)</span></summary></details>
{% endverbatim %}{% endset %}
{{ sg.ex('pv-month, pv-concretise, pv-more', code, 'Une période va d\'un relevé de compte au suivant. « Concrétiser » = date et montant réels, pré-remplis avec la prévision.') }}

<p class="sg-sub">Règles (repliées)</p>
{% set code %}{% verbatim %}
<details class="rc-panel pv-rules">
    <summary class="rc-panel-head"><h2>Règles <span class="pill pill-solid">9 actives</span> <span class="pv-range">· 2 inactive(s)</span></h2></summary>
    <div class="rc-table-wrap"><table class="ops-table">
        <thead><tr><th>Règle</th><th>Rythme</th><th>Certitude</th><th>Montants</th></tr></thead>
        <tbody><tr class="ops-row">
            <td><a class="ops-group-link" href="#">Abonnement internet</a><div class="pv-range">Free · Compte courant</div></td>
            <td>Mensuel, le 12</td>
            <td><span class="pill pill-success">Certain</span></td>
            <td>39,99 €<span class="pv-range"> dès le 01/01/2026</span></td>
        </tr></tbody>
    </table></div>
</details>
{% endverbatim %}{% endset %}
{{ sg.ex('pv-rules', code, 'Panneau repliable : <code>&lt;details&gt;</code> natif, le titre porte le nombre de règles actives.') }}

<p class="sg-sub">Cartes d'échéance (panneau latéral)</p>
{% set code %}{% verbatim %}
<ul class="pv-cards" style="list-style: none; margin: 0; padding: 0; max-width: 420px">
    <li class="pv-card">
        <div class="pv-card-top"><span class="pv-card-date">12/10</span><strong class="amount-expense">− 39,99 €</strong></div>
        <div class="pv-card-title"><a class="ops-group-link" href="#">Abonnement internet</a><span class="pill pill-success">Certain</span></div>
        <div class="pv-range">Free</div>
        <form class="pv-concretise" onsubmit="return false">
            <label><span class="pv-range">Date réelle</span><input type="date" class="modern-form-control" value="2026-10-12"></label>
            <label><span class="pv-range">Montant réel (€)</span><input type="text" class="modern-form-control" value="39.99"></label>
            <button type="submit" class="btn btn-primary">Concrétiser</button>
        </form>
    </li>
    <li class="pv-card is-late">
        <div class="pv-card-top"><span class="pv-card-date pv-late">02/10 · retard</span><strong class="amount-expense">− 120,00 €</strong></div>
        <div class="pv-card-title"><a class="ops-group-link" href="#">Électricité</a><span class="pill pill-muted">Estimé</span></div>
        <div class="pv-range">EDF · entre 90,00 et 150,00 €</div>
    </li>
</ul>
{% endverbatim %}{% endset %}
{{ sg.ex('pv-card', code, '<code>is-late</code> = date dépassée (liseré rouge). La même carte sert dans le panneau du portefeuille et dans le relevé (bouton « Ajouter au relevé »).') }}

<p class="sg-sub">Panneau latéral rétractable</p>
{% set code %}{% verbatim %}
<div style="position: relative; height: 270px; overflow: hidden">
    <aside class="pv-drawer is-open" style="position: absolute; top: 0; right: 0; transform: none">
        <button type="button" class="pv-drawer-handle" aria-expanded="true" title="Prochaines échéances" style="top: .5rem">
            <twig:ux:icon name="lucide:calendar-clock" />
            <span class="pv-drawer-count">4</span>
            <span class="pv-drawer-sum amount-expense">−240 €</span>
            <span class="pv-drawer-late" title="1 en retard">!</span>
        </button>
        <div class="pv-drawer-panel">
            <header class="pv-drawer-head">
                <div><h2>Prochaines échéances</h2><p class="pv-range">4 · net <strong class="amount-expense">− 240,00 €</strong></p></div>
                <button type="button" class="btn btn-icon btn-ghost is-danger" title="Replier">✕</button>
            </header>
            <ul class="pv-cards" style="list-style: none; margin: 0; padding: 10px">
                <li class="pv-card"><div class="pv-card-top"><span class="pv-card-date">12/10</span><strong class="amount-expense">− 39,99 €</strong></div><div class="pv-card-title"><a class="ops-group-link" href="#">Abonnement internet</a><span class="pill pill-success">Certain</span></div></li>
            </ul>
        </div>
    </aside>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('pv-drawer', code, 'Panneau fixe au bord droit, languette à mi-hauteur (compteur, montant net, « ! » si retard). Ici simulé dans un cadre ; ouverture/fermeture : <code>prevision.js</code>, état mémorisé dans le navigateur.', 'sg-frame') }}

<p class="sg-sub">Formulaire de règle : tranches</p>
{% set code %}{% verbatim %}
<div class="pv-tranches">
    <div class="pv-tranche">
        <div><label class="modern-form-label">À partir du</label><input type="date" class="modern-form-control" value="2026-01-01"></div>
        <div><label class="modern-form-label">Montant</label><input class="modern-form-control" value="39.99"></div>
        <div><label class="modern-form-label">Min</label><input class="modern-form-control"></div>
        <button type="button" class="btn btn-icon btn-ghost is-danger" title="Retirer la tranche">✕</button>
    </div>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('pv-tranches', code, 'Une règle peut avoir plusieurs tranches (ex. un loyer qui change à une date donnée).') }}
