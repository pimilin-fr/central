{% import 'styleguide/_ex.html.twig' as sg %}

<p class="sg-sub">Repères du relevé</p>
{% set code %}{% verbatim %}
<div class="rc-recap">
    <div class="rc-recap-item"><span class="rc-recap-label">Relevé précédent</span><strong><a href="#">05/10/2026</a> <span class="ops-group-badge is-closed">Clos</span></strong></div>
    <div class="rc-recap-item"><span class="rc-recap-label">Montant du précédent <small>(mouvement)</small></span><strong class="amount-expense">− 154,60 €</strong></div>
    <div class="rc-recap-item"><span class="rc-recap-label">Solde cumulé avant ce relevé</span><strong>1 250,00 €</strong></div>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('rc-recap', code) }}

<p class="sg-sub">Panneaux, en-tête et progression</p>
{% set code %}{% verbatim %}
<section class="rc-panel">
    <header class="block-head">
        <h2>Relevé <span class="pill pill-solid">4</span> <small>6 opérations</small></h2>
        <div class="rc-progress">
            <span class="rc-progress-text">2 / 4 pointées</span>
            <span class="rc-bar" aria-hidden="true"><i style="width: 50%"></i></span>
            <button type="button" class="btn-link">Tout pointer</button>
            <button type="button" class="btn-link" aria-pressed="false">Masquer les pointées</button>
        </div>
        <div class="rc-sorts" role="group">
            <button type="button" class="btn btn-icon" title="Du plus ancien au plus récent">↑</button>
            <button type="button" class="btn btn-icon" title="Du plus récent au plus ancien">↓</button>
        </div>
    </header>
    <div class="rc-selsum"><span>2 lignes cochées : − 72,50 €</span>
        <span class="rc-selsum-actions">
            <button type="button" class="btn btn-primary"><twig:ux:icon name="lucide:layers" /><span>Regrouper</span></button>
            <button type="button" class="btn-link">Désélectionner</button>
        </span>
    </div>
    <p class="rc-empty">Aucune opération pour l'instant : choisissez-les dans « À pointer ».</p>
</section>
{% endverbatim %}{% endset %}
{{ sg.ex('rc-panel, block-head, rc-progress, rc-selsum', code, 'Le JS du relevé (<code>releve.js</code>) remplit les compteurs et affiche/masque ces blocs (attribut <code>hidden</code>).') }}

<p class="sg-sub">Lignes du relevé en cours de composition</p>
{% set code %}{% verbatim %}
<ol class="rc-list is-selected">
    <li class="rc-line is-done" data-parts="1" draggable="true">
        <div class="rc-line-head">
            <label class="rc-pick"><input type="checkbox"></label>
            <span class="rc-grip" aria-hidden="true">⋮⋮</span>
            <span class="rc-rank">1</span>
            <button type="button" class="rc-done is-on" aria-pressed="true" title="Pointée : cliquer pour dépointer">✓</button>
            <span class="rc-date">02/09/2026</span>
            <span class="rc-main"><strong>Leclerc</strong><small>Courses</small></span>
            <span></span>
            <span class="rc-amount amount-expense">− 42,10 €</span>
            <span class="rc-balance">957,90 €</span>
            <span class="rc-tools">
                <button type="button" class="btn btn-icon" title="Placer après la dernière ligne pointée">⤒</button>
                <button type="button" class="btn btn-icon" title="Monter">▲</button>
                <button type="button" class="btn btn-icon" title="Descendre">▼</button>
                <button type="button" class="btn btn-icon" title="Retirer la ligne du relevé">✕</button>
            </span>
        </div>
    </li>
    <li class="rc-line" data-parts="2" draggable="true">
        <div class="rc-line-head">
            <label class="rc-pick"><input type="checkbox"></label>
            <span class="rc-grip" aria-hidden="true">⋮⋮</span>
            <span class="rc-rank">2</span>
            <button type="button" class="rc-done" aria-pressed="false" title="Cliquer pour pointer">✓</button>
            <span class="rc-date">03/09/2026</span>
            <span class="rc-main"><strong>Amazon</strong><small>Courses · Maison</small></span>
            <span class="pill pill-accent">Détail × 2</span>
            <span class="rc-amount amount-expense">− 42,50 €</span>
            <span class="rc-balance">915,40 €</span>
            <span class="rc-tools">
                <button type="button" class="btn btn-icon" title="Placer après la dernière ligne pointée">⤒</button>
                <button type="button" class="btn btn-icon" title="Monter">▲</button>
                <button type="button" class="btn btn-icon" title="Descendre">▼</button>
                <button type="button" class="btn btn-icon" title="Dégrouper : une ligne par opération">⧉</button>
                <button type="button" class="btn btn-icon" title="Retirer la ligne du relevé">✕</button>
            </span>
        </div>
        <ul class="rc-parts">
            <li class="rc-op"><span class="rc-main"><small>Courses</small></span><span class="rc-amount amount-expense">− 30,00 €</span><span class="rc-tools"><button type="button" class="btn btn-icon" title="Sortir du détail">✂</button><button type="button" class="btn btn-icon" title="Retirer du relevé">✕</button></span></li>
            <li class="rc-op"><span class="rc-main"><small>Maison</small></span><span class="rc-amount amount-expense">− 12,50 €</span><span class="rc-tools"><button type="button" class="btn btn-icon" title="Sortir du détail">✂</button><button type="button" class="btn btn-icon" title="Retirer du relevé">✕</button></span></li>
        </ul>
    </li>
</ol>
{% endverbatim %}{% endset %}
{{ sg.ex('rc-list is-selected / rc-line / rc-done / rc-parts', code, 'Lignes numérotées et glissables ; ✓ = pointée sur le relevé de compte (<code>is-done</code>, liseré vert) ; <code>data-parts</code> &gt; 1 = détail (liseré d\'accent). Le JS construit l\'en-tête ; ce markup est le rendu final.') }}

<p class="sg-sub">Opérations à pointer</p>
{% set code %}{% verbatim %}
<ul class="rc-list is-pool">
    <li class="rc-op" draggable="true">
        <label class="rc-pick rc-only-pool"><input type="checkbox"></label>
        <span class="rc-grip rc-only-pool" aria-hidden="true">⋮⋮</span>
        <span class="rc-date">06/09/2026</span>
        <span class="rc-main"><strong>Free</strong><small>Internet · n° 123</small></span>
        <button type="button" class="pill rc-only-pool">2 du même jour</button>
        <span class="rc-amount amount-expense">− 19,99 €</span>
        <span class="rc-tools"><button type="button" class="btn btn-icon btn-primary rc-add rc-only-pool" title="Ajouter au relevé">＋</button></span>
    </li>
    <li class="rc-op" draggable="true">
        <label class="rc-pick rc-only-pool"><input type="checkbox"></label>
        <span class="rc-grip rc-only-pool" aria-hidden="true">⋮⋮</span>
        <span class="rc-date">07/09/2026</span>
        <span class="rc-main"><strong>Employeur</strong><small>Salaire</small></span>
        <span></span>
        <span class="rc-amount amount-income">+ 1 800,00 €</span>
        <span class="rc-tools"><button type="button" class="btn btn-icon btn-primary rc-add rc-only-pool" title="Ajouter au relevé">＋</button></span>
    </li>
</ul>
<input type="search" class="modern-form-control rc-filter" placeholder="Filtrer (tiers, catégorie, montant, date…)" style="margin-top: 8px">
{% endverbatim %}{% endset %}
{{ sg.ex('rc-op dans rc-list is-pool', code, 'Colonne « À pointer » : case, poignée, date, libellé, puce, montant, bouton ＋. <code>rc-only-pool</code> / <code>rc-only-part</code> montrent un élément selon le conteneur.') }}

<p class="sg-sub">Mini-formulaire « Nouvelle opération »</p>
{% set code %}{% verbatim %}
<div class="rc-newop">
    <div class="rc-newop-grid">
        <label class="rc-field"><span class="modern-form-label">Date</span><input type="date" class="modern-form-control" value="2026-10-05"></label>
        <label class="rc-field"><span class="modern-form-label">Montant <small>(négatif = remboursement)</small></span><input class="modern-form-control" placeholder="0,00"></label>
        <label class="rc-field"><span class="modern-form-label">Catégorie</span><input class="modern-form-control"></label>
        <label class="rc-field"><span class="modern-form-label">Tiers</span><input class="modern-form-control"></label>
        <label class="rc-field rc-field-wide"><span class="modern-form-label">Adresse du tiers</span><select class="modern-form-control"><option>Choisir d'abord le tiers</option></select></label>
    </div>
    <details class="rc-more"><summary>Plus de champs <small>(projet, n° de commande, note)</small></summary></details>
    <div class="rc-newop-foot">
        <p class="rc-msg" hidden></p>
        <span class="rc-newop-actions">
            <button type="button" class="btn btn-neutral"><span>Annuler</span></button>
            <button type="button" class="btn btn-primary"><span>Créer et ajouter</span></button>
        </span>
    </div>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('rc-newop', code) }}

<p class="sg-sub">Barre d'actions du relevé</p>
{% set code %}{% verbatim %}
<div class="rc-actions" style="position: static">
    <div class="rc-sums">
        <span>Mouvement <strong>− 154,60 €</strong></span>
        <span>Solde cumulé <strong>1 095,40 €</strong></span>
    </div>
    <span class="rc-actions-buttons">
        <button type="button" class="btn btn-neutral"><twig:ux:icon name="lucide:save" /><span>Enregistrer</span></button>
        <button type="button" class="btn btn-primary"><twig:ux:icon name="lucide:lock" /><span>Finaliser</span></button>
    </span>
</div>
<footer class="rc-total rc-total-multi">
    <span>Solde du relevé <small>(mouvement)</small></span><strong class="amount-expense">−154,60 €</strong>
    <span>Solde cumulé</span><strong>1 095,40 €</strong>
</footer>
{% endverbatim %}{% endset %}
{{ sg.ex('rc-actions, rc-sums, rc-total', code, 'La barre est collée en bas de l\'écran (<code>position: sticky</code>) ; ici statique pour l\'exemple.') }}
