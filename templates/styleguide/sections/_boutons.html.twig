{% import 'styleguide/_ex.html.twig' as sg %}

<p class="sg-sub">Boutons d'action de page</p>
{% set code %}{% verbatim %}
{% include 'layout/modern/components/_btns.html.twig' with { btns: [
    { label: 'Primary', path: '#', icon: 'gridicons:add', color: 'primary' },
    { label: 'Neutral', path: '#', icon: 'lucide:pencil', color: 'neutral' },
    { label: 'Info', path: '#', icon: 'lucide:info', color: 'info' },
    { label: 'Danger', path: '#', icon: 'lucide:trash-2', color: 'danger' },
    { label: 'Success', path: '#', icon: 'lucide:check', color: 'success' },
    { label: 'Warning', path: '#', icon: 'lucide:triangle-alert', color: 'warning' }
] } %}
{% endverbatim %}{% endset %}
{{ sg.ex('btn — variantes de couleur', code, 'Passer par <code>_btns.html.twig</code> : un lien par défaut, <code>type: \'submit\'</code> pour un bouton de formulaire, <code>removeContainer: true</code> pour un bouton seul.') }}

{% set code %}{% verbatim %}
<div class="sg-row">
    <a href="#" class="btn btn-primary"><span>Sans icône</span></a>
    <button type="button" class="btn btn-primary" disabled><span>Désactivé</span></button>
    <button type="button" class="btn btn-neutral" disabled><span>Désactivé</span></button>
    <a href="#" class="btn"><span>Neutre (classe seule)</span></a>
    <a href="#" class="btn">.btn</a>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('btn — sans icône, désactivé, classe seule', code) }}

{% set code %}{% verbatim %}
<div class="sg-row">
    <button type="button" class="btn btn-primary">Normal · 38px</button>
    <button type="button" class="btn btn-primary btn-sm">Small · 32px</button>
    <button type="button" class="btn btn-primary btn-xs">XS · 24px</button>
    <button type="button" class="btn btn-soft btn-sm">Soft</button>
    <button type="button" class="btn btn-ghost btn-sm">Ghost</button>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('btn-sm, btn-xs, btn-soft, btn-ghost', code, 'Tailles et teintes complémentaires du kit (<code>public/css/ui-kit.css</code>). Rayon unique 8px (6px pour xs et icônes).') }}

<p class="sg-sub">Boutons de carte</p>
{% set code %}{% verbatim %}
<div class="sg-row">
    <a href="#" class="btn btn-soft btn-sm"><twig:ux:icon name="lucide:star-off" /> Défaut</a>
    <a href="#" class="btn btn-soft btn-sm is-active"><twig:ux:icon name="material-symbols:star-rounded" /> Actif</a>
    <a href="#" class="btn btn-soft btn-sm is-danger"><twig:ux:icon name="lucide:unlink" /> Danger</a>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('btn btn-soft btn-sm', code, 'Petits boutons en bas d\'une carte d\'entité. <code>is-active</code> = état courant ; <code>is-danger</code> = rouge au survol.') }}

<p class="sg-sub">Choix exclusif</p>
{% set code %}{% verbatim %}
<div class="segmented" role="group" aria-label="Période">
    <a href="#" class="segmented-item is-active" aria-current="true">Mois</a>
    <a href="#" class="segmented-item">Trimestre</a>
    <a href="#" class="segmented-item">Année</a>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('segmented', code, 'Utilisé pour la barre de regroupement (Date / Élément / Tri).') }}

<p class="sg-sub">Boutons de l'écran de relevé et des prévisions</p>
{% set code %}{% verbatim %}
<div class="sg-row">
    <button type="button" class="btn btn-icon" title="Trier">↑</button>
    <button type="button" class="btn btn-icon is-on" title="Actif">↓</button>
    <button type="button" class="btn btn-icon btn-primary rc-add" title="Ajouter">＋</button>
    <button type="button" class="btn-link">Désélectionner</button>
    <button type="button" class="pill">Puce cliquable</button>
    <button type="button" class="btn-link is-muted">Ajuster</button>
    <button type="button" class="btn btn-icon btn-ghost is-danger" title="Replier">✕</button>
</div>
{% endverbatim %}{% endset %}
{{ sg.ex('btn-icon, btn-link, pill (bouton)', code, 'Boutons compacts : outils de ligne (<code>btn btn-icon</code>), liens-boutons (<code>btn-link</code>, <code>is-muted</code> pour la version grise soulignée), puces cliquables (<code>button.pill</code>).') }}

<p class="sg-sub">Bouton « Appliquer » de la barre en masse</p>
{% set code %}{% verbatim %}
{% include 'layout/modern/components/_btns.html.twig' with {
    removeContainer: true,
    btns: [{ type: 'submit', label: 'Appliquer', icon: 'lucide:check', color: 'primary', class: 'bulk-submit' }]
} %}
{% endverbatim %}{% endset %}
{{ sg.ex('bulk-submit', code) }}
