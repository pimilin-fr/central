{% extends 'modern.html.twig' %}

{% block title %}Styleguide{% endblock %}

{#
    STYLEGUIDE — catalogue vivant du design system.
      - Une thématique à la fois (accordéon) ; la dernière ouverte est mémorisée, l'ancre #id l'ouvre.
      - Chaque exemple est rendu avec les classes réelles et les variables du thème courant : changez de thème (barre du haut) pour comparer.
      - Chaque exemple a son code (« Voir le code », bouton « Copier ») : c'est le texte exact qui produit l'aperçu.
    Ajouter un exemple : sections/_<thématique>.html.twig → {% set code %}{% verbatim %}…{% endverbatim %}{% endset %}{{ sg.ex('Titre', code, 'Note') }}
    Ajouter une thématique : l'ajouter à la liste ci-dessous et créer sections/_<id>.html.twig.
#}
{% set breadcrumb_current = 'Styleguide' %}

{% set tokenGroups = {
    'Fond & surfaces': ['--bg', '--surface', '--surface-soft', '--surface-hover'],
    'Texte': ['--text', '--text-soft', '--text-muted'],
    'Bordures': ['--border', '--border-strong'],
    'Accent': ['--accent', '--accent-soft', '--accent-strong', '--accent-contrast'],
    'Information': ['--info', '--info-strong', '--info-soft'],
    'Succès': ['--success', '--success-strong', '--success-soft'],
    'Alerte': ['--warning', '--warning-strong','--warning-soft'],
    'Danger': ['--danger', '--danger-strong', '--danger-soft'],
    'Montants': ['--amount-income', '--amount-expense', '--amount-refund'],
    'Texte sur couleur pleine': ['--on-entity', '--on-info', '--on-success', '--on-warning', '--on-danger'],
    'Divers': ['--page-glow', '--overlay', '--shine', '--preview-border', '--on-entity-shadow', '--shadow-lg', '--shadow-hover']
} %}

{% set themes_list = [
    { id: 'fondations', icon: 'lucide:palette', title: 'Fondations', lead: 'Variables du thème, ombres, familles de couleurs, typographie, icônes, utilitaires.' },
    { id: 'structure', icon: 'lucide:layout-panel-top', title: 'Structure de page', lead: 'En-tête de page, fil d\'Ariane, barre d\'outils, barre latérale, barre du haut, menus de thème et d\'environnement.' },
    { id: 'boutons', icon: 'lucide:mouse-pointer-click', title: 'Boutons & actions', lead: 'Boutons de page, de carte, choix exclusif, boutons compacts du relevé et des prévisions.' },
    { id: 'pastilles', icon: 'lucide:tag', title: 'Pastilles, badges, indicateurs', lead: 'Pastilles d\'entité, modes démo, états de relevé, certitude, montants, puces.' },
    { id: 'separateurs', icon: 'lucide:minus', title: 'Séparateurs', lead: 'Point + trait dégradé et traits simples.' },
    { id: 'cartes', icon: 'lucide:layout-grid', title: 'Cartes', lead: 'Cartes d\'entité, de tiers, chiffres clés, résumé de fiche, localisation, branches d\'arbre.' },
    { id: 'formulaires', icon: 'lucide:text-cursor-input', title: 'Formulaires', lead: 'Champs et états, choix, autocomplétion, mise en page, modification en masse, champs du relevé.' },
    { id: 'onglets', icon: 'lucide:panel-top', title: 'Onglets', lead: 'Barre d\'onglets avec icône et badge.' },
    { id: 'messages', icon: 'lucide:message-square', title: 'Messages & états vides', lead: 'Toasts, messages en ligne, états vides.' },
    { id: 'listes', icon: 'lucide:list', title: 'Listes d\'opérations', lead: 'Barre de regroupement, groupes, tableaux, groupes de relevé, lignes numérotées, sous-groupes.' },
    { id: 'releve', icon: 'lucide:receipt', title: 'Écran du relevé', lead: 'Repères, panneaux, lignes et détails, opérations à pointer, nouvelle opération, barre d\'actions.' },
    { id: 'previsions', icon: 'lucide:calendar-clock', title: 'Prévisions', lead: 'Périodes, concrétisation, règles, cartes d\'échéance, panneau latéral, tranches.' }
] %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('css/styleguide.css') }}?v=2">

    <div class="page-container sg-page" data-sg-root>

        <div class="page-heading">
            <div class="page-heading-copy">
                <p class="page-eyebrow">Design system</p>
                <h1 class="page-title">Styleguide</h1>
                <p class="page-subline">Thème courant : <strong data-sg-theme>—</strong> — changez de thème (barre du haut) pour comparer. Une thématique à la fois ; « Voir le code » sous chaque exemple.</p>
            </div>
        </div>

        <div class="sg-accordion" data-sg-accordion>
            {% for t in themes_list %}
                <section class="sg-acc" id="{{ t.id }}" data-sg-section>
                    <h2 class="sg-acc-title">
                        <button type="button" class="sg-acc-head" aria-expanded="false" aria-controls="sg-panel-{{ t.id }}" data-sg-toggle>
                            <span class="sg-acc-icon"><twig:ux:icon name="{{ t.icon }}" /></span>
                            <span class="sg-acc-copy">
                                <span class="sg-acc-name">{{ t.title }}</span>
                                <span class="sg-acc-lead">{{ t.lead }}</span>
                            </span>
                            <span class="sg-acc-count" data-sg-count></span>
                            <span class="sg-acc-chevron" aria-hidden="true"><twig:ux:icon name="lucide:chevron-down" /></span>
                        </button>
                    </h2>
                    <div class="sg-acc-panel" id="sg-panel-{{ t.id }}" role="region" hidden>
                        {% include 'styleguide/sections/_' ~ t.id ~ '.html.twig' %}
                    </div>
                </section>
            {% endfor %}
        </div>
    </div>

    <script src="{{ asset('js/styleguide.js') }}?v=1" defer></script>
{% endblock %}
